<Application
    x:Class="AXamlIDE.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  The theme variant is set from Settings at startup (Views/ThemeSwitcher, Styles/ThemeResources.axaml).  -->

    <Application.Styles>
        <FluentTheme />
        <DockFluentTheme DensityStyle="Compact" />
        <Style Selector="Window">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!--  App-wide looks, one file per kind of control; views pick them with Classes (Styles/*.axaml).  -->
        <StyleInclude Source="/Styles/ButtonStyles.axaml" />
        <StyleInclude Source="/Styles/TextBoxStyles.axaml" />
        <StyleInclude Source="/Styles/ListStyles.axaml" />
        <StyleInclude Source="/Styles/MenuStyles.axaml" />
        <StyleInclude Source="/Styles/EditorStyles.axaml" />
        <StyleInclude Source="/Styles/BorderStyles.axaml" />
        <StyleInclude Source="/Styles/TextBlockStyles.axaml" />
        <StyleInclude Source="/Styles/TreeViewStyles.axaml" />
        <StyleInclude Source="/Styles/PaneStyles.axaml" />
        <StyleInclude Source="/Styles/DockStyles.axaml" />
        <StyleInclude Source="/Styles/MarkdownStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/ThemeResources.axaml" />
                <ResourceInclude Source="/Styles/IconResources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Dock tab sizing: a little roomier than Dock's compact density.  -->
            <Thickness x:Key="DockDocumentTabItemPadding">10,3,6,3</Thickness>
            <Thickness x:Key="DockToolTabItemPadding">10,3,10,3</Thickness>
            <Thickness x:Key="DockToolTabItemSelectedPadding">10,3,10,3</Thickness>
            <x:Double x:Key="TreeViewItemIndent">4</x:Double>
            <Thickness x:Key="TreeViewItemExpandCollapseChevronMargin">4,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>