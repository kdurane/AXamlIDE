<!--
    HighContrastDark: the UI colours for this theme, from TextMate's built-in HighContrastDark theme (its "colors" section).
    Base variant: Dark (Fluent and Dock use their dark look for anything not set here).
    Keys are VS Code's theme colour names; Styles/ThemeResources.axaml turns them into brushes.
    "default" marks a key the theme doesn't set (VS Code's default for a dark theme is used).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="editor.background">#000000</Color>
    <Color x:Key="editor.foreground">#FFFFFF</Color>
    <Color x:Key="sideBar.background">#252526</Color>   <!-- default -->
    <Color x:Key="sideBar.foreground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="sideBarSectionHeader.background">#333333</Color>   <!-- default -->
    <Color x:Key="sideBarSectionHeader.foreground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="tab.activeBackground">#000000</Color>   <!-- default -->
    <Color x:Key="tab.activeForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="tab.inactiveBackground">#2D2D2D</Color>   <!-- default -->
    <Color x:Key="tab.inactiveForeground">#969696</Color>   <!-- default -->
    <Color x:Key="tab.border">#252526</Color>   <!-- default -->
    <Color x:Key="list.hoverBackground">#2A2D2E</Color>   <!-- default -->
    <Color x:Key="list.inactiveSelectionBackground">#37373D</Color>   <!-- default -->
    <Color x:Key="list.activeSelectionBackground">#04395E</Color>   <!-- default -->
    <Color x:Key="list.activeSelectionForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="titleBar.activeBackground">#262626</Color>   <!-- default -->
    <Color x:Key="titleBar.activeForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="activityBar.background">#202020</Color>   <!-- default -->
    <Color x:Key="activityBar.foreground">#D4D4D4</Color>   <!-- default -->
    <Color x:Key="statusBar.background">#007ACC</Color>   <!-- default -->
    <Color x:Key="statusBar.foreground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="dropdown.background">#3C3C3C</Color>   <!-- default -->
    <Color x:Key="dropdown.foreground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="dropdown.border">#3C3C3C</Color>   <!-- default -->

    <!--  Git: file name colours in the explorer and the Git tab.  -->
    <Color x:Key="gitDecoration.modifiedResourceForeground">#E2C08D</Color>   <!-- default -->
    <Color x:Key="gitDecoration.addedResourceForeground">#81B88B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.untrackedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.deletedResourceForeground">#C74E39</Color>   <!-- default -->
    <Color x:Key="gitDecoration.renamedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.conflictingResourceForeground">#E4676B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.ignoredResourceForeground">#CD5C5C</Color>   <!-- ours: IndianRed, as elsewhere in the app -->

    <!--  Diff view: line backgrounds (alpha flattened onto editor.background).  -->
    <Color x:Key="diffEditor.insertedLineBackground">#1F2511</Color>   <!-- default -->
    <Color x:Key="diffEditor.removedLineBackground">#330000</Color>   <!-- default -->
    <Color x:Key="diffEditor.diagonalFill">#151515</Color>   <!-- default -->

    <!--  Hover card and diagnostics (Editor/Hover).  -->
    <Color x:Key="editorHoverWidget.background">#252526</Color>   <!-- default -->
    <Color x:Key="editorHoverWidget.foreground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="editorHoverWidget.border">#454545</Color>   <!-- default -->
    <Color x:Key="editorError.foreground">#F14C4C</Color>   <!-- default -->
    <Color x:Key="editorWarning.foreground">#CCA700</Color>   <!-- default -->
    <Color x:Key="editorInfo.foreground">#3794FF</Color>   <!-- default -->
    <Color x:Key="textLink.foreground">#3794FF</Color>   <!-- default -->

    <!--  Editor margins, highlights and pop-ups (completion, find, quick fixes).  -->
    <Color x:Key="editorLineNumber.foreground">#858585</Color>   <!-- default -->
    <Color x:Key="editorGutter.foldingControlForeground">#C5C5C5</Color>   <!-- default -->
    <Color x:Key="editorLightBulb.foreground">#FFCC00</Color>   <!-- default -->
    <Color x:Key="editor.inlineValuesForeground">#808080</Color>   <!-- default -->
    <Color x:Key="editor.wordHighlightBackground">#B8575757</Color>   <!-- default -->
    <Color x:Key="editorGroup.border">#444444</Color>   <!-- default -->
    <Color x:Key="editorWidget.background">#252526</Color>   <!-- default -->
    <Color x:Key="editorWidget.foreground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="editorWidget.border">#454545</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.background">#252526</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.foreground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.border">#454545</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.selectedBackground">#04395E</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.selectedForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="widget.shadow">#5C000000</Color>   <!-- default -->

    <!--  Run and debug buttons (toolbar, debug toolbar).  -->
    <Color x:Key="debugIcon.startForeground">#89D185</Color>   <!-- default -->
    <Color x:Key="debugIcon.stopForeground">#F48771</Color>   <!-- default -->
    <Color x:Key="debugIcon.restartForeground">#89D185</Color>   <!-- default -->
    <Color x:Key="debugIcon.continueForeground">#75BEFF</Color>   <!-- default -->

    <!--  Overview ruler beside the editor's scrollbar (Editor/Highlighting/OverviewRuler).  -->
    <Color x:Key="editorOverviewRuler.errorForeground">#B3FF1212</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.warningForeground">#CCA700</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.infoForeground">#3794FF</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.selectionHighlightForeground">#CCA0A0A0</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.border">#4D7F7F7F</Color>   <!-- default -->
    <Color x:Key="editorCursor.foreground">#AEAFAD</Color>   <!-- default -->
    <Color x:Key="scrollbarSlider.background">#66797979</Color>   <!-- default -->
    <Color x:Key="scrollbarSlider.hoverBackground">#B3646464</Color>   <!-- default -->
    <Color x:Key="scrollbarSlider.activeBackground">#66BFBFBF</Color>   <!-- default -->

    <!--  Links in the editor text (URLs). Default: a soft blue on dark themes, so it isn't too saturated.  -->
    <Color x:Key="editorLink.activeForeground">#8AB4F8</Color>   <!-- default -->
    <Color x:Key="editorCodeLens.foreground">#999999</Color>   <!-- default: the "3 references" lines -->

    <!--  Ours (not VS Code keys): tab.activeBackground mixed a little towards tab.activeForeground.  -->
    <Color x:Key="app.tab.selectedBackground">#1E1E1E</Color>
    <Color x:Key="app.panelHeader.activeBackground">#141414</Color>

    <!--  Ours: the preview's design grid, a blue that shows on light and dark previews.  -->
    <Color x:Key="app.preview.gridLine">#190E5EFD</Color>
    <Color x:Key="app.preview.gridLineMajor">#4D0E5EFD</Color>

    <!--  Debugger: value views, the current statement.  -->
    <Color x:Key="debugTokenExpression.name">#C586C0</Color>   <!-- default: debugger views: names, values by kind -->
    <Color x:Key="debugTokenExpression.value">#CCCCCC</Color>   <!-- default -->
    <Color x:Key="debugTokenExpression.string">#CE9178</Color>   <!-- default -->
    <Color x:Key="debugTokenExpression.boolean">#4E94CE</Color>   <!-- default -->
    <Color x:Key="debugTokenExpression.number">#B5CEA8</Color>   <!-- default -->
    <Color x:Key="debugTokenExpression.error">#F48771</Color>   <!-- default -->
    <Color x:Key="editor.stackFrameHighlightBackground">#33FFFF00</Color>   <!-- default: the current statement while paused (alpha kept) -->
    <Color x:Key="editor.focusedStackFrameHighlightBackground">#4D7ABD7A</Color>   <!-- default: another frame picked in the Call Stack (alpha kept) -->
    <Color x:Key="debugIcon.breakpointCurrentStackframeForeground">#FFCC00</Color>   <!-- default: the current-statement arrow -->
    <Color x:Key="debugIcon.breakpointStackframeForeground">#89D185</Color>   <!-- default -->
    <Color x:Key="app.debug.changedValueForeground">#F48771</Color>   <!-- default: ours: a value changed since the last step (VS shows it red) -->
</ResourceDictionary>
