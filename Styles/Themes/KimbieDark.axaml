<!--
    KimbieDark: the UI colours for this theme, from TextMate's built-in KimbieDark theme (its "colors" section).
    Base variant: Dark (Fluent and Dock use their dark look for anything not set here).
    Keys are VS Code's theme colour names; Styles/ThemeResources.axaml turns them into brushes.
    "default" marks a key the theme doesn't set (VS Code's default for a dark theme is used).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="editor.background">#221A0F</Color>
    <Color x:Key="editor.foreground">#D3AF86</Color>
    <Color x:Key="sideBar.background">#362712</Color>
    <Color x:Key="sideBar.foreground">#D3AF86</Color>   <!-- default -->
    <Color x:Key="sideBarSectionHeader.background">#333333</Color>   <!-- default -->
    <Color x:Key="sideBarSectionHeader.foreground">#D3AF86</Color>   <!-- default -->
    <Color x:Key="tab.activeBackground">#221A0F</Color>   <!-- default -->
    <Color x:Key="tab.activeForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="tab.inactiveBackground">#131510</Color>
    <Color x:Key="tab.inactiveForeground">#969696</Color>   <!-- default -->
    <Color x:Key="tab.border">#252526</Color>   <!-- default -->
    <Color x:Key="list.hoverBackground">#463016</Color>
    <Color x:Key="list.inactiveSelectionBackground">#645342</Color>
    <Color x:Key="list.activeSelectionBackground">#7C5021</Color>
    <Color x:Key="list.activeSelectionForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="titleBar.activeBackground">#423523</Color>
    <Color x:Key="titleBar.activeForeground">#D3AF86</Color>   <!-- default -->
    <Color x:Key="activityBar.background">#221A0F</Color>
    <Color x:Key="activityBar.foreground">#D3AF86</Color>
    <Color x:Key="statusBar.background">#423523</Color>
    <Color x:Key="statusBar.foreground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="dropdown.background">#51412C</Color>
    <Color x:Key="dropdown.foreground">#D3AF86</Color>   <!-- default -->
    <Color x:Key="dropdown.border">#51412C</Color>   <!-- default -->

    <!--  Git: file name colours in the explorer and the Git tab.  -->
    <Color x:Key="gitDecoration.modifiedResourceForeground">#E2C08D</Color>   <!-- default -->
    <Color x:Key="gitDecoration.addedResourceForeground">#81B88B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.untrackedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.deletedResourceForeground">#C74E39</Color>   <!-- default -->
    <Color x:Key="gitDecoration.renamedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.conflictingResourceForeground">#E4676B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.ignoredResourceForeground">#CD5C5C</Color>   <!-- ours: IndianRed, as elsewhere in the app -->

    <!--  Diff view: line backgrounds (alpha flattened onto editor.background).  -->
    <Color x:Key="diffEditor.insertedLineBackground">#3A3A1D</Color>   <!-- default -->
    <Color x:Key="diffEditor.removedLineBackground">#4E150C</Color>   <!-- default -->
    <Color x:Key="diffEditor.diagonalFill">#332C22</Color>   <!-- default -->

    <!--  Hover card and diagnostics (Editor/Hover).  -->
    <Color x:Key="editorHoverWidget.background">#221A14</Color>
    <Color x:Key="editorHoverWidget.foreground">#D3AF86</Color>   <!-- default -->
    <Color x:Key="editorHoverWidget.border">#454545</Color>   <!-- default -->
    <Color x:Key="editorError.foreground">#F14C4C</Color>   <!-- default -->
    <Color x:Key="editorWarning.foreground">#CCA700</Color>   <!-- default -->
    <Color x:Key="editorInfo.foreground">#3794FF</Color>   <!-- default -->
    <Color x:Key="textLink.foreground">#3794FF</Color>   <!-- default -->

    <!--  Ours (not VS Code keys): tab.activeBackground mixed a little towards tab.activeForeground.  -->
    <Color x:Key="app.tab.selectedBackground">#3C352B</Color>
    <Color x:Key="app.panelHeader.activeBackground">#332C22</Color>
</ResourceDictionary>
