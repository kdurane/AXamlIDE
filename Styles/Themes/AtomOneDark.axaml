<!--
    AtomOneDark: the UI colours for this theme, from TextMate's built-in AtomOneDark theme (its "colors" section).
    Base variant: Dark (Fluent and Dock use their dark look for anything not set here).
    Keys are VS Code's theme colour names; Styles/ThemeResources.axaml turns them into brushes.
    "default" marks a key the theme doesn't set (VS Code's default for a dark theme is used).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="editor.background">#282C34</Color>
    <Color x:Key="editor.foreground">#ABB2BF</Color>
    <Color x:Key="sideBar.background">#21252B</Color>
    <Color x:Key="sideBar.foreground">#9DA5B4</Color>
    <Color x:Key="sideBarSectionHeader.background">#282C34</Color>
    <Color x:Key="sideBarSectionHeader.foreground">#ABB2BF</Color>
    <Color x:Key="tab.activeBackground">#282C34</Color>
    <Color x:Key="tab.activeForeground">#ABB2BF</Color>
    <Color x:Key="tab.inactiveBackground">#21252B</Color>
    <Color x:Key="tab.inactiveForeground">#5C6370</Color>
    <Color x:Key="tab.border">#21252B</Color>
    <Color x:Key="list.hoverBackground">#2C313A</Color>
    <Color x:Key="list.inactiveSelectionBackground">#3E4451</Color>
    <Color x:Key="list.activeSelectionBackground">#3E4451</Color>
    <Color x:Key="list.activeSelectionForeground">#D7DAE0</Color>
    <Color x:Key="titleBar.activeBackground">#21252B</Color>
    <Color x:Key="titleBar.activeForeground">#ABB2BF</Color>
    <Color x:Key="activityBar.background">#21252B</Color>
    <Color x:Key="activityBar.foreground">#ABB2BF</Color>
    <Color x:Key="statusBar.background">#21252B</Color>
    <Color x:Key="statusBar.foreground">#ABB2BF</Color>
    <Color x:Key="dropdown.background">#3B4048</Color>
    <Color x:Key="dropdown.foreground">#ABB2BF</Color>
    <Color x:Key="dropdown.border">#3B4048</Color>

    <!--  Git: file name colours in the explorer and the Git tab.  -->
    <Color x:Key="gitDecoration.modifiedResourceForeground">#E2C08D</Color>   <!-- default -->
    <Color x:Key="gitDecoration.addedResourceForeground">#81B88B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.untrackedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.deletedResourceForeground">#C74E39</Color>   <!-- default -->
    <Color x:Key="gitDecoration.renamedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.conflictingResourceForeground">#E4676B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.ignoredResourceForeground">#CD5C5C</Color>   <!-- ours: IndianRed, as elsewhere in the app -->

    <!--  Diff view: line backgrounds (alpha flattened onto editor.background).  -->
    <Color x:Key="diffEditor.insertedLineBackground">#3F483B</Color>   <!-- default -->
    <Color x:Key="diffEditor.removedLineBackground">#53232A</Color>   <!-- default -->
    <Color x:Key="diffEditor.diagonalFill">#393C43</Color>   <!-- default -->

    <!--  Hover card and diagnostics (Editor/Hover).  -->
    <Color x:Key="editorHoverWidget.background">#21252B</Color>   <!-- default -->
    <Color x:Key="editorHoverWidget.foreground">#ABB2BF</Color>   <!-- default -->
    <Color x:Key="editorHoverWidget.border">#454545</Color>   <!-- default -->
    <Color x:Key="editorError.foreground">#F14C4C</Color>   <!-- default -->
    <Color x:Key="editorWarning.foreground">#CCA700</Color>   <!-- default -->
    <Color x:Key="editorInfo.foreground">#3794FF</Color>   <!-- default -->
    <Color x:Key="textLink.foreground">#3794FF</Color>   <!-- default -->

    <!--  Editor margins, highlights and pop-ups (completion, find, quick fixes).  -->
    <Color x:Key="editorLineNumber.foreground">#858585</Color>   <!-- default -->
    <Color x:Key="editorGutter.foldingControlForeground">#C5C5C5</Color>   <!-- default -->
    <Color x:Key="editorLightBulb.foreground">#FFCC00</Color>   <!-- default -->
    <Color x:Key="editor.inlineValuesForeground">#94969A</Color>   <!-- default -->
    <Color x:Key="editor.wordHighlightBackground">#3A3F4B</Color>
    <Color x:Key="editorGroup.border">#444444</Color>   <!-- default -->
    <Color x:Key="editorWidget.background">#252526</Color>   <!-- default -->
    <Color x:Key="editorWidget.foreground">#ABB2BF</Color>   <!-- default -->
    <Color x:Key="editorWidget.border">#454545</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.background">#252526</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.foreground">#ABB2BF</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.border">#454545</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.selectedBackground">#3E4451</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.selectedForeground">#D7DAE0</Color>   <!-- default -->
    <Color x:Key="widget.shadow">#5C000000</Color>   <!-- default -->

    <!--  Run and debug buttons (toolbar, debug toolbar).  -->
    <Color x:Key="debugIcon.startForeground">#89D185</Color>   <!-- default -->
    <Color x:Key="debugIcon.stopForeground">#F48771</Color>   <!-- default -->
    <Color x:Key="debugIcon.restartForeground">#89D185</Color>   <!-- default -->
    <Color x:Key="debugIcon.continueForeground">#75BEFF</Color>   <!-- default -->

    <!--  Overview ruler beside the editor's scrollbar (Editor/Highlighting/OverviewRuler).  -->
    <Color x:Key="editorOverviewRuler.errorForeground">#B3FF1212</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.warningForeground">#CCA700</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.infoForeground">#3794FF</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.selectionHighlightForeground">#CCA0A0A0</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.border">#4D7F7F7F</Color>   <!-- default -->
    <Color x:Key="editorCursor.foreground">#528BFF</Color>
    <Color x:Key="scrollbarSlider.background">#66797979</Color>   <!-- default -->
    <Color x:Key="scrollbarSlider.hoverBackground">#B3646464</Color>   <!-- default -->
    <Color x:Key="scrollbarSlider.activeBackground">#66BFBFBF</Color>   <!-- default -->

    <!--  Links in the editor text (URLs). Default: a soft blue on dark themes, so it isn't too saturated.  -->
    <Color x:Key="editorLink.activeForeground">#8AB4F8</Color>   <!-- default -->
    <Color x:Key="editorCodeLens.foreground">#999999</Color>   <!-- default: the "3 references" lines -->

    <!--  Ours (not VS Code keys): tab.activeBackground mixed a little towards tab.activeForeground.  -->
    <Color x:Key="app.tab.selectedBackground">#373C44</Color>
    <Color x:Key="app.panelHeader.activeBackground">#32363F</Color>

    <!--  Ours: the preview's design grid, a blue that shows on light and dark previews.  -->
    <Color x:Key="app.preview.gridLine">#190E5EFD</Color>
    <Color x:Key="app.preview.gridLineMajor">#4D0E5EFD</Color>
</ResourceDictionary>
