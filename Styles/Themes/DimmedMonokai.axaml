<!--
    DimmedMonokai: the UI colours for this theme, from TextMate's built-in DimmedMonokai theme (its "colors" section).
    Base variant: Dark (Fluent and Dock use their dark look for anything not set here).
    Keys are VS Code's theme colour names; Styles/ThemeResources.axaml turns them into brushes.
    "default" marks a key the theme doesn't set (VS Code's default for a dark theme is used).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="editor.background">#1E1E1E</Color>
    <Color x:Key="editor.foreground">#C5C8C6</Color>
    <Color x:Key="sideBar.background">#272727</Color>
    <Color x:Key="sideBar.foreground">#C5C8C6</Color>   <!-- default -->
    <Color x:Key="sideBarSectionHeader.background">#505050</Color>
    <Color x:Key="sideBarSectionHeader.foreground">#C5C8C6</Color>   <!-- default -->
    <Color x:Key="tab.activeBackground">#1E1E1E</Color>   <!-- default -->
    <Color x:Key="tab.activeForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="tab.inactiveBackground">#404040</Color>
    <Color x:Key="tab.inactiveForeground">#D8D8D8</Color>
    <Color x:Key="tab.border">#303030</Color>
    <Color x:Key="list.hoverBackground">#444444</Color>
    <Color x:Key="list.inactiveSelectionBackground">#4E4E4E</Color>
    <Color x:Key="list.activeSelectionBackground">#707070</Color>
    <Color x:Key="list.activeSelectionForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="titleBar.activeBackground">#505050</Color>
    <Color x:Key="titleBar.activeForeground">#C5C8C6</Color>   <!-- default -->
    <Color x:Key="activityBar.background">#353535</Color>
    <Color x:Key="activityBar.foreground">#FFFFFF</Color>
    <Color x:Key="statusBar.background">#505050</Color>
    <Color x:Key="statusBar.foreground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="dropdown.background">#525252</Color>
    <Color x:Key="dropdown.foreground">#C5C8C6</Color>   <!-- default -->
    <Color x:Key="dropdown.border">#525252</Color>   <!-- default -->

    <!--  Git: file name colours in the explorer and the Git tab.  -->
    <Color x:Key="gitDecoration.modifiedResourceForeground">#E2C08D</Color>   <!-- default -->
    <Color x:Key="gitDecoration.addedResourceForeground">#81B88B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.untrackedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.deletedResourceForeground">#C74E39</Color>   <!-- default -->
    <Color x:Key="gitDecoration.renamedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.conflictingResourceForeground">#E4676B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.ignoredResourceForeground">#CD5C5C</Color>   <!-- ours: IndianRed, as elsewhere in the app -->

    <!--  Diff view: line backgrounds (alpha flattened onto editor.background).  -->
    <Color x:Key="diffEditor.insertedLineBackground">#373D29</Color>   <!-- default -->
    <Color x:Key="diffEditor.removedLineBackground">#4B1818</Color>   <!-- default -->
    <Color x:Key="diffEditor.diagonalFill">#303030</Color>   <!-- default -->

    <!--  Ours (not VS Code keys): tab.activeBackground mixed a little towards tab.activeForeground.  -->
    <Color x:Key="app.tab.selectedBackground">#393939</Color>
    <Color x:Key="app.panelHeader.activeBackground">#303030</Color>
</ResourceDictionary>
