<!--
    Monokai: the UI colours for this theme, from TextMate's built-in Monokai theme (its "colors" section).
    Base variant: Dark (Fluent and Dock use their dark look for anything not set here).
    Keys are VS Code's theme colour names; Styles/ThemeResources.axaml turns them into brushes.
    "default" marks a key the theme doesn't set (VS Code's default for a dark theme is used).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="editor.background">#272822</Color>
    <Color x:Key="editor.foreground">#F8F8F2</Color>
    <Color x:Key="sideBar.background">#1E1F1C</Color>
    <Color x:Key="sideBar.foreground">#F8F8F2</Color>   <!-- default -->
    <Color x:Key="sideBarSectionHeader.background">#272822</Color>
    <Color x:Key="sideBarSectionHeader.foreground">#F8F8F2</Color>   <!-- default -->
    <Color x:Key="tab.activeBackground">#272822</Color>   <!-- default -->
    <Color x:Key="tab.activeForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="tab.inactiveBackground">#34352F</Color>
    <Color x:Key="tab.inactiveForeground">#CCCCC7</Color>
    <Color x:Key="tab.border">#1E1F1C</Color>
    <Color x:Key="list.hoverBackground">#3E3D32</Color>
    <Color x:Key="list.inactiveSelectionBackground">#414339</Color>
    <Color x:Key="list.activeSelectionBackground">#75715E</Color>
    <Color x:Key="list.activeSelectionForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="titleBar.activeBackground">#1E1F1C</Color>
    <Color x:Key="titleBar.activeForeground">#F8F8F2</Color>   <!-- default -->
    <Color x:Key="activityBar.background">#272822</Color>
    <Color x:Key="activityBar.foreground">#F8F8F2</Color>
    <Color x:Key="statusBar.background">#414339</Color>
    <Color x:Key="statusBar.foreground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="dropdown.background">#414339</Color>
    <Color x:Key="dropdown.foreground">#F8F8F2</Color>   <!-- default -->
    <Color x:Key="dropdown.border">#414339</Color>   <!-- default -->

    <!--  Git: file name colours in the explorer and the Git tab.  -->
    <Color x:Key="gitDecoration.modifiedResourceForeground">#E2C08D</Color>   <!-- default -->
    <Color x:Key="gitDecoration.addedResourceForeground">#81B88B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.untrackedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.deletedResourceForeground">#C74E39</Color>   <!-- default -->
    <Color x:Key="gitDecoration.renamedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.conflictingResourceForeground">#E4676B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.ignoredResourceForeground">#CD5C5C</Color>   <!-- ours: IndianRed, as elsewhere in the app -->

    <!--  Diff view: line backgrounds (alpha flattened onto editor.background).  -->
    <Color x:Key="diffEditor.insertedLineBackground">#3E452C</Color>   <!-- default -->
    <Color x:Key="diffEditor.removedLineBackground">#52201B</Color>   <!-- default -->
    <Color x:Key="diffEditor.diagonalFill">#383933</Color>   <!-- default -->

    <!--  Ours (not VS Code keys): tab.activeBackground mixed a little towards tab.activeForeground.  -->
    <Color x:Key="app.tab.selectedBackground">#40413C</Color>
    <Color x:Key="app.panelHeader.activeBackground">#383933</Color>
</ResourceDictionary>
