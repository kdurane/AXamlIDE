<!--
    SolarizedDark: the UI colours for this theme, from TextMate's built-in SolarizedDark theme (its "colors" section).
    Base variant: Dark (Fluent and Dock use their dark look for anything not set here).
    Keys are VS Code's theme colour names; Styles/ThemeResources.axaml turns them into brushes.
    "default" marks a key the theme doesn't set (VS Code's default for a dark theme is used).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="editor.background">#002B36</Color>
    <Color x:Key="editor.foreground">#839496</Color>
    <Color x:Key="sideBar.background">#00212B</Color>
    <Color x:Key="sideBar.foreground">#839496</Color>   <!-- default -->
    <Color x:Key="sideBarSectionHeader.background">#333333</Color>   <!-- default -->
    <Color x:Key="sideBarSectionHeader.foreground">#839496</Color>   <!-- default -->
    <Color x:Key="tab.activeBackground">#002B37</Color>
    <Color x:Key="tab.activeForeground">#D6DBDB</Color>
    <Color x:Key="tab.inactiveBackground">#004052</Color>
    <Color x:Key="tab.inactiveForeground">#93A1A1</Color>
    <Color x:Key="tab.border">#003847</Color>
    <Color x:Key="list.hoverBackground">#003C4A</Color>
    <Color x:Key="list.inactiveSelectionBackground">#003846</Color>
    <Color x:Key="list.activeSelectionBackground">#005A6F</Color>
    <Color x:Key="list.activeSelectionForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="titleBar.activeBackground">#002C39</Color>
    <Color x:Key="titleBar.activeForeground">#839496</Color>   <!-- default -->
    <Color x:Key="activityBar.background">#003847</Color>
    <Color x:Key="activityBar.foreground">#D4D4D4</Color>   <!-- default -->
    <Color x:Key="statusBar.background">#00212B</Color>
    <Color x:Key="statusBar.foreground">#93A1A1</Color>
    <Color x:Key="dropdown.background">#00212B</Color>
    <Color x:Key="dropdown.foreground">#839496</Color>   <!-- default -->
    <Color x:Key="dropdown.border">#197271</Color>

    <!--  Git: file name colours in the explorer and the Git tab.  -->
    <Color x:Key="gitDecoration.modifiedResourceForeground">#E2C08D</Color>   <!-- default -->
    <Color x:Key="gitDecoration.addedResourceForeground">#81B88B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.untrackedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.deletedResourceForeground">#C74E39</Color>   <!-- default -->
    <Color x:Key="gitDecoration.renamedResourceForeground">#73C991</Color>   <!-- default -->
    <Color x:Key="gitDecoration.conflictingResourceForeground">#E4676B</Color>   <!-- default -->
    <Color x:Key="gitDecoration.ignoredResourceForeground">#CD5C5C</Color>   <!-- ours: IndianRed, as elsewhere in the app -->

    <!--  Diff view: line backgrounds (alpha flattened onto editor.background).  -->
    <Color x:Key="diffEditor.insertedLineBackground">#1F473C</Color>   <!-- default -->
    <Color x:Key="diffEditor.removedLineBackground">#33222B</Color>   <!-- default -->
    <Color x:Key="diffEditor.diagonalFill">#153B45</Color>   <!-- default -->

    <!--  Hover card and diagnostics (Editor/Hover).  -->
    <Color x:Key="editorHoverWidget.background">#004052</Color>
    <Color x:Key="editorHoverWidget.foreground">#839496</Color>   <!-- default -->
    <Color x:Key="editorHoverWidget.border">#454545</Color>   <!-- default -->
    <Color x:Key="editorError.foreground">#F14C4C</Color>   <!-- default -->
    <Color x:Key="editorWarning.foreground">#CCA700</Color>   <!-- default -->
    <Color x:Key="editorInfo.foreground">#3794FF</Color>   <!-- default -->
    <Color x:Key="textLink.foreground">#3794FF</Color>   <!-- default -->

    <!--  Editor margins, highlights and pop-ups (completion, find, quick fixes).  -->
    <Color x:Key="editorLineNumber.foreground">#858585</Color>   <!-- default -->
    <Color x:Key="editorGutter.foldingControlForeground">#C5C5C5</Color>   <!-- default -->
    <Color x:Key="editorLightBulb.foreground">#FFCC00</Color>   <!-- default -->
    <Color x:Key="editor.inlineValuesForeground">#80959B</Color>   <!-- default -->
    <Color x:Key="editor.wordHighlightBackground">#AA004454</Color>
    <Color x:Key="editorGroup.border">#00212B</Color>
    <Color x:Key="editorWidget.background">#00212B</Color>
    <Color x:Key="editorWidget.foreground">#839496</Color>   <!-- default -->
    <Color x:Key="editorWidget.border">#454545</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.background">#00212B</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.foreground">#839496</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.border">#454545</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.selectedBackground">#005A6F</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.selectedForeground">#FFFFFF</Color>   <!-- default -->
    <Color x:Key="widget.shadow">#5C000000</Color>   <!-- default -->

    <!--  Run and debug buttons (toolbar, debug toolbar).  -->
    <Color x:Key="debugIcon.startForeground">#89D185</Color>   <!-- default -->
    <Color x:Key="debugIcon.stopForeground">#F48771</Color>   <!-- default -->
    <Color x:Key="debugIcon.restartForeground">#89D185</Color>   <!-- default -->
    <Color x:Key="debugIcon.continueForeground">#75BEFF</Color>   <!-- default -->

    <!--  Ours (not VS Code keys): tab.activeBackground mixed a little towards tab.activeForeground.  -->
    <Color x:Key="app.tab.selectedBackground">#19404A</Color>
    <Color x:Key="app.panelHeader.activeBackground">#113944</Color>

    <!--  Ours: the preview's design grid, a blue that shows on light and dark previews.  -->
    <Color x:Key="app.preview.gridLine">#190E5EFD</Color>
    <Color x:Key="app.preview.gridLineMajor">#4D0E5EFD</Color>
</ResourceDictionary>
