<!--
    VisualStudioLight: the UI colours for this theme, from TextMate's built-in VisualStudioLight theme (its "colors" section).
    Base variant: Light (Fluent and Dock use their light look for anything not set here).
    Keys are VS Code's theme colour names; Styles/ThemeResources.axaml turns them into brushes.
    "default" marks a key the theme doesn't set (VS Code's default for a light theme is used).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="editor.background">#FFFFFF</Color>
    <Color x:Key="editor.foreground">#000000</Color>
    <Color x:Key="sideBar.background">#F5F5F5</Color>
    <Color x:Key="sideBar.foreground">#000000</Color>
    <Color x:Key="sideBarSectionHeader.background">#E5E5E5</Color>
    <Color x:Key="sideBarSectionHeader.foreground">#000000</Color>
    <Color x:Key="tab.activeBackground">#FFFFFF</Color>
    <Color x:Key="tab.activeForeground">#000000</Color>
    <Color x:Key="tab.inactiveBackground">#F5F5F5</Color>
    <Color x:Key="tab.inactiveForeground">#767676</Color>
    <Color x:Key="tab.border">#E5E5E5</Color>
    <Color x:Key="list.hoverBackground">#F0F0F0</Color>
    <Color x:Key="list.inactiveSelectionBackground">#E5E5E5</Color>
    <Color x:Key="list.activeSelectionBackground">#3399FF</Color>
    <Color x:Key="list.activeSelectionForeground">#FFFFFF</Color>
    <Color x:Key="titleBar.activeBackground">#F5F5F5</Color>
    <Color x:Key="titleBar.activeForeground">#000000</Color>
    <Color x:Key="activityBar.background">#F5F5F5</Color>
    <Color x:Key="activityBar.foreground">#000000</Color>
    <Color x:Key="statusBar.background">#007ACC</Color>
    <Color x:Key="statusBar.foreground">#FFFFFF</Color>
    <Color x:Key="dropdown.background">#FFFFFF</Color>
    <Color x:Key="dropdown.foreground">#000000</Color>
    <Color x:Key="dropdown.border">#E5E5E5</Color>

    <!--  Git: file name colours in the explorer and the Git tab.  -->
    <Color x:Key="gitDecoration.modifiedResourceForeground">#895503</Color>   <!-- default -->
    <Color x:Key="gitDecoration.addedResourceForeground">#587C0C</Color>   <!-- default -->
    <Color x:Key="gitDecoration.untrackedResourceForeground">#007100</Color>   <!-- default -->
    <Color x:Key="gitDecoration.deletedResourceForeground">#AD0707</Color>   <!-- default -->
    <Color x:Key="gitDecoration.renamedResourceForeground">#007100</Color>   <!-- default -->
    <Color x:Key="gitDecoration.conflictingResourceForeground">#AD0707</Color>   <!-- default -->
    <Color x:Key="gitDecoration.ignoredResourceForeground">#CD5C5C</Color>   <!-- ours: IndianRed, as elsewhere in the app -->

    <!--  Diff view: line backgrounds (alpha flattened onto editor.background).  -->
    <Color x:Key="diffEditor.insertedLineBackground">#EBF1DD</Color>   <!-- default -->
    <Color x:Key="diffEditor.removedLineBackground">#FFCCCC</Color>   <!-- default -->
    <Color x:Key="diffEditor.diagonalFill">#E8E8E8</Color>   <!-- default -->

    <!--  Ours (not VS Code keys): tab.activeBackground mixed a little towards tab.activeForeground.  -->
    <Color x:Key="app.tab.selectedBackground">#E0E0E0</Color>
    <Color x:Key="app.panelHeader.activeBackground">#EAEAEA</Color>
</ResourceDictionary>
