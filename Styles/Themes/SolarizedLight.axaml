<!--
    SolarizedLight: the UI colours for this theme, from TextMate's built-in SolarizedLight theme (its "colors" section).
    Base variant: Light (Fluent and Dock use their light look for anything not set here).
    Keys are VS Code's theme colour names; Styles/ThemeResources.axaml turns them into brushes.
    "default" marks a key the theme doesn't set (VS Code's default for a light theme is used).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="editor.background">#FDF6E3</Color>
    <Color x:Key="editor.foreground">#657B83</Color>
    <Color x:Key="sideBar.background">#EEE8D5</Color>
    <Color x:Key="sideBar.foreground">#657B83</Color>   <!-- default -->
    <Color x:Key="sideBarSectionHeader.background">#E7E7E7</Color>   <!-- default -->
    <Color x:Key="sideBarSectionHeader.foreground">#657B83</Color>   <!-- default -->
    <Color x:Key="tab.activeBackground">#FDF6E3</Color>
    <Color x:Key="tab.activeForeground">#333333</Color>   <!-- default -->
    <Color x:Key="tab.inactiveBackground">#D3CBB7</Color>
    <Color x:Key="tab.inactiveForeground">#586E75</Color>
    <Color x:Key="tab.border">#DDD6C1</Color>
    <Color x:Key="list.hoverBackground">#F5EACB</Color>
    <Color x:Key="list.inactiveSelectionBackground">#D1CBB8</Color>
    <Color x:Key="list.activeSelectionBackground">#DFCA88</Color>
    <Color x:Key="list.activeSelectionForeground">#6C6C6C</Color>
    <Color x:Key="titleBar.activeBackground">#EEE8D5</Color>
    <Color x:Key="titleBar.activeForeground">#657B83</Color>   <!-- default -->
    <Color x:Key="activityBar.background">#DDD6C1</Color>
    <Color x:Key="activityBar.foreground">#584C27</Color>
    <Color x:Key="statusBar.background">#EEE8D5</Color>
    <Color x:Key="statusBar.foreground">#586E75</Color>
    <Color x:Key="dropdown.background">#EEE8D5</Color>
    <Color x:Key="dropdown.foreground">#657B83</Color>   <!-- default -->
    <Color x:Key="dropdown.border">#D3AF86</Color>

    <!--  Git: file name colours in the explorer and the Git tab.  -->
    <Color x:Key="gitDecoration.modifiedResourceForeground">#895503</Color>   <!-- default -->
    <Color x:Key="gitDecoration.addedResourceForeground">#587C0C</Color>   <!-- default -->
    <Color x:Key="gitDecoration.untrackedResourceForeground">#007100</Color>   <!-- default -->
    <Color x:Key="gitDecoration.deletedResourceForeground">#AD0707</Color>   <!-- default -->
    <Color x:Key="gitDecoration.renamedResourceForeground">#007100</Color>   <!-- default -->
    <Color x:Key="gitDecoration.conflictingResourceForeground">#AD0707</Color>   <!-- default -->
    <Color x:Key="gitDecoration.ignoredResourceForeground">#CD5C5C</Color>   <!-- ours: IndianRed, as elsewhere in the app -->

    <!--  Diff view: line backgrounds (alpha flattened onto editor.background).  -->
    <Color x:Key="diffEditor.insertedLineBackground">#E9EAC7</Color>   <!-- default -->
    <Color x:Key="diffEditor.removedLineBackground">#FDC5B6</Color>   <!-- default -->
    <Color x:Key="diffEditor.diagonalFill">#E7E0CF</Color>   <!-- default -->

    <!--  Hover card and diagnostics (Editor/Hover).  -->
    <Color x:Key="editorHoverWidget.background">#CCC4B0</Color>
    <Color x:Key="editorHoverWidget.foreground">#657B83</Color>   <!-- default -->
    <Color x:Key="editorHoverWidget.border">#C8C8C8</Color>   <!-- default -->
    <Color x:Key="editorError.foreground">#E51400</Color>   <!-- default -->
    <Color x:Key="editorWarning.foreground">#BF8803</Color>   <!-- default -->
    <Color x:Key="editorInfo.foreground">#1A85FF</Color>   <!-- default -->
    <Color x:Key="textLink.foreground">#006AB1</Color>   <!-- default -->

    <!--  Editor margins, highlights and pop-ups (completion, find, quick fixes).  -->
    <Color x:Key="editorLineNumber.foreground">#237893</Color>   <!-- default -->
    <Color x:Key="editorGutter.foldingControlForeground">#424242</Color>   <!-- default -->
    <Color x:Key="editorLightBulb.foreground">#DDB100</Color>   <!-- default -->
    <Color x:Key="editor.inlineValuesForeground">#7E7B71</Color>   <!-- default -->
    <Color x:Key="editor.wordHighlightBackground">#40575757</Color>   <!-- default -->
    <Color x:Key="editorGroup.border">#DDD6C1</Color>
    <Color x:Key="editorWidget.background">#EEE8D5</Color>
    <Color x:Key="editorWidget.foreground">#657B83</Color>   <!-- default -->
    <Color x:Key="editorWidget.border">#C8C8C8</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.background">#EEE8D5</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.foreground">#657B83</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.border">#C8C8C8</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.selectedBackground">#DFCA88</Color>   <!-- default -->
    <Color x:Key="editorSuggestWidget.selectedForeground">#6C6C6C</Color>   <!-- default -->
    <Color x:Key="widget.shadow">#29000000</Color>   <!-- default -->

    <!--  Run and debug buttons (toolbar, debug toolbar).  -->
    <Color x:Key="debugIcon.startForeground">#388A34</Color>   <!-- default -->
    <Color x:Key="debugIcon.stopForeground">#A1260D</Color>   <!-- default -->
    <Color x:Key="debugIcon.restartForeground">#388A34</Color>   <!-- default -->
    <Color x:Key="debugIcon.continueForeground">#007ACC</Color>   <!-- default -->

    <!--  Overview ruler beside the editor's scrollbar (Editor/Highlighting/OverviewRuler).  -->
    <Color x:Key="editorOverviewRuler.errorForeground">#B3FF1212</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.warningForeground">#BF8803</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.infoForeground">#1A85FF</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.selectionHighlightForeground">#CCA0A0A0</Color>   <!-- default -->
    <Color x:Key="editorOverviewRuler.border">#4D7F7F7F</Color>   <!-- default -->
    <Color x:Key="editorCursor.foreground">#657B83</Color>
    <Color x:Key="scrollbarSlider.background">#66646464</Color>   <!-- default -->
    <Color x:Key="scrollbarSlider.hoverBackground">#B3646464</Color>   <!-- default -->
    <Color x:Key="scrollbarSlider.activeBackground">#99000000</Color>   <!-- default -->

    <!--  Links in the editor text (URLs). Default: a soft blue on dark themes, so it isn't too saturated.  -->
    <Color x:Key="editorLink.activeForeground">#1A5FB4</Color>   <!-- default -->
    <Color x:Key="editorCodeLens.foreground">#919191</Color>   <!-- default: the "3 references" lines -->

    <!--  Ours (not VS Code keys): tab.activeBackground mixed a little towards tab.activeForeground.  -->
    <Color x:Key="app.tab.selectedBackground">#E4DECD</Color>
    <!--  Ours: tab.inactiveBackground mixed a little towards tab.inactiveForeground (a hovered tab).  -->
    <Color x:Key="app.tab.hoverBackground">#C4C0AF</Color>
    <Color x:Key="app.panelHeader.activeBackground">#ECE6D4</Color>

    <!--  Ours: the preview's design grid, a blue that shows on light and dark previews.  -->
    <Color x:Key="app.preview.gridLine">#190E5EFD</Color>
    <Color x:Key="app.preview.gridLineMajor">#4D0E5EFD</Color>

    <!--  Debugger: value views, the current statement.  -->
    <Color x:Key="debugTokenExpression.name">#9B46B0</Color>   <!-- default: debugger views: names, values by kind -->
    <Color x:Key="debugTokenExpression.value">#6C6C6C</Color>   <!-- default -->
    <Color x:Key="debugTokenExpression.string">#A31515</Color>   <!-- default -->
    <Color x:Key="debugTokenExpression.boolean">#0000FF</Color>   <!-- default -->
    <Color x:Key="debugTokenExpression.number">#098658</Color>   <!-- default -->
    <Color x:Key="debugTokenExpression.error">#E51400</Color>   <!-- default -->
    <Color x:Key="editor.stackFrameHighlightBackground">#66FFFF66</Color>   <!-- default: the current statement while paused (alpha kept) -->
    <Color x:Key="editor.focusedStackFrameHighlightBackground">#2DCEE7CE</Color>   <!-- default: another frame picked in the Call Stack (alpha kept) -->
    <Color x:Key="debugIcon.breakpointCurrentStackframeForeground">#BE8700</Color>   <!-- default: the current-statement arrow -->
    <Color x:Key="debugIcon.breakpointStackframeForeground">#89D185</Color>   <!-- default -->
    <Color x:Key="app.debug.changedValueForeground">#E51400</Color>   <!-- default: ours: a value changed since the last step (VS shows it red) -->
</ResourceDictionary>
