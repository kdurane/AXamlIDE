<!--
    AvaloniaEdit's links (URLs in the text; its default is a hard-coded Blue) use the editorLink.activeForeground theme key.
    Its completion list is coloured like VS Code's suggest widget (editorSuggestWidget.* theme keys,
    brushes in Styles/ThemeResources.axaml). Its description tip, the overload viewer and the find panel read
    their own resource keys (CompletionToolTip*, OverloadViewer*, SearchPanel*), set in ThemeResources.axaml.
-->
<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:cc="using:AvaloniaEdit.CodeCompletion"
    xmlns:rendering="using:AvaloniaEdit.Rendering"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  The debugger's DataTip (Editor/Hover/DataTips): the hover card's look around a value view.  -->
    <Style Selector="Border.dataTip">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource HoverForegroundBrush}" />
    </Style>

    <Style Selector="rendering|TextView">
        <Setter Property="LinkTextForegroundBrush" Value="{DynamicResource EditorLinkBrush}" />
    </Style>
    <Style Selector="cc|CompletionListBox">
        <Setter Property="Background" Value="{DynamicResource CompletionListBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CompletionListForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CompletionListBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="cc|CompletionListBox ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource CompletionListForegroundBrush}" />
    </Style>
    <Style Selector="cc|CompletionListBox ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />
    </Style>
    <Style Selector="cc|CompletionListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CompletionListSelectedBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CompletionListSelectedForegroundBrush}" />
    </Style>
</Styles>
