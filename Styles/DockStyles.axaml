<!--
    The bottom panel (Problems, Output, Debug Console, Terminal...), made to look like VS Code's: the tabs along the top,
    with an X on the right that hides the whole panel (View.TogglePanel), and an X on the tabs that can be closed
    (Terminal, Tests, the debugger windows). Only the dock with Id "BottomTools" (ViewModels/DockFactory) gets this;
    Dock's ToolDockControl puts the dock's Id in AutomationId, which is what the selectors match.
-->

<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Dock.Model.Core"
    xmlns:shell="using:AXamlIDE.Shell"
    xmlns:vm="using:AXamlIDE.ViewModels">


    <Design.PreviewWith>
        <Border>
            <Button
                Name="HidePanelButton"
                shell:KeyMap.ShortcutTip="Hide Panel"
                AutomationProperties.Name="Hide Panel"
                Classes="icon panelHide"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TogglePanelCommand, FallbackValue={x:Null}}">
                <PathIcon Data="{StaticResource Icon.Close}" />
            </Button>
        </Border>
    </Design.PreviewWith>

    <!--
        A document tab's right-click menu, Visual Studio's. The tab's DataContext is its dockable: a DocumentDockable for
        a file (every item), a PageDockable for NuGet, a diff or a visualizer (only Close and Float: the file items bind
        by reflection and hide when the property isn't there).
    -->
    <Style Selector="DocumentTabStripItem">
        <Setter Property="ContextMenu">
            <ContextMenu x:DataType="core:IDockable">
                <MenuItem
                    shell:KeyMap.CommandId="File.Close"
                    Command="{Binding Owner.Factory.CloseDockable, FallbackValue={x:Null}}"
                    CommandParameter="{Binding}"
                    Header="_Close" />
                <MenuItem
                    Command="{ReflectionBinding CloseOtherTabsCommand}"
                    Header="Close All _But This"
                    IsVisible="{ReflectionBinding IsFileTab,
                                                  FallbackValue=False}" />
                <MenuItem
                    shell:KeyMap.CommandId="File.CloseAll"
                    Command="{ReflectionBinding CloseAllTabsCommand}"
                    Header="Close _All Documents"
                    IsVisible="{ReflectionBinding IsFileTab,
                                                  FallbackValue=False}" />
                <Separator IsVisible="{ReflectionBinding IsFileTab, FallbackValue=False}" />
                <MenuItem
                    shell:KeyMap.CommandId="File.Save"
                    Command="{ReflectionBinding SaveTabCommand}"
                    Header="_Save"
                    IsVisible="{ReflectionBinding IsFileTab,
                                                  FallbackValue=False}" />
                <MenuItem
                    Command="{ReflectionBinding CopyFullPathCommand}"
                    Header="Copy Full _Path"
                    IsVisible="{ReflectionBinding IsFileTab,
                                                  FallbackValue=False}" />
                <MenuItem
                    Command="{ReflectionBinding OpenContainingFolderCommand}"
                    Header="Open Containing _Folder"
                    IsVisible="{ReflectionBinding IsFileTab,
                                                  FallbackValue=False}" />
                <Separator />
                <MenuItem
                    Command="{Binding Owner.Factory.FloatDockable, FallbackValue={x:Null}}"
                    CommandParameter="{Binding}"
                    Header="F_loat"
                    IsVisible="{Binding CanFloat}" />
            </ContextMenu>
        </Setter>
    </Style>

    <!--  No title bar: the content (the tabs and the selected tool), with the panel's own buttons over the tab row's right end.  -->
    <Style Selector="ToolDockControl[(AutomationProperties.AutomationId)=BottomTools] ToolChromeControl">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Background="{TemplateBinding Background}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <Button
                        Name="HidePanelButton"
                        shell:KeyMap.ShortcutTip="Hide Panel"
                        AutomationProperties.Name="Hide Panel"
                        Classes="icon panelHide"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TogglePanelCommand, FallbackValue={x:Null}}">
                        <PathIcon Data="{StaticResource Icon.Close}" />
                    </Button>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ToolDockControl[(AutomationProperties.AutomationId)=BottomTools] ToolControl">
        <Setter Property="HeaderTemplate">
            <DataTemplate x:DataType="core:IDockable">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Padding="{DynamicResource DockHeaderContentPadding}"
                        VerticalAlignment="Center"
                        Text="{Binding Title}" />
                    <Button
                        Padding="2"
                        AutomationProperties.Name="Close"
                        Classes="icon panelTabClose"
                        Command="{Binding Owner.Factory.CloseDockable, FallbackValue={x:Null}}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding CanClose}"
                        ToolTip.Tip="Close">
                        <PathIcon Data="{StaticResource Icon.Close}" />
                    </Button>
                </StackPanel>
            </DataTemplate>
        </Setter>
    </Style>

    <!--  The tabs on top, kept clear of the Hide Panel button; shown even when there's only one.  -->
    <Style Selector="ToolDockControl[(AutomationProperties.AutomationId)=BottomTools] ToolControl /template/ ToolTabStrip#PART_TabStrip">
        <Setter Property="DockPanel.Dock" Value="Top" />
        <Setter Property="Padding" Value="0,0,32,0" />
    </Style>
    <Style Selector="ToolDockControl[(AutomationProperties.AutomationId)=BottomTools] ToolTabStrip:singleitem /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!--  Set here, not in the template: a template's own values lose to Button.icon's.  -->
    <Style Selector="Button.panelHide">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,6,6,0" />
    </Style>

    <Style Selector="Button.panelTabClose">
        <Setter Property="Margin" Value="4,0,-4,0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.panelTabClose PathIcon">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>
</Styles>
