<!--
    App-wide list looks, picked with a class on the ListBox (Classes="compact").
-->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <ListBox Classes="compact" Width="200">
            <ListBoxItem Content="One" />
            <ListBoxItem Content="Two" />
        </ListBox>
    </Design.PreviewWith>

    <!--  compact: dense rows for tool panels (Problems, Call Stack, Git changes), as in VS's tool windows.  -->
    <Style Selector="ListBox.compact">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.compact ListBoxItem">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <!--  graph: the Git graph's rows touch (no padding above or below), so the lines drawn in them join up.  -->
    <Style Selector="ListBox.graph ListBoxItem">
        <Setter Property="Padding" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="22" />
    </Style>
    <!--  compact tree: the same dense rows (the references list under a code lens).  -->
    <Style Selector="TreeView.compact">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeView.compact TreeViewItem">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
    </Style>
</Styles>
