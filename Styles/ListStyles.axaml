<!--
    App-wide list looks, picked with a class on the ListBox (Classes="compact").
-->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <ListBox Classes="compact" Width="200">
            <ListBoxItem Content="One" />
            <ListBoxItem Content="Two" />
        </ListBox>
    </Design.PreviewWith>

    <!--  compact: dense rows for tool panels (Problems, Call Stack, Git changes), as in VS's tool windows.  -->
    <Style Selector="ListBox.compact">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.compact ListBoxItem">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <!--  graph: the Git graph's rows touch (no padding above or below), so the lines drawn in them join up.  -->
    <Style Selector="ListBox.graph ListBoxItem">
        <Setter Property="Padding" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="22" />
    </Style>
    <!--  tabs: a row of words to pick from, the picked one underlined (Search Everywhere's All / Types / Files..., as Rider's).  -->
    <Style Selector="ListBox.tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DockTabActiveIndicatorBrush}" />
    </Style>
    <!--  compact tree: the same dense rows (the references list under a code lens).  -->
    <Style Selector="TreeView.compact">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TreeView.compact TreeViewItem">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
    </Style>
</Styles>
