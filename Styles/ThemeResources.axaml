<!--
The UI colours for every theme in Settings, switched by Avalonia's theme variants.

1. ThemeDictionaries: one entry per theme (Views/ThemeVariants), each a Styles/Themes/<Id>.axaml file of
colours named after VS Code's theme keys ("editor.background", "sideBar.background"...). Selecting a
theme sets Application.RequestedThemeVariant (Views/ThemeSwitcher); Avalonia does the rest.
Each theme is based on Dark or Light, so Dock's matching preset and Fluent's matching look fill in
anything not set here.
2. Brushes: the resource keys the views use (our App*/Theme* brushes, and the Dock and Fluent ones we
restyle), each coloured from a theme key with {DynamicResource}, so they follow the theme.

To colour another part of the UI: add a brush below (from an existing key, or add the key to every
file in Styles/Themes/), then use it in the view as {DynamicResource ...}.
-->
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:views="using:AXamlIDE.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!--  The base looks: what a theme falls back to.  -->
        <!--  Also VS Code's defaults for the Git graph and test result colours, which no theme here sets (a theme file can override them).  -->
        <ResourceDictionary x:Key="Dark">
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Dock.Avalonia.Themes.Fluent/Presets/Ide/VsCodeDark.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="scmGraph.foreground1">#FFB000</Color>
            <Color x:Key="scmGraph.foreground2">#DC267F</Color>
            <Color x:Key="scmGraph.foreground3">#994F00</Color>
            <Color x:Key="scmGraph.foreground4">#40A6FF</Color>
            <Color x:Key="scmGraph.foreground5">#B66DFF</Color>
            <Color x:Key="scmGraph.historyItemRefColor">#3794FF</Color>
            <Color x:Key="scmGraph.historyItemRemoteRefColor">#B180D7</Color>
            <Color x:Key="app.scmGraph.tagColor">#D18616</Color>   <!-- ours: VS Code's chart orange -->
            <Color x:Key="app.scmGraph.labelForeground">#FFFFFF</Color>
            <Color x:Key="testing.iconPassed">#73C991</Color>
            <Color x:Key="testing.iconFailed">#F14C4C</Color>
            <Color x:Key="testing.iconSkipped">#848484</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Dock.Avalonia.Themes.Fluent/Presets/Ide/VsCodeLight.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="scmGraph.foreground1">#FFB000</Color>
            <Color x:Key="scmGraph.foreground2">#DC267F</Color>
            <Color x:Key="scmGraph.foreground3">#994F00</Color>
            <Color x:Key="scmGraph.foreground4">#40A6FF</Color>
            <Color x:Key="scmGraph.foreground5">#B66DFF</Color>
            <Color x:Key="scmGraph.historyItemRefColor">#1A85FF</Color>
            <Color x:Key="scmGraph.historyItemRemoteRefColor">#652D90</Color>
            <Color x:Key="app.scmGraph.tagColor">#D18616</Color>
            <Color x:Key="app.scmGraph.labelForeground">#FFFFFF</Color>
            <Color x:Key="testing.iconPassed">#388A34</Color>
            <Color x:Key="testing.iconFailed">#F14C4C</Color>
            <Color x:Key="testing.iconSkipped">#848484</Color>
        </ResourceDictionary>

        <!--  The themes in Settings.  -->
        <ResourceInclude Source="/Styles/Themes/Abbys.axaml" x:Key="{x:Static views:ThemeVariants.Abbys}" />
        <ResourceInclude Source="/Styles/Themes/Dark.axaml" x:Key="{x:Static views:ThemeVariants.Dark}" />
        <ResourceInclude Source="/Styles/Themes/DarkPlus.axaml" x:Key="{x:Static views:ThemeVariants.DarkPlus}" />
        <ResourceInclude Source="/Styles/Themes/DimmedMonokai.axaml" x:Key="{x:Static views:ThemeVariants.DimmedMonokai}" />
        <ResourceInclude Source="/Styles/Themes/KimbieDark.axaml" x:Key="{x:Static views:ThemeVariants.KimbieDark}" />
        <ResourceInclude Source="/Styles/Themes/Light.axaml" x:Key="{x:Static views:ThemeVariants.Light}" />
        <ResourceInclude Source="/Styles/Themes/LightPlus.axaml" x:Key="{x:Static views:ThemeVariants.LightPlus}" />
        <ResourceInclude Source="/Styles/Themes/OneDark.axaml" x:Key="{x:Static views:ThemeVariants.OneDark}" />
        <ResourceInclude Source="/Styles/Themes/Monokai.axaml" x:Key="{x:Static views:ThemeVariants.Monokai}" />
        <ResourceInclude Source="/Styles/Themes/QuietLight.axaml" x:Key="{x:Static views:ThemeVariants.QuietLight}" />
        <ResourceInclude Source="/Styles/Themes/Red.axaml" x:Key="{x:Static views:ThemeVariants.Red}" />
        <ResourceInclude Source="/Styles/Themes/SolarizedDark.axaml" x:Key="{x:Static views:ThemeVariants.SolarizedDark}" />
        <ResourceInclude Source="/Styles/Themes/SolarizedLight.axaml" x:Key="{x:Static views:ThemeVariants.SolarizedLight}" />
        <ResourceInclude Source="/Styles/Themes/TomorrowNightBlue.axaml" x:Key="{x:Static views:ThemeVariants.TomorrowNightBlue}" />
        <ResourceInclude Source="/Styles/Themes/HighContrastLight.axaml" x:Key="{x:Static views:ThemeVariants.HighContrastLight}" />
        <ResourceInclude Source="/Styles/Themes/HighContrastDark.axaml" x:Key="{x:Static views:ThemeVariants.HighContrastDark}" />
        <ResourceInclude Source="/Styles/Themes/Dracula.axaml" x:Key="{x:Static views:ThemeVariants.Dracula}" />
        <ResourceInclude Source="/Styles/Themes/AtomOneLight.axaml" x:Key="{x:Static views:ThemeVariants.AtomOneLight}" />
        <ResourceInclude Source="/Styles/Themes/AtomOneDark.axaml" x:Key="{x:Static views:ThemeVariants.AtomOneDark}" />
        <ResourceInclude Source="/Styles/Themes/VisualStudioLight.axaml" x:Key="{x:Static views:ThemeVariants.VisualStudioLight}" />
        <ResourceInclude Source="/Styles/Themes/VisualStudioDark.axaml" x:Key="{x:Static views:ThemeVariants.VisualStudioDark}" />
        <ResourceInclude Source="/Styles/Themes/AxamlDark.axaml" x:Key="{x:Static views:ThemeVariants.AxamlDark}" />
    </ResourceDictionary.ThemeDictionaries>

    <!--  Window and editor area  -->
    <SolidColorBrush Color="{DynamicResource editor.background}" x:Key="AppWindowBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource editor.background}" x:Key="DockSurfaceEditorBrush" />
    <SolidColorBrush Color="{DynamicResource editor.background}" x:Key="DockSurfaceWorkbenchBrush" />
    <SolidColorBrush Color="{DynamicResource editor.foreground}" x:Key="AppForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource editor.foreground}" x:Key="ThemeForegroundBrush" />

    <!--  Side bar, tool panels, trees and lists  -->
    <SolidColorBrush Color="{DynamicResource sideBar.background}" x:Key="ThemeBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource sideBar.background}" x:Key="AppDocumentBarBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource sideBar.background}" x:Key="DockSurfaceSidebarBrush" />
    <SolidColorBrush Color="{DynamicResource sideBar.background}" x:Key="DockSurfacePanelBrush" />
    <SolidColorBrush Color="{DynamicResource sideBar.background}" x:Key="TreeViewItemBackground" />
    <SolidColorBrush Color="{DynamicResource sideBar.background}" x:Key="ListBoxItemBackground" />
    <SolidColorBrush Color="{DynamicResource sideBar.foreground}" x:Key="TreeViewItemForeground" />
    <SolidColorBrush Color="{DynamicResource sideBar.foreground}" x:Key="ListBoxItemForeground" />
    <SolidColorBrush Color="{DynamicResource sideBarSectionHeader.background}" x:Key="DockSurfaceHeaderBrush" />
    <SolidColorBrush Color="{DynamicResource app.panelHeader.activeBackground}" x:Key="DockSurfaceHeaderActiveBrush" />
    <SolidColorBrush Color="{DynamicResource sideBarSectionHeader.foreground}" x:Key="DockWindowChromeForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource sideBarSectionHeader.foreground}" x:Key="DockChromeButtonForegroundBrush" />

    <!--  Tabs  -->
    <SolidColorBrush Color="{DynamicResource tab.inactiveBackground}" x:Key="DockTabBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource tab.inactiveForeground}" x:Key="DockTabForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource app.tab.selectedBackground}" x:Key="DockTabActiveBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource tab.activeForeground}" x:Key="DockTabActiveForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource tab.activeForeground}" x:Key="DockTabSelectedForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource tab.activeForeground}" x:Key="DockDocumentTabSelectedForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource tab.activeForeground}" x:Key="DockDocumentTabPointerOverForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource tab.border}" x:Key="DockBorderSubtleBrush" />
    <SolidColorBrush Color="{DynamicResource tab.border}" x:Key="DockSeparatorBrush" />
    <SolidColorBrush Color="{DynamicResource tab.border}" x:Key="DockTabActiveIndicatorBrush" />

    <!--  Hover and selection  -->
    <SolidColorBrush Color="{DynamicResource app.tab.hoverBackground}" x:Key="DockTabHoverBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource list.hoverBackground}" x:Key="TreeViewItemBackgroundPointerOver" />
    <SolidColorBrush Color="{DynamicResource list.hoverBackground}" x:Key="ListBoxItemBackgroundPointerOver" />
    <SolidColorBrush Color="{DynamicResource list.hoverBackground}" x:Key="ComboBoxItemBackgroundPointerOver" />
    <SolidColorBrush Color="{DynamicResource list.hoverBackground}" x:Key="MenuFlyoutItemBackgroundPointerOver" />
    <SolidColorBrush Color="{DynamicResource list.inactiveSelectionBackground}" x:Key="TreeViewItemBackgroundSelected" />
    <SolidColorBrush Color="{DynamicResource list.inactiveSelectionBackground}" x:Key="ListBoxItemBackgroundSelected" />
    <SolidColorBrush Color="{DynamicResource list.inactiveSelectionBackground}" x:Key="ComboBoxItemBackgroundSelected" />
    <SolidColorBrush Color="{DynamicResource list.activeSelectionBackground}" x:Key="TreeViewItemBackgroundSelectedPointerOver" />
    <SolidColorBrush Color="{DynamicResource list.activeSelectionBackground}" x:Key="ListBoxItemBackgroundSelectedPointerOver" />
    <SolidColorBrush Color="{DynamicResource list.activeSelectionBackground}" x:Key="ComboBoxItemBackgroundSelectedPointerOver" />
    <SolidColorBrush Color="{DynamicResource list.activeSelectionForeground}" x:Key="TreeViewItemForegroundSelected" />
    <SolidColorBrush Color="{DynamicResource list.activeSelectionForeground}" x:Key="ListBoxItemForegroundSelected" />
    <SolidColorBrush Color="{DynamicResource list.activeSelectionForeground}" x:Key="ComboBoxItemForegroundSelected" />

    <!--  Title bar, activity bar, status bar  -->
    <SolidColorBrush Color="{DynamicResource titleBar.activeBackground}" x:Key="AppTitleBarBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource titleBar.activeBackground}" x:Key="DockWindowChromeTitleBarBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource titleBar.activeForeground}" x:Key="AppTitleBarForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource activityBar.background}" x:Key="AppActivityBarBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource activityBar.foreground}" x:Key="AppActivityBarForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource statusBar.background}" x:Key="AppStatusBarBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource statusBar.foreground}" x:Key="AppStatusBarForegroundBrush" />

    <!--  Drop-downs and menus  -->
    <SolidColorBrush Color="{DynamicResource dropdown.background}" x:Key="ComboBoxBackground" />
    <SolidColorBrush Color="{DynamicResource dropdown.background}" x:Key="ComboBoxBackgroundPointerOver" />
    <SolidColorBrush Color="{DynamicResource dropdown.background}" x:Key="ComboBoxDropDownBackground" />
    <SolidColorBrush Color="{DynamicResource dropdown.background}" x:Key="ComboBoxItemBackground" />
    <SolidColorBrush Color="{DynamicResource dropdown.background}" x:Key="MenuFlyoutPresenterBackground" />
    <SolidColorBrush Color="{DynamicResource dropdown.foreground}" x:Key="ComboBoxForeground" />
    <SolidColorBrush Color="{DynamicResource dropdown.foreground}" x:Key="ComboBoxItemForeground" />
    <SolidColorBrush Color="{DynamicResource dropdown.foreground}" x:Key="MenuFlyoutItemForeground" />
    <SolidColorBrush Color="{DynamicResource dropdown.border}" x:Key="ComboBoxBorderBrush" />
    <SolidColorBrush Color="{DynamicResource dropdown.border}" x:Key="ComboBoxDropDownBorderBrush" />

    <!--  Git (Views/GitStateConverters picks one per file state)  -->
    <SolidColorBrush Color="{DynamicResource gitDecoration.modifiedResourceForeground}" x:Key="GitModifiedBrush" />
    <SolidColorBrush Color="{DynamicResource gitDecoration.addedResourceForeground}" x:Key="GitAddedBrush" />
    <SolidColorBrush Color="{DynamicResource gitDecoration.untrackedResourceForeground}" x:Key="GitUntrackedBrush" />
    <SolidColorBrush Color="{DynamicResource gitDecoration.deletedResourceForeground}" x:Key="GitDeletedBrush" />
    <SolidColorBrush Color="{DynamicResource gitDecoration.renamedResourceForeground}" x:Key="GitRenamedBrush" />
    <SolidColorBrush Color="{DynamicResource gitDecoration.conflictingResourceForeground}" x:Key="GitConflictedBrush" />
    <SolidColorBrush Color="{DynamicResource gitDecoration.ignoredResourceForeground}" x:Key="GitIgnoredBrush" />
    <!--  Git graph: the lane colours in turn (Views/GitGraphCell), and the branch / tag labels  -->
    <SolidColorBrush Color="{DynamicResource scmGraph.foreground1}" x:Key="GitGraphLane1Brush" />
    <SolidColorBrush Color="{DynamicResource scmGraph.foreground2}" x:Key="GitGraphLane2Brush" />
    <SolidColorBrush Color="{DynamicResource scmGraph.foreground3}" x:Key="GitGraphLane3Brush" />
    <SolidColorBrush Color="{DynamicResource scmGraph.foreground4}" x:Key="GitGraphLane4Brush" />
    <SolidColorBrush Color="{DynamicResource scmGraph.foreground5}" x:Key="GitGraphLane5Brush" />
    <SolidColorBrush Color="{DynamicResource scmGraph.historyItemRefColor}" x:Key="GitGraphBranchBrush" />
    <SolidColorBrush Color="{DynamicResource scmGraph.historyItemRemoteRefColor}" x:Key="GitGraphRemoteBranchBrush" />
    <SolidColorBrush Color="{DynamicResource app.scmGraph.tagColor}" x:Key="GitGraphTagBrush" />
    <SolidColorBrush Color="{DynamicResource app.scmGraph.labelForeground}" x:Key="GitGraphLabelForegroundBrush" />

    <!--  Test Explorer: a test's result  -->
    <SolidColorBrush Color="{DynamicResource testing.iconPassed}" x:Key="TestPassedBrush" />
    <SolidColorBrush Color="{DynamicResource testing.iconFailed}" x:Key="TestFailedBrush" />
    <SolidColorBrush Color="{DynamicResource testing.iconSkipped}" x:Key="TestSkippedBrush" />

    <!--  Diff view (Editor/Diff/DiffLineRenderer)  -->
    <SolidColorBrush Color="{DynamicResource diffEditor.insertedLineBackground}" x:Key="DiffInsertedLineBrush" />
    <SolidColorBrush Color="{DynamicResource diffEditor.removedLineBackground}" x:Key="DiffRemovedLineBrush" />
    <SolidColorBrush Color="{DynamicResource diffEditor.diagonalFill}" x:Key="DiffFillerLineBrush" />

    <!--  Hover card and diagnostics (Editor/Hover/HoverCard)  -->
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.background}" x:Key="HoverBackgroundBrush" />
    <!--  Tooltips (Fluent's keys) look like VS Code's hovers: the Git graph's commit card, and every other tooltip  -->
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.background}" x:Key="ToolTipBackground" />
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.foreground}" x:Key="ToolTipForeground" />
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.border}" x:Key="ToolTipBorderBrush" />
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.foreground}" x:Key="HoverForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.border}" x:Key="HoverBorderBrush" />
    <SolidColorBrush Color="{DynamicResource editorError.foreground}" x:Key="DiagnosticErrorBrush" />
    <SolidColorBrush Color="{DynamicResource editorWarning.foreground}" x:Key="DiagnosticWarningBrush" />
    <SolidColorBrush Color="{DynamicResource editorInfo.foreground}" x:Key="DiagnosticInfoBrush" />
    <SolidColorBrush Color="{DynamicResource textLink.foreground}" x:Key="LinkBrush" />
    <!--  Editor margins and highlights (Editor/Folding, Editor/CodeActions, Editor/Highlighting, Editor/Debugging)  -->
    <SolidColorBrush Color="{DynamicResource editorLineNumber.foreground}" x:Key="FoldingMarkerForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorGutter.foldingControlForeground}" x:Key="FoldingMarkerHoverForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorLightBulb.foreground}" x:Key="LightBulbBrush" />
    <SolidColorBrush Color="{DynamicResource editor.inlineValuesForeground}" x:Key="InlineValueForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource editor.wordHighlightBackground}" x:Key="WordHighlightBrush" />
    <SolidColorBrush Color="{DynamicResource editorGroup.border}" x:Key="EditorSplitterBrush" />
    <SolidColorBrush Color="{DynamicResource editorLink.activeForeground}" x:Key="EditorLinkBrush" />
    <SolidColorBrush Color="{DynamicResource editorCodeLens.foreground}" x:Key="CodeLensForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorCodeLens.foreground}" x:Key="CompletionDetailForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorInlayHint.foreground}" x:Key="InlayHintForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorInlayHint.background}" x:Key="InlayHintBackgroundBrush" />
    <!--  Avalonia's DataGrid (the debugger's table visualizer): its own keys, mapped to the theme.  -->
    <SolidColorBrush Color="{DynamicResource sideBarSectionHeader.background}" x:Key="DataGridColumnHeaderBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource sideBarSectionHeader.foreground}" x:Key="DataGridColumnHeaderForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource list.hoverBackground}" x:Key="DataGridColumnHeaderHoveredBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource list.inactiveSelectionBackground}" x:Key="DataGridColumnHeaderPressedBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorGroup.border}" x:Key="DataGridGridLinesBrush" />
    <SolidColorBrush Color="{DynamicResource editor.background}" x:Key="DataGridRowBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource editor.background}" x:Key="DataGridCellBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource list.activeSelectionBackground}" x:Key="DataGridRowSelectedBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource list.inactiveSelectionBackground}" x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource list.activeSelectionBackground}" x:Key="DataGridRowSelectedHoveredBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource list.inactiveSelectionBackground}" x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" />

    <!--  Debugger: DataTips / Locals / Watch values by kind, changed values, the current statement and its arrow.  -->
    <SolidColorBrush Color="{DynamicResource debugTokenExpression.name}" x:Key="DebugNameBrush" />
    <SolidColorBrush Color="{DynamicResource debugTokenExpression.value}" x:Key="DebugValueBrush" />
    <SolidColorBrush Color="{DynamicResource debugTokenExpression.string}" x:Key="DebugStringBrush" />
    <SolidColorBrush Color="{DynamicResource debugTokenExpression.boolean}" x:Key="DebugBooleanBrush" />
    <SolidColorBrush Color="{DynamicResource debugTokenExpression.number}" x:Key="DebugNumberBrush" />
    <SolidColorBrush Color="{DynamicResource debugTokenExpression.error}" x:Key="DebugErrorBrush" />
    <SolidColorBrush Color="{DynamicResource app.debug.changedValueForeground}" x:Key="DebugChangedValueBrush" />
    <SolidColorBrush Color="{DynamicResource editor.stackFrameHighlightBackground}" x:Key="StackFrameHighlightBrush" />
    <SolidColorBrush Color="{DynamicResource editor.focusedStackFrameHighlightBackground}" x:Key="FocusedStackFrameHighlightBrush" />
    <SolidColorBrush Color="{DynamicResource debugIcon.breakpointCurrentStackframeForeground}" x:Key="CurrentStatementArrowBrush" />
    <SolidColorBrush Color="{DynamicResource debugIcon.breakpointStackframeForeground}" x:Key="StackFrameArrowBrush" />
    <SolidColorBrush Color="{DynamicResource widget.shadow}" x:Key="WidgetShadowBrush" />

    <!--  Overview ruler beside the editor's scrollbar (Editor/Highlighting/OverviewRuler)  -->
    <SolidColorBrush Color="{DynamicResource editorOverviewRuler.errorForeground}" x:Key="OverviewRulerErrorBrush" />
    <SolidColorBrush Color="{DynamicResource editorOverviewRuler.warningForeground}" x:Key="OverviewRulerWarningBrush" />
    <SolidColorBrush Color="{DynamicResource editorOverviewRuler.infoForeground}" x:Key="OverviewRulerInfoBrush" />
    <SolidColorBrush Color="{DynamicResource editorOverviewRuler.selectionHighlightForeground}" x:Key="OverviewRulerOccurrenceBrush" />
    <SolidColorBrush Color="{DynamicResource editorOverviewRuler.border}" x:Key="OverviewRulerBorderBrush" />
    <SolidColorBrush Color="{DynamicResource editorCursor.foreground}" x:Key="OverviewRulerCaretBrush" />
    <SolidColorBrush Color="{DynamicResource scrollbarSlider.background}" x:Key="OverviewRulerViewportBrush" />
    <SolidColorBrush Color="{DynamicResource scrollbarSlider.hoverBackground}" x:Key="OverviewRulerViewportHoverBrush" />
    <SolidColorBrush Color="{DynamicResource scrollbarSlider.activeBackground}" x:Key="OverviewRulerViewportActiveBrush" />

    <!--  Run and debug buttons (the toolbar's play/stop, the debug toolbar)  -->
    <SolidColorBrush Color="{DynamicResource debugIcon.startForeground}" x:Key="DebugStartBrush" />
    <SolidColorBrush Color="{DynamicResource debugIcon.stopForeground}" x:Key="DebugStopBrush" />
    <SolidColorBrush Color="{DynamicResource debugIcon.restartForeground}" x:Key="DebugRestartBrush" />
    <SolidColorBrush Color="{DynamicResource debugIcon.continueForeground}" x:Key="DebugContinueBrush" />

    <!--  AvaloniaEdit's pop-ups: completion list, its description tip, the overload viewer, the find panel  -->
    <SolidColorBrush Color="{DynamicResource editorSuggestWidget.background}" x:Key="CompletionListBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorSuggestWidget.foreground}" x:Key="CompletionListForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorSuggestWidget.border}" x:Key="CompletionListBorderBrush" />
    <SolidColorBrush Color="{DynamicResource editorSuggestWidget.selectedBackground}" x:Key="CompletionListSelectedBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorSuggestWidget.selectedForeground}" x:Key="CompletionListSelectedForegroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.background}" x:Key="CompletionToolTipBackground" />
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.foreground}" x:Key="CompletionToolTipForeground" />
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.border}" x:Key="CompletionToolTipBorderBrush" />
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.background}" x:Key="OverloadViewerBackground" />
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.foreground}" x:Key="OverloadViewerForeground" />
    <SolidColorBrush Color="{DynamicResource editorHoverWidget.border}" x:Key="OverloadViewerBorderBrush" />
    <SolidColorBrush Color="{DynamicResource editorWidget.background}" x:Key="SearchPanelBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource editorWidget.border}" x:Key="SearchPanelBorderBrush" />

    <!--  Preview design grid (Views/PreviewGridLines)  -->
    <SolidColorBrush Color="{DynamicResource app.preview.gridLine}" x:Key="PreviewGridLineBrush" />
    <SolidColorBrush Color="{DynamicResource app.preview.gridLineMajor}" x:Key="PreviewGridLineMajorBrush" />
    <DrawingBrush x:Key="CheckerboardBrush" DestinationRect="0,0,16,16" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
                <GeometryDrawing Brush="#DDDDDD" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
