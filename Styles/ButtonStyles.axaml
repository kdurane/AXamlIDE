<!--
App-wide button looks, picked with a class (Classes="icon"). Colours come from Styles/ThemeResources.axaml.
-->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Margin="20" Spacing="8">
            <Button Classes="icon">
                <PathIcon Data="{DynamicResource Icon.Plus}" />
            </Button>
            <Button Classes="link" Content="https://avaloniaui.net" />
            <ToggleButton Classes="row expander">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Classes="chevron triangle" Height="8" Margin="0,0,6,0" Width="8" />
                    <TextBlock Text="A row that expands" />
                </StackPanel>
            </ToggleButton>
            <Button Classes="row" Content="A clickable row" />
        </StackPanel>
    </Design.PreviewWith>

    <!--  icon: a small flat button holding a PathIcon (refresh, stage, new item...), in panel headers and list rows.  -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon PathIcon">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

    <!--
    statusBarItem: a clickable part of the main window's status bar (solution-wide analysis), flat in the bar's own
    colours. The hover is a translucent grey, so it shows on every theme's bar, light or dark.
    -->
    <Style Selector="Button.statusBarItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AppStatusBarForegroundBrush}" />
    </Style>
    <Style Selector="Button.statusBarItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppStatusBarForegroundBrush}" />
    </Style>
    <Style Selector="Button.statusBarItem:pointerover /template/ ContentPresenter, Button.statusBarItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#33808080" />
    </Style>
    <Style Selector="Button.statusBarItem PathIcon">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppStatusBarForegroundBrush}" />
    </Style>

    <!--  link: looks like a hyperlink (the click handler opens it).  -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
    row: a whole list row you click (search results), flat and highlighted on hover like a list item.
    ToggleButton.row.expander is a group header: its PathIcon.chevron points down while it's open (a chevron, or a
    small triangle with Classes="chevron triangle"); the styles give the icon its shape, so don't set its Data.
    -->
    <Style Selector="Button.row, ToggleButton.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.row /template/ ContentPresenter, ToggleButton.row /template/ ContentPresenter, ToggleButton.row:checked /template/ ContentPresenter, Button.row:pressed /template/ ContentPresenter, ToggleButton.row:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter, ToggleButton.row:pointerover /template/ ContentPresenter, ToggleButton.row:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPointerOver}" />
    </Style>
    <!--
        The shape is swapped rather than the icon turned: PathIcon (Avalonia 12) sets RenderTransform on its own
        template in code, over any style, so a rotate() in a style doesn't show.
    -->
    <Style Selector="ToggleButton.expander PathIcon.chevron">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        <Setter Property="Data" Value="{DynamicResource Icon.ChevronRight}" />
    </Style>
    <Style Selector="ToggleButton.expander PathIcon.chevron.triangle">
        <Setter Property="Data" Value="M 2,0 L 6,4 L 2,8 Z" />
    </Style>
    <Style Selector="ToggleButton.expander:checked PathIcon.chevron">
        <Setter Property="Data" Value="{DynamicResource Icon.ChevronDown}" />
    </Style>
    <Style Selector="ToggleButton.expander:checked PathIcon.chevron.triangle">
        <Setter Property="Data" Value="M 0,2 L 8,2 L 4,6 Z" />
    </Style>

    <!--
    startAction: one of the start window's "Get started" choices, Visual Studio style: a large tile with an icon, a
    title and a line about it.
    -->
    <Style Selector="Button.startAction">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPointerOver}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.startAction:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
    </Style>
    <Style Selector="Button.startAction PathIcon">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,2,14,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!--  pin: a recent entry's pin, shown while the row is under the pointer, and always once it's pinned.  -->
    <Style Selector="Button.pin">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.row:pointerover Button.pin, Button.pin.pinned">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!--  clear: the small x that empties a box (TextBox.SearchBox shows it once there's text).  -->
    <!--  searchLauncher: looks like a search box but opens a window (the top bar's Search Everywhere, as VS's and Rider's).  -->
    <Style Selector="Button.searchLauncher">
        <Setter Property="Background" Value="{DynamicResource AppWindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.searchLauncher PathIcon, Button.searchLauncher TextBlock">
        <Setter Property="Opacity" Value="0.65" />
    </Style>

    <Style Selector="Button.clear">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.clear PathIcon">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource DiagnosticErrorBrush}" />
    </Style>

    <Style Selector="Button.dbg">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.dbg ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.dbg PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Button.pause > PathIcon">
        <Setter Property="Data" Value="{DynamicResource Icon.Pause}" />
    </Style>
    <Style Selector="Button.play > PathIcon">
        <Setter Property="Data" Value="{DynamicResource Icon.Play}" />
    </Style>
    <Style Selector="Button.stacked > PathIcon">
        <Setter Property="Data" Value="{DynamicResource Icon.ArrowUpDown}" />
    </Style>
    <Style Selector="Button.nonstacked > PathIcon">
        <Setter Property="Data" Value="{DynamicResource Icon.ArrowLeftRight}" />
    </Style>

    <!--
    startButton: the toolbar's Visual Studio start button (MainWindow): play + startup project name, and an arrow that
    lists the startup projects. Coloured like the configuration box beside it (SplitButton* in ThemeResources).
    -->
    <Style Selector="SplitButton.startButton">
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="SplitButton.startButton /template/ Button">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="SplitButton.startButton /template/ Button#PART_PrimaryButton">
        <Setter Property="Padding" Value="6,0,8,0" />
    </Style>
    <Style Selector="SplitButton.startButton /template/ Button#PART_SecondaryButton">
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="SplitButton.startButton PathIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="SplitButton.startButton TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</Styles>
