<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  A section of a settings page ("Typing", "IntelliSense").  -->
    <Style Selector="TextBlock.SettingsHeading">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!--  What a setting does, under its checkbox (lined up with the checkbox's text).  -->
    <Style Selector="TextBlock.SettingHint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Margin" Value="28,-4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  A row's line number, dimmed, in a fixed column so the code lines up (references list).  -->
    <Style Selector="TextBlock.LineNumber">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
