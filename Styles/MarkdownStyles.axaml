<!--
The Markdown preview's look (Views/MarkdownRenderer builds the controls and gives them these classes), close to
GitHub's and VS Code's: larger headings with a rule under the first two, code in the editor font on a tinted
background, quotes with a bar on the left, tables with borders. Colours come from Styles/ThemeResources.axaml.
-->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="ScrollViewer.md-preview">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
    </Style>
    <Style Selector="StackPanel.md-body">
        <Setter Property="Margin" Value="24,16,24,32" />
        <Setter Property="MaxWidth" Value="900" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--  Text  -->
    <Style Selector="StackPanel.md-body SelectableTextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.md-p">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h1, SelectableTextBlock.md-h2, SelectableTextBlock.md-h3, SelectableTextBlock.md-h4, SelectableTextBlock.md-h5, SelectableTextBlock.md-h6">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="NaN" />
        <Setter Property="Margin" Value="0,18,0,10" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h1">
        <Setter Property="FontSize" Value="28" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h2">
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h3">
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h4">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h5">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="SelectableTextBlock.md-h6">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style Selector="Run.md-strong">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Run.md-em">
        <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Run.md-strike">
        <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="Run.md-link">
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Run.md-code">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,Monospace" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPointerOver}" />
    </Style>

    <!--  Blocks  -->
    <Style Selector="Border.md-code-block">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="SelectableTextBlock.md-code-block">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,Monospace" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="NaN" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Border.md-quote">
        <Setter Property="BorderBrush" Value="{DynamicResource DockBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="Padding" Value="14,0,0,0" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.md-rule">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{DynamicResource DockBorderSubtleBrush}" />
        <Setter Property="Margin" Value="0,12,0,20" />
    </Style>
    <Style Selector="StackPanel.md-list">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="StackPanel.md-list StackPanel.md-list">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="StackPanel.md-list SelectableTextBlock.md-p">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.md-marker">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Margin" Value="6,0,4,0" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>
    <Style Selector="Image.md-image">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--  Tables  -->
    <Style Selector="Grid.md-table">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Border.md-cell">
        <Setter Property="BorderBrush" Value="{DynamicResource DockBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="Border.md-cell.md-header">
        <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPointerOver}" />
    </Style>
    <Style Selector="Border.md-cell.md-header SelectableTextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.md-cell SelectableTextBlock.md-p">
        <Setter Property="Margin" Value="0" />
    </Style>
</Styles>
