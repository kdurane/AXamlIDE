<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The ui_* MCP tools' host: runs a view of the user's app in a headless Avalonia window (no OS window, no real
        input) and answers the IDE over stdin/stdout. The IDE starts it with the app's own runtimeconfig and deps
        (dotnet exec, like the Avalonia previewer), so it runs on the app's Avalonia, whichever 11.x or 12.x that is.
        Hence net8.0 and a compile-only reference to the oldest Avalonia it supports: newer assemblies satisfy an older
        reference. Avalonia.Headless isn't referenced at all; it must match the app's version, so the IDE passes the
        right one in and Headless.cs calls it by reflection.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RollForward>Major</RollForward>
        <UseAppHost>false</UseAppHost>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.0.0" ExcludeAssets="runtime;build;buildTransitive;analyzers" PrivateAssets="all" />
    </ItemGroup>

</Project>
