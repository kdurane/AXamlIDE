<UserControl
    x:Class="AXamlIDE.Views.ExplorerView"
    x:DataType="vm:ExplorerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:views="using:AXamlIDE.Views"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ThemeBackgroundBrush}" RowDefinitions="Auto,*">
        <!--  VS Code's explorer header buttons: new item / new folder in the selected folder.  -->
        <StackPanel
            HorizontalAlignment="Right"
            Margin="6,2"
            Orientation="Horizontal"
            Spacing="2">
            <Button
                Classes="icon"
                Command="{Binding NewItemCommand}"
                ToolTip.Tip="New Item... (Ctrl+Shift+A)">
                <PathIcon Data="{DynamicResource Icon.FilePlus}" />
            </Button>
            <Button
                Classes="icon"
                Command="{Binding NewFolderCommand}"
                ToolTip.Tip="New Folder... (Shift+Alt+N)">
                <PathIcon Data="{DynamicResource Icon.FolderPlus}" />
            </Button>
        </StackPanel>
        <TreeView
            Foreground="{DynamicResource ThemeForegroundBrush}"
            Grid.Row="1"
            ItemsSource="{Binding Workspace.Roots}"
            Name="FileTree"
            SelectedItem="{Binding Workspace.SelectedNode, Mode=TwoWay}">
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="MinHeight" Value="20" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <!--  The startup project is bold, as in Visual Studio.  -->
                <Style Selector="TextBlock.startup">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="{x:Type models:ProjectTreeNode}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon
                            Data="{Binding Icon}"
                            Height="12"
                            Width="12" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{Binding GitState, Converter={x:Static views:GitStateConverters.Brush}}"
                            Text="{Binding Name}">
                            <Classes.startup>
                                <MultiBinding Converter="{x:Static views:PathConverters.Same}">
                                    <Binding Path="FullPath" />
                                    <Binding Path="$parent[TreeView].((vm:ExplorerViewModel)DataContext).Run.StartupProjectPath" />
                                </MultiBinding>
                            </Classes.startup>
                        </TextBlock>
                        <!--  Git state letter (M, U, A...); empty for unchanged files, folders show only the colour  -->
                        <TextBlock
                            FontSize="11"
                            Foreground="{Binding GitState, Converter={x:Static views:GitStateConverters.Brush}}"
                            IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:NodeKind.File}}"
                            Margin="4,0,0,0"
                            Text="{Binding GitState, Converter={x:Static views:GitStateConverters.Letter}}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
            <!--
                Right-click menu (the standard ContextMenu template lays it out and lines up the shortcuts).
                Its DataContext is an ExplorerNodeMenu for the clicked node, set when it opens (ExplorerView.axaml.cs).
            -->
            <TreeView.ContextMenu>
                <ContextMenu Opening="OnMenuOpening" x:DataType="vm:ExplorerNodeMenu">
                    <!--  Visual Studio's Add submenu.  -->
                    <MenuItem Header="Add" IsVisible="{Binding CanAdd}">
                        <MenuItem
                            Command="{Binding Explorer.NewItemCommand}"
                            CommandParameter="{Binding Node}"
                            Header="New Item..."
                            InputGesture="Ctrl+Shift+A" />
                        <MenuItem
                            Command="{Binding Explorer.NewFolderCommand}"
                            CommandParameter="{Binding Node}"
                            Header="New Folder..."
                            InputGesture="Shift+Alt+N" />
                        <Separator />
                        <MenuItem
                            Command="{Binding Explorer.NewClassCommand}"
                            CommandParameter="{Binding Node}"
                            Header="Class..."
                            InputGesture="Shift+Alt+C" />
                    </MenuItem>
                    <Separator IsVisible="{Binding CanAdd}" />
                    <MenuItem
                        Command="{Binding Explorer.OpenFileCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Open"
                        IsVisible="{Binding IsFile}" />
                    <Separator IsVisible="{Binding IsFile}" />

                    <MenuItem
                        Command="{Binding Explorer.CutCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Cut"
                        InputGesture="Ctrl+X"
                        IsVisible="{Binding CanChange}" />
                    <MenuItem
                        Command="{Binding Explorer.CopyCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Copy"
                        InputGesture="Ctrl+C"
                        IsVisible="{Binding CanChange}" />
                    <MenuItem
                        Command="{Binding Explorer.PasteCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Paste"
                        InputGesture="Ctrl+V" />
                    <MenuItem
                        Command="{Binding Explorer.DeleteCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Delete"
                        InputGesture="Delete"
                        IsVisible="{Binding CanChange}" />
                    <MenuItem
                        Command="{Binding Explorer.RenameCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Rename"
                        InputGesture="F2"
                        IsVisible="{Binding CanChange}" />
                    <Separator />

                    <MenuItem
                        Click="OnCopyPathClick"
                        Header="Copy Path"
                        IsVisible="{Binding HasPath}" />
                    <MenuItem
                        Command="{Binding Explorer.RefreshCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Refresh"
                        IsVisible="{Binding CanRefresh}" />

                    <Separator IsVisible="{Binding CanBuild}" />
                    <MenuItem
                        Command="{Binding Explorer.Run.SetStartupProjectCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Set as Startup Project"
                        IsVisible="{Binding IsProject}" />
                    <MenuItem
                        Command="{Binding Explorer.NuGet.ManagePackagesCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Manage NuGet Packages..."
                        IsVisible="{Binding IsProject}" />
                    <MenuItem
                        Command="{Binding Explorer.Run.BuildProjectCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Build"
                        InputGesture="Ctrl+Shift+B"
                        IsVisible="{Binding CanBuild}" />
                    <MenuItem
                        Command="{Binding Explorer.Run.RunProjectCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Run"
                        InputGesture="Ctrl+F5"
                        IsVisible="{Binding CanBuild}" />
                    <MenuItem
                        Command="{Binding Explorer.Run.StartDebuggingCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Start Debugging"
                        InputGesture="F5"
                        IsVisible="{Binding CanBuild}" />

                    <Separator IsVisible="{Binding ShowGit}" />
                    <MenuItem Header="Git" IsVisible="{Binding ShowGit}">
                        <MenuItem
                            Command="{Binding Explorer.Git.ShowDiffCommand}"
                            CommandParameter="{Binding GitPath}"
                            Header="Show Diff"
                            IsVisible="{Binding CanShowDiff}" />
                        <MenuItem
                            Command="{Binding Explorer.Git.StagePathCommand}"
                            CommandParameter="{Binding GitPath}"
                            Header="Add"
                            IsVisible="{Binding CanStage}" />
                        <MenuItem
                            Command="{Binding Explorer.Git.UnstagePathCommand}"
                            CommandParameter="{Binding GitPath}"
                            Header="Unstage"
                            IsVisible="{Binding CanUnstage}" />
                        <Separator IsVisible="{Binding ShowGitSeparator}" />
                        <MenuItem
                            Command="{Binding Explorer.Git.IgnoreCommand}"
                            CommandParameter="{Binding GitPath}"
                            Header="Add to .gitignore"
                            IsVisible="{Binding CanIgnore}" />
                        <MenuItem
                            Command="{Binding Explorer.Git.UnignoreCommand}"
                            CommandParameter="{Binding GitPath}"
                            Header="Remove from .gitignore"
                            IsVisible="{Binding CanUnignore}" />
                    </MenuItem>

                    <Separator />
                    <MenuItem
                        Command="{Binding Explorer.Properties.ShowCommand}"
                        Header="Properties"
                        InputGesture="F4" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.Resources>
                <x:Double x:Key="TreeViewItemIndent">10</x:Double>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
