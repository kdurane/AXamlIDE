<UserControl
    x:Class="AXamlIDE.Views.ExplorerView"
    x:DataType="vm:ExplorerViewModel"
    Design.DataContext="{x:Static design:DesignData.Explorer}"
    d:DesignWidth="320"
    d:DesignHeight="520"
    mc:Ignorable="d"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:AXamlIDE.SampleData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:shell="using:AXamlIDE.Shell"
    xmlns:stylefolder="using:AXamlIDE.Styles"
    xmlns:views="using:AXamlIDE.Views"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <stylefolder:IconKeyConverter x:Key="IconConverter"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ThemeBackgroundBrush}" RowDefinitions="Auto,*">
        <!--  Visual Studio's Solution Explorer toolbar: sync with the active document, refresh, collapse all, new item / folder.  -->
        <StackPanel
            HorizontalAlignment="Right"
            Margin="6,2"
            Orientation="Horizontal"
            Spacing="2">
            <Button
                Classes="icon"
                Command="{Binding SyncWithActiveDocumentCommand}"
                ToolTip.Tip="Sync with Active Document">
                <PathIcon Data="{DynamicResource Icon.SyncDocument}" />
            </Button>
            <Button
                Classes="icon"
                Command="{Binding RefreshCommand}"
                CommandParameter="{Binding Workspace.SelectedNode}"
                ToolTip.Tip="Refresh">
                <PathIcon Data="{DynamicResource Icon.Refresh}" />
            </Button>
            <Button
                Classes="icon"
                Command="{Binding CollapseAllCommand}"
                ToolTip.Tip="Collapse All">
                <PathIcon Data="{DynamicResource Icon.CollapseAll}" />
            </Button>
            <Button
                Classes="icon"
                Command="{Binding NewItemCommand}"
                shell:KeyMap.ShortcutTip="New Item...">
                <PathIcon Data="{DynamicResource Icon.FilePlus}" />
            </Button>
            <Button
                Classes="icon"
                Command="{Binding NewFolderCommand}"
                shell:KeyMap.ShortcutTip="New Folder...">
                <PathIcon Data="{DynamicResource Icon.FolderPlus}" />
            </Button>
        </StackPanel>
        <TreeView
            Foreground="{DynamicResource ThemeForegroundBrush}"
            Grid.Row="1"
            ItemsSource="{Binding Workspace.Roots}"
            Name="FileTree"
            SelectedItem="{Binding Workspace.SelectedNode, Mode=TwoWay}">
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="MinHeight" Value="20" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <!--  The startup project is bold  -->
                <Style Selector="TextBlock.startup">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
                <Style Selector="TreeViewItem.dropTarget /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />
                </Style>

            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="{x:Type models:ProjectTreeNode}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon
                            Data="{Binding Icon,Converter={StaticResource IconConverter}}"
                            Height="12"
                            Width="12" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{Binding GitState, Converter={x:Static views:GitStateConverters.Brush}}"
                            Text="{Binding Name}">
                            <Classes.startup>
                                <MultiBinding Converter="{x:Static views:PathConverters.Same}">
                                    <Binding Path="FullPath" />
                                    <Binding Path="$parent[TreeView].((vm:ExplorerViewModel)DataContext).Run.StartupProjectPath" />
                                </MultiBinding>
                            </Classes.startup>
                        </TextBlock>
                        <!--  Git state letter (M, U, A...); empty for unchanged files, folders show only the colour  -->
                        <TextBlock
                            FontSize="11"
                            Foreground="{Binding GitState, Converter={x:Static views:GitStateConverters.Brush}}"
                            IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:NodeKind.File}}"
                            Margin="4,0,0,0"
                            Text="{Binding GitState, Converter={x:Static views:GitStateConverters.Letter}}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
            <!--
            Right-click menu (the standard ContextMenu template lays it out and lines up the shortcuts).
            Its DataContext is an ExplorerNodeMenu for the clicked node, set when it opens (ExplorerView.axaml.cs).
            -->
            <TreeView.ContextMenu>
                <ContextMenu Opening="OnMenuOpening" x:DataType="vm:ExplorerNodeMenu" MinWidth="260">
                    <!--  Visual Studio's Add submenu.  -->
                    <MenuItem Header="Add" IsVisible="{Binding CanAdd}">
                        <MenuItem
                            Command="{Binding Explorer.NewItemCommand}"
                            CommandParameter="{Binding Node}"
                            Header="New Item..."
                            shell:KeyMap.CommandId="File.NewItem" />
                        <MenuItem
                            Command="{Binding Explorer.NewFolderCommand}"
                            CommandParameter="{Binding Node}"
                            Header="New Folder..."
                            shell:KeyMap.CommandId="File.NewFolder" />
                        <Separator />
                        <MenuItem
                            Command="{Binding Explorer.NewClassCommand}"
                            CommandParameter="{Binding Node}"
                            Header="Class..."
                            shell:KeyMap.CommandId="File.NewClass" />
                    </MenuItem>
                    <Separator IsVisible="{Binding CanAdd}" />
                    <MenuItem
                        Command="{Binding Explorer.OpenFileCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Open"
                        IsVisible="{Binding IsFile}" />
                    <Separator IsVisible="{Binding IsFile}" />
                    
                    <MenuItem
                    Command="{Binding Explorer.OpenProjectFileCommand}"
    CommandParameter="{Binding Node}"
    Header="Open Project File"
    IsVisible="{Binding IsProjectNode}" />
<Separator IsVisible="{Binding IsProjectNode}" />


                    <MenuItem
                        Command="{Binding Explorer.CutCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Cut"
                        InputGesture="Ctrl+X"
                        IsVisible="{Binding CanChange}" />
                    <MenuItem
                        Command="{Binding Explorer.CopyCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Copy"
                        InputGesture="Ctrl+C"
                        IsVisible="{Binding CanChange}" />
                    <MenuItem
                        Command="{Binding Explorer.PasteCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Paste"
                        InputGesture="Ctrl+V" />
                    <MenuItem
                        Command="{Binding Explorer.DeleteCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Delete"
                        InputGesture="Delete"
                        IsVisible="{Binding CanChange}" />
                    <MenuItem
                        Command="{Binding Explorer.RenameCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Rename"
                        InputGesture="F2"
                        IsVisible="{Binding CanChange}" />
                    <Separator />

                    <MenuItem
                        Click="OnCopyPathClick"
                        Header="Copy Full Path"
                        IsVisible="{Binding HasPath}" />
                    <MenuItem
                        Command="{Binding Explorer.OpenContainingFolderCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Open Containing Folder"
                        IsVisible="{Binding CanOpenFolder}" />
                    <MenuItem
                        Command="{Binding Explorer.OpenInTerminalCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Open in Terminal"
                        IsVisible="{Binding CanOpenFolder}" />
                    <MenuItem
                        Command="{Binding Explorer.RefreshCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Refresh"
                        IsVisible="{Binding CanRefresh}" />

                    <Separator IsVisible="{Binding CanBuild}" />
                    <MenuItem
                        Command="{Binding Explorer.Run.SetStartupProjectCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Set as Startup Project"
                        IsVisible="{Binding IsProject}" />
                    <MenuItem
                        Command="{Binding Explorer.NuGet.ManagePackagesCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Manage NuGet Packages..."
                        IsVisible="{Binding IsProject}" />
                    <MenuItem
                        Command="{Binding Explorer.Publish.PublishProjectCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Publish..."
                        IsVisible="{Binding IsProject}"
                        shell:KeyMap.CommandId="Build.Publish" />
                    <MenuItem
                        Command="{Binding Explorer.Run.BuildProjectCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Build"
                        IsVisible="{Binding CanBuild}" />
                    <MenuItem
                        Command="{Binding Explorer.Run.RebuildProjectCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Rebuild"
                        IsVisible="{Binding CanBuild}" />
                    <MenuItem
                        Command="{Binding Explorer.Run.CleanProjectCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Clean"
                        IsVisible="{Binding CanBuild}" />
                    <MenuItem
                        Command="{Binding Explorer.Run.RunProjectCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Run"
                        IsVisible="{Binding CanBuild}"
                        shell:KeyMap.CommandId="Debug.StartWithoutDebugging" />
                    <MenuItem
                        Command="{Binding Explorer.Run.StartDebuggingCommand}"
                        CommandParameter="{Binding Node}"
                        Header="Start Debugging"
                        IsVisible="{Binding CanBuild}"
                        shell:KeyMap.CommandId="Debug.StartOrContinue" />

                    <Separator IsVisible="{Binding ShowGit}" />
                    <MenuItem Header="Git" IsVisible="{Binding ShowGit}">
                        <MenuItem
                            Command="{Binding Explorer.Git.ShowDiffCommand}"
                            CommandParameter="{Binding GitPath}"
                            Header="Show Diff"
                            IsVisible="{Binding CanShowDiff}" />
                        <MenuItem
                            Command="{Binding Explorer.Git.StagePathCommand}"
                            CommandParameter="{Binding GitPath}"
                            Header="Add"
                            IsVisible="{Binding CanStage}" />
                        <MenuItem
                            Command="{Binding Explorer.Git.UnstagePathCommand}"
                            CommandParameter="{Binding GitPath}"
                            Header="Unstage"
                            IsVisible="{Binding CanUnstage}" />
                        <Separator IsVisible="{Binding ShowGitSeparator}" />
                        <MenuItem
                            Command="{Binding Explorer.Git.IgnoreCommand}"
                            CommandParameter="{Binding GitPath}"
                            Header="Add to .gitignore"
                            IsVisible="{Binding CanIgnore}" />
                        <MenuItem
                            Command="{Binding Explorer.Git.UnignoreCommand}"
                            CommandParameter="{Binding GitPath}"
                            Header="Remove from .gitignore"
                            IsVisible="{Binding CanUnignore}" />
                    </MenuItem>

                    <Separator />
                    <MenuItem
                        Command="{Binding Explorer.Properties.ShowCommand}"
                        Header="Properties"
                        shell:KeyMap.CommandId="View.Properties" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.Resources>
                <x:Double x:Key="TreeViewItemIndent">10</x:Double>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
