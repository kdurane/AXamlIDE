<!--
    Add New Item (DataContext: ViewModels/AddNewItemViewModel), laid out like Visual Studio's: categories on the left,
    templates in the middle with a search box above, the chosen template's description on the right, the name below.
-->
<Window
    Background="{DynamicResource ThemeBackgroundBrush}"
    Height="480"
    MinHeight="360"
    MinWidth="620"
    Title="Add New Item"
    Width="780"
    WindowStartupLocation="CenterOwner"
    x:Class="AXamlIDE.Views.AddNewItemWindow"
    x:DataType="vm:AddNewItemViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.KeyBindings>
        <KeyBinding Command="{Binding $parent[Window].Close}" Gesture="Escape" />
    </Window.KeyBindings>

    <Grid
        ColumnDefinitions="150,*,230"
        Margin="12"
        RowDefinitions="Auto,*,Auto,Auto">
        <!--  Search over the templates, above the middle and right columns.  -->
        <TextBox
            Classes="SearchBox"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="8,0,0,8"
            PlaceholderText="Search templates"
            Text="{Binding Search}" />

        <ListBox
            Grid.Row="0"
            Grid.RowSpan="2"
            ItemsSource="{Binding Categories}"
            SelectedItem="{Binding SelectedCategory}" />

        <ListBox
            DoubleTapped="OnTemplateDoubleTapped"
            Grid.Column="1"
            Grid.Row="1"
            ItemsSource="{Binding Templates}"
            Margin="8,0"
            Name="TemplateList"
            SelectedItem="{Binding SelectedTemplate}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemTemplateChoice">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon
                            Data="{Binding Icon}"
                            Height="16"
                            Margin="0,0,10,0"
                            Width="16" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Name}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="2"
                            Opacity="0.6"
                            Text="{Binding Category}"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel
            Grid.Column="2"
            Grid.Row="1"
            Margin="8,4,0,0"
            Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedTemplate.Name, FallbackValue=''}" />
            <TextBlock Opacity="0.75">
                <Run Text="Type:" />
                <Run Text="{Binding SelectedTemplate.Category, FallbackValue='', Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding SelectedTemplate.Description, FallbackValue=''}" TextWrapping="Wrap" />
            <TextBlock
                Opacity="0.75"
                Text="{Binding Namespace, StringFormat='Namespace: {0}', Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Name and location, as at the bottom of VS's dialog.  -->
        <Grid
            ColumnDefinitions="Auto,*"
            Grid.ColumnSpan="3"
            Grid.Row="2"
            Margin="0,12,0,0"
            RowDefinitions="Auto,Auto,Auto">
            <TextBlock
                Margin="0,0,12,0"
                Text="Name:"
                VerticalAlignment="Center" />
            <TextBox
                Grid.Column="1"
                KeyDown="OnNameKeyDown"
                Name="NameBox"
                Text="{Binding ItemName}" />
            <TextBlock
                Grid.Row="1"
                Margin="0,6,12,0"
                Text="Location:" />
            <TextBlock
                Grid.Column="1"
                Grid.Row="1"
                Margin="0,6,0,0"
                Opacity="0.75"
                Text="{Binding Location}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Foreground="{DynamicResource DiagnosticWarningBrush}"
                Grid.Column="1"
                Grid.Row="2"
                Margin="0,6,0,0"
                Text="{Binding Error}"
                TextWrapping="Wrap" />
        </Grid>

        <StackPanel
            Grid.ColumnSpan="3"
            Grid.Row="3"
            HorizontalAlignment="Right"
            Margin="0,12,0,0"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Classes="accent"
                Click="OnAddClick"
                Content="Add"
                IsDefault="True"
                IsEnabled="{Binding CanAdd}"
                MinWidth="80" />
            <Button
                Click="OnCancelClick"
                Content="Cancel"
                IsCancel="True"
                MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
