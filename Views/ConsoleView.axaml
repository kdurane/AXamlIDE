<UserControl
    x:Class="AXamlIDE.Views.ConsoleView"
    x:DataType="vm:RunViewModel"
    Design.DataContext="{x:Static design:DesignData.Run}"
    d:DesignWidth="800"
    d:DesignHeight="200"
    mc:Ignorable="d"
    xmlns="https://github.com/avaloniaui"
    xmlns:b="using:AXamlIDE.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:AXamlIDE.SampleData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Program / debuggee output (DataContext: RunViewModel)  -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding ConsoleOutput}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <SelectableTextBlock
                        FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                        FontSize="11"
                        Text="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Interaction.Behaviors>
            <b:FollowEndBehavior/>
        </Interaction.Behaviors>
    </ScrollViewer>
</UserControl>
