<!--
    The Problems panel, like Visual Studio's Error List (DataContext: ProblemsViewModel): a toolbar with the scope box, filter
    buttons with counts and a search box, a note when Entire Solution can only list the open files, then the rows. Double-click or Enter opens the problem in the editor; the
    right-click menu (and its keys) copy the description or the whole row, or search the web for it, as in Visual Studio.
-->
<UserControl
    x:Class="AXamlIDE.Views.ProblemsView"
    x:DataType="vm:ProblemsViewModel"
    Design.DataContext="{x:Static design:DesignData.Problems}"
    d:DesignWidth="900"
    d:DesignHeight="260"
    mc:Ignorable="d"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:AXamlIDE.SampleData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="ToggleButton.filter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ToggleButton.filter:not(:checked)">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="ToggleButton.filter PathIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.note > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.note > Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,Auto,Auto,*">

        <!--  Toolbar: the scope, the three kinds (click one to hide it), and the search box.  -->
        <DockPanel Margin="4,2" Grid.Row="0">
            <ComboBox
                AutomationProperties.Name="Problems scope"
                DockPanel.Dock="Left"
                FontSize="12"
                ItemsSource="{Binding Scopes}"
                Margin="0,0,6,0"
                MinHeight="0"
                MinWidth="140"
                Padding="6,2"
                SelectedItem="{Binding Scope}"
                ToolTip.Tip="Which problems to list: the whole solution, the open documents, the active document's project, or the active document"
                VerticalAlignment="Center" />
            <TextBox
                Classes="SearchBox"
                DockPanel.Dock="Right"
                FontSize="11"
                MinHeight="0"
                PlaceholderText="Filter"
                Text="{Binding Filter}"
                Width="200" />
            <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton
                    Classes="filter"
                    IsChecked="{Binding ShowErrors}"
                    ToolTip.Tip="Show or hide errors">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{StaticResource Icon.CloseCircleOutline}" Foreground="{DynamicResource DiagnosticErrorBrush}" />
                        <TextBlock Text="{Binding ErrorsLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Classes="filter"
                    IsChecked="{Binding ShowWarnings}"
                    ToolTip.Tip="Show or hide warnings">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{StaticResource Icon.AlertOutline}" Foreground="{DynamicResource DiagnosticWarningBrush}" />
                        <TextBlock Text="{Binding WarningsLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Classes="filter"
                    IsChecked="{Binding ShowInfos}"
                    ToolTip.Tip="Show or hide messages">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{StaticResource Icon.InformationOutline}" />
                        <TextBlock Text="{Binding InfosLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </DockPanel>

        <!--  Entire Solution with nothing looking at the closed files: say so, and offer the two ways to look.  -->
        <StackPanel
            Classes="note"
            Grid.Row="1"
            IsVisible="{Binding ListsOnlyOpenFiles}"
            Margin="8,0,8,4"
            Orientation="Horizontal"
            Spacing="6">
            <PathIcon
                Data="{StaticResource Icon.InformationOutline}"
                Height="13"
                Width="13" />
            <TextBlock Opacity="0.8" Text="Only open files and the last build are listed." />
            <Button
                Classes="link"
                Command="{Binding TurnOnSolutionAnalysisCommand}"
                Content="Turn on solution-wide analysis"
                ToolTip.Tip="Check every file for compiler errors as you type (the status bar's analysis button)" />
            <TextBlock Opacity="0.8" Text="or" />
            <Button
                Classes="link"
                Command="{Binding RunCodeAnalysisCommand}"
                Content="run code analysis once"
                ToolTip.Tip="Analyze &gt; Run Code Analysis on Solution: every analyzer over every file" />
        </StackPanel>

        <!--  Header row (the columns share their widths with the rows).  -->
        <Grid
            ColumnDefinitions="22,Auto,*,Auto,Auto,Auto,Auto"
            Grid.Row="2"
            Margin="6,2">
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="CodeCol" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="heading" Text="Code" />
            </Grid>
            <TextBlock Classes="heading" Grid.Column="2" Text="Description" />
            <Grid Grid.Column="3" Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="ProjectCol" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="heading" Text="Project" />
            </Grid>
            <Grid Grid.Column="4" Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="FileCol" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="heading" Text="File" />
            </Grid>
            <Grid Grid.Column="5" Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="LineCol" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="heading" Text="Line" />
            </Grid>
            <Grid Grid.Column="6" Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="SourceCol" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="heading" Text="Source" />
            </Grid>
        </Grid>

        <ListBox
            Classes="compact"
            Background="Transparent"
            DoubleTapped="OnProblemDoubleTapped"
            Grid.Row="3"
            ItemsSource="{Binding Problems}"
            KeyDown="OnListKeyDown"
            Name="List"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.KeyBindings>
                <KeyBinding Command="{Binding CopyProblemCommand}" CommandParameter="{Binding #List.SelectedItem}" Gesture="Ctrl+C" />
                <KeyBinding Command="{Binding CopyProblemRowCommand}" CommandParameter="{Binding #List.SelectedItem}" Gesture="Ctrl+Shift+C" />
                <KeyBinding Command="{Binding SearchWebForProblemCommand}" CommandParameter="{Binding #List.SelectedItem}" Gesture="Ctrl+F1" />
            </ListBox.KeyBindings>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding OpenProblemCommand}"
                        CommandParameter="{Binding #List.SelectedItem}"
                        Header="_Go To Location"
                        InputGesture="Enter" />
                    <Separator />
                    <MenuItem
                        Command="{Binding CopyProblemCommand}"
                        CommandParameter="{Binding #List.SelectedItem}"
                        Header="_Copy"
                        InputGesture="Ctrl+C" />
                    <MenuItem
                        Command="{Binding CopyProblemRowCommand}"
                        CommandParameter="{Binding #List.SelectedItem}"
                        Header="Copy _Row"
                        InputGesture="Ctrl+Shift+C" />
                    <Separator />
                    <MenuItem
                        Command="{Binding SearchWebForProblemCommand}"
                        CommandParameter="{Binding #List.SelectedItem}"
                        Header="_Search the Web for Help"
                        InputGesture="Ctrl+F1" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ProblemItem">
                    <Grid ColumnDefinitions="22,Auto,*,Auto,Auto,Auto,Auto">
                        <Panel Grid.Column="0" VerticalAlignment="Center">
                            <PathIcon
                                Data="{StaticResource Icon.CloseCircleOutline}"
                                Foreground="{DynamicResource DiagnosticErrorBrush}"
                                Height="13"
                                IsVisible="{Binding IsError}"
                                Width="13" />
                            <PathIcon
                                Data="{StaticResource Icon.AlertOutline}"
                                Foreground="{DynamicResource DiagnosticWarningBrush}"
                                Height="13"
                                IsVisible="{Binding IsWarning}"
                                Width="13" />
                            <PathIcon
                                Data="{StaticResource Icon.InformationOutline}"
                                Height="13"
                                IsVisible="{Binding IsInfo}"
                                Width="13" />
                        </Panel>
                        <Grid Grid.Column="1" Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="CodeCol" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="cell" Opacity="0.8" Text="{Binding Code}" />
                        </Grid>
                        <TextBlock
                            Classes="cell"
                            Grid.Column="2"
                            Text="{Binding Message}"
                            TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Column="3" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="ProjectCol" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="cell" Text="{Binding ProjectName}" />
                        </Grid>
                        <Grid Grid.Column="4" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="FileCol" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="cell" Text="{Binding FileName}" />
                        </Grid>
                        <Grid Grid.Column="5" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="LineCol" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="cell" Text="{Binding LineText}" />
                        </Grid>
                        <Grid Grid.Column="6" Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="SourceCol" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="cell" Opacity="0.7" Text="{Binding Source}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
