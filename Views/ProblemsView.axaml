<UserControl
    x:Class="AXamlIDE.Views.ProblemsView"
    x:DataType="vm:ProblemsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,*">

        <!--  Header row  -->
        <Grid
            ColumnDefinitions="76,*,Auto,Auto"
            Grid.Row="0"
            Margin="6,0">
            <TextBlock
                FontWeight="SemiBold"
                Grid.Column="0"
                Text="Severity" />
            <TextBlock
                FontWeight="SemiBold"
                Grid.Column="1"
                Text="Message" />
            <Grid Grid.Column="2" Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="LineCol" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="Line" />
            </Grid>
            <Grid Grid.Column="3" Margin="6,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="FileCol" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="File" />
            </Grid>
        </Grid>

        <ListBox
            Background="#02ffffff"
            DoubleTapped="OnProblemDoubleTapped"
            Grid.Row="1"
            ItemsSource="{Binding Problems}"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ProblemItem">
                    <Grid ColumnDefinitions="76,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding SeverityText}" />
                        <SelectableTextBlock
                            Grid.Column="1"
                            Text="{Binding Message}"
                            TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Column="2" Margin="12,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="LineCol" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Line}" />
                        </Grid>
                        <Grid Grid.Column="3" Margin="6,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="FileCol" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Document.Title}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,3" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>
