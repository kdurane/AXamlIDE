<UserControl
    x:Class="AXamlIDE.Views.DocumentWellView"
    x:DataType="viewmodels:DocumentWellViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:editor="using:AXamlIDE.Views"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:viewmodels="clr-namespace:AXamlIDE.ViewModels"
    xmlns:views="clr-namespace:AXamlIDE.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Tabs + outline on top; one editor (it swaps documents on tab change) and the preview below.  -->
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Grid.Row="0">
            <TabStrip
                Grid.Column="0"
                ItemsSource="{Binding Documents}"
                Padding="0"
                SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                <TabStrip.ItemTemplate>
                    <DataTemplate x:DataType="models:OpenDocument">
                        <DockPanel PointerReleased="OnTabPointerReleased">
                            <TextBlock
                                FontSize="11"
                                Text="{Binding DisplayTitle}"
                                VerticalAlignment="Center" />
                            <Button
                                Background="Transparent"
                                Click="OnTabCloseClick"
                                Content="&#x2715;"
                                FontSize="9"
                                Margin="0"
                                MinHeight="0"
                                Padding="3,0"
                                Tag="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>
            <ComboBox
                DisplayMemberBinding="{Binding DisplayName}"
                Foreground="{DynamicResource ThemeForegroundBrush}"
                Grid.Column="1"
                IsTextSearchEnabled="True"
                IsVisible="{Binding Outline.IsVisible}"
                ItemsSource="{Binding Outline.Items}"
                Margin="4,4,4,0"
                MaxWidth="260"
                MinHeight="0"
                MinWidth="180"
                Padding="4"
                SelectedItem="{Binding Outline.SelectedItem, Mode=TwoWay}"
                ToolTip.Tip="Navigate to a C# type or member" />
        </Grid>

        <Grid Grid.Row="1" Name="DocumentSurface">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="160" Width="*" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
            <editor:EditorPaneView Grid.Column="0" Name="EditorPane" />
            <GridSplitter
                Background="#FF555555"
                Grid.Column="1"
                IsVisible="False"
                Name="PreviewSplitter"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                ShowsPreview="False" />
            <views:PreviewPaneView
                DataContext="{Binding Preview}"
                Grid.Column="2"
                IsVisible="False"
                Name="PreviewPane" />
        </Grid>
    </Grid>
</UserControl>
