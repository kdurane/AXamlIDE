<!--
    Search Everywhere (Rider's, double Shift): a window over the IDE. Drag it by its top row, resize it from the
    corner; it stays where it was put. Up/Down, Enter, Tab and Escape are handled in the code-behind, so the keyboard
    stays in the box.
-->
<Window
    x:Class="AXamlIDE.Views.SearchEverywhereWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:stylefolder="using:AXamlIDE.Styles"
    xmlns:vm="using:AXamlIDE.ViewModels"
    Title="Search Everywhere"
    Width="720"
    Height="480"
    MinWidth="420"
    MinHeight="240"
    x:DataType="vm:SearchEverywhereViewModel"
    Background="{DynamicResource HoverBackgroundBrush}"
    CanResize="True"
    ShowInTaskbar="False"
    WindowDecorations="BorderOnly">

    <Window.Resources>
        <stylefolder:IconKeyConverter x:Key="IconConverter" />
    </Window.Resources>

    <Border
        BorderBrush="{DynamicResource HoverBorderBrush}"
        BorderThickness="1"
        TextElement.Foreground="{DynamicResource HoverForegroundBrush}">

        <DockPanel>
            <!--  The tabs, and the empty rest of the row is the handle to drag the window by.  -->
            <DockPanel
                Margin="4,4,4,0"
                Background="Transparent"
                DockPanel.Dock="Top"
                WindowDecorationProperties.ElementRole="User">
                <ListBox
                    Classes="tabs"
                    Focusable="False"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}" />
            </DockPanel>
            <TextBox
                Name="Box"
                Margin="8,6"
                Classes="SearchBox"
                DockPanel.Dock="Top"
                PlaceholderText="Types, files, symbols, actions and options"
                Text="{Binding Query, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,Auto" DockPanel.Dock="Bottom">
                <TextBlock
                    Margin="10,4"
                    FontSize="11"
                    Opacity="0.6"
                    Text="Enter to open  ·  Tab for the next tab  ·  Esc to close  ·  drag the top row to move" />
                <!--  Resize grip  -->
                <Border
                    Grid.Column="1"
                    Width="14"
                    Height="14"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="BottomRightCorner"
                    WindowDecorationProperties.ElementRole="ResizeSE">
                    <Path
                        Data="M 12,2 L 2,12 M 12,6 L 6,12 M 12,10 L 10,12"
                        Opacity="0.5"
                        Stroke="{DynamicResource HoverForegroundBrush}"
                        StrokeThickness="1" />
                </Border>
            </Grid>
            <Panel Margin="4,0">
                <TextBlock
                    Margin="8,12"
                    IsVisible="{Binding HasNoResults}"
                    Opacity="0.7"
                    Text="Nothing found. Tab moves to the next tab; Text searches inside files." />
                <ListBox
                    Name="ResultList"
                    Classes="compact"
                    Focusable="False"
                    ItemsSource="{Binding Results}"
                    SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:SearchEverywhereItem">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,6,0,2"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    IsVisible="{Binding ShowsSection}"
                                    Opacity="0.6"
                                    Text="{Binding Section}" />
                                <DockPanel Margin="0,1">
                                    <PathIcon
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        Data="{Binding Icon, Converter={StaticResource IconConverter}}"
                                        DockPanel.Dock="Left" />
                                    <!--  An option's switch changes it here (Rider); Enter on the row opens Settings at it.  -->
                                    <ToggleSwitch
                                        MinWidth="0"
                                        Margin="12,-6,0,-6"
                                        DockPanel.Dock="Right"
                                        Focusable="False"
                                        IsChecked="{Binding IsOn, Mode=TwoWay}"
                                        IsVisible="{Binding IsOption}"
                                        OffContent=""
                                        OnContent=""
                                        ToolTip.Tip="On or off, here and now" />
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        DockPanel.Dock="Right"
                                        Opacity="0.7"
                                        Text="{Binding Shortcut}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock
                                            Opacity="0.6"
                                            Text="{Binding Detail}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </DockPanel>
    </Border>
</Window>
