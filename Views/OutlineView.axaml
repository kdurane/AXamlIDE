<UserControl
    x:Class="AXamlIDE.Views.OutlineView"
    IsVisible="{Binding IsVisible}"
    x:DataType="vm:OutlineViewModel"
    Design.DataContext="{x:Static design:DesignData.Outline}"
    d:DesignWidth="300"
    d:DesignHeight="28"
    mc:Ignorable="d"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:AXamlIDE.SampleData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Types and members of the selected tab. One instance, moved into the selected tab's bar by DockViewCache.  -->
    <ComboBox
        Name="Combo"
        IsTextSearchEnabled="True"
        ItemsSource="{Binding Items}"
        MaxWidth="360"
        MinHeight="0"
        MinWidth="220"
        Padding="6,1"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
        ToolTip.Tip="Navigate to a C# type or member">
        <ComboBox.ItemTemplate>
            <DataTemplate >
                <TextBlock Text="{Binding DisplayName}"
                           MaxWidth="400"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding DisplayName}" />
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
