<UserControl
    x:Class="AXamlIDE.Views.PreviewPaneView"
    x:DataType="vm:PreviewPaneViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:views="using:AXamlIDE.Views"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:stylefolder="using:AXamlIDE.Styles"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Toolbar (zoom, theme) over the frame from the designer host; a message box while there is no frame.  -->
    <Grid RowDefinitions="Auto,*">
        <Border
            Background="{DynamicResource AppDocumentBarBackgroundBrush}"
            Grid.Row="0"
            Padding="8,4">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    Foreground="{DynamicResource ThemeForegroundBrush}"
                    Text="Zoom"
                    VerticalAlignment="Center" />
                <ComboBox
                    BorderThickness="0"
                    IsEditable="True"
                    MinHeight="0"
                    MinWidth="110"
                    Name="PreviewZoomComboBox"
                    SelectedIndex="4"
                    ToolTip.Tip="Pick a zoom, type one, or Ctrl+wheel over the preview">
                    <ComboBoxItem Content="800%" />
                    <ComboBoxItem Content="400%" />
                    <ComboBoxItem Content="200%" />
                    <ComboBoxItem Content="150%" />
                    <ComboBoxItem Content="100%" />
                    <ComboBoxItem Content="75%" />
                    <ComboBoxItem Content="50%" />
                    <ComboBoxItem Content="25%" />
                    <ComboBoxItem Content="12.5%" />
                    <ComboBoxItem Content="Fit to Width" />
                    <ComboBoxItem Content="Fit All" />
                </ComboBox>
                <TextBlock
                    Foreground="{DynamicResource ThemeForegroundBrush}"
                    Text="Theme"
                    VerticalAlignment="Center" />
                <ComboBox
                    BorderThickness="0"
                    MinHeight="0"
                    MinWidth="80"
                    VerticalContentAlignment="Center"
                    Name="PreviewThemeComboBox"
                    SelectedIndex="0">
                    <ComboBoxItem Content="No theme"/>
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Name="PreviewViewport">
            <views:PreviewGridLines IsHitTestVisible="False" />
            <ScrollViewer
                HorizontalContentAlignment="Center"
                HorizontalScrollBarVisibility="Auto"
                Name="PreviewScrollViewer"
                VerticalContentAlignment="Center"
                VerticalScrollBarVisibility="Auto">
                <views:SkImageControl
                    HorizontalAlignment="Center"
                    Name="PreviewImage"
                    Stretch="Fill"
                    VerticalAlignment="Center" />
            </ScrollViewer>
            <Border
                Background="{DynamicResource ThemeBackgroundBrush}"
                HorizontalAlignment="Center"
                IsVisible="{Binding IsMessageVisible}"
                MaxWidth="500"
                Padding="12"
                VerticalAlignment="Center">
                <TextBlock
                    Foreground="{DynamicResource ThemeForegroundBrush}"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
