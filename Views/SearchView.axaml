<UserControl
    x:Class="AXamlIDE.Views.SearchView"
    x:DataType="vm:SearchViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="8">
            <TextBox
                Grid.Column="0"
                KeyDown="OnQueryKeyDown"
                Name="QueryBox"
                PlaceholderText="Search workspace text..."
                Text="{Binding SearchQuery, Mode=TwoWay}" />
            <Button
                Command="{Binding SearchWorkspaceCommand}"
                Content="Search"
                Grid.Column="1"
                Margin="8,0,0,0"
                MinWidth="76" />
        </Grid>
        <Grid
            ColumnDefinitions="*,Auto"
            Grid.Row="1"
            Margin="8,0,8,8">
            <TextBox
                Grid.Column="0"
                KeyDown="OnReplaceKeyDown"
                PlaceholderText="Replace with..."
                Text="{Binding ReplaceText, Mode=TwoWay}" />
            <Button
                Command="{Binding ReplaceWorkspaceCommand}"
                Content="Replace All..."
                Grid.Column="1"
                Margin="8,0,0,0"
                MinWidth="100" />
        </Grid>
        <TextBlock
            Grid.Row="2"
            Margin="8,0,8,6"
            Text="{Binding SearchStatus}" />
        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkspaceSearchResult">
                        <Button
                            Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).OpenResultCommand}"
                            CommandParameter="{Binding}"
                            HorizontalContentAlignment="Stretch"
                            Padding="6,3">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Text="{Binding FilePath}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding LineText}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Text="{Binding LineNumber}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
