<UserControl
    x:Class="AXamlIDE.Views.DebugStatusView"
    x:DataType="viewmodels:RunViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:viewmodels="clr-namespace:AXamlIDE.ViewModels"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  The original Debug tab (superseded by the floating toolbar; see REFACTOR_PLAN "New features")  -->
    <StackPanel Margin="10" Spacing="8">
        <TextBlock Text="{Binding DebugStatus}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Command="{Binding ContinueDebuggingCommand}" Content="Continue" />
            <Button
                Command="{Binding StopRunningProjectCommand}"
                Content="Stop"
                IsEnabled="{Binding IsDebugging}" />
        </StackPanel>
        <TextBlock
            FontSize="11"
            Text="Set breakpoints by clicking the editor gutter, then choose Start Debugging."
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
