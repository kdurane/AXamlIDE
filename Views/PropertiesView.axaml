<UserControl
    x:Class="AXamlIDE.Views.PropertiesView"
    x:DataType="vm:PropertiesViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.name">
            <Setter Property="Margin" Value="10,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBox.value, ComboBox.value">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="0,1,4,1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <!--  Visual Studio's layout: the item and its kind, then categories of name / value rows.  -->
    <Grid Background="{DynamicResource ThemeBackgroundBrush}" RowDefinitions="Auto,*">
        <TextBlock
            FontWeight="SemiBold"
            Margin="8,4"
            Text="{Binding Heading}"
            TextTrimming="CharacterEllipsis" />

        <ScrollViewer Grid.IsSharedSizeScope="True" Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PropertyGroup">
                        <StackPanel>
                            <TextBlock
                                Margin="6,6,0,2"
                                Opacity="0.7"
                                Text="{Binding Name}" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PropertyRow">
                                        <Grid MinHeight="22" ToolTip.Tip="{Binding Description}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition MinWidth="90" SharedSizeGroup="PropertyName" Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Classes="name" Text="{Binding Name}" />
                                            <SelectableTextBlock
                                                Grid.Column="1"
                                                IsVisible="{Binding IsReadOnly}"
                                                Opacity="0.8"
                                                Text="{Binding Value}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <TextBox
                                                Classes="value"
                                                Grid.Column="1"
                                                IsVisible="{Binding IsText}"
                                                Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                            <ComboBox
                                                Classes="value"
                                                Grid.Column="1"
                                                IsVisible="{Binding IsChoice}"
                                                ItemsSource="{Binding Choices}"
                                                SelectedItem="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock
            Grid.Row="1"
            IsVisible="{Binding !Groups.Count}"
            Margin="10"
            Opacity="0.7"
            Text="Select a file, folder or project in the explorer." />
    </Grid>
</UserControl>
