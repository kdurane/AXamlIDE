<!--  The Locals window: the selected frame's variables (LocalsViewModel), in the shared value view.  -->
<UserControl
    x:Class="AXamlIDE.Views.LocalsView"
    x:DataType="vm:LocalsViewModel"
    Design.DataContext="{x:Static design:DesignData.Locals}"
    d:DesignWidth="700"
    d:DesignHeight="260"
    mc:Ignorable="d"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:AXamlIDE.SampleData"
    xmlns:local="using:AXamlIDE.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Panel>
        <local:DebugValueTreeView DataContext="{Binding Tree}" />
        <TextBlock
            HorizontalAlignment="Center"
            IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"
            Margin="12,36,12,0"
            Opacity="0.7"
            Text="{Binding Message}"
            TextWrapping="Wrap"
            VerticalAlignment="Top" />
    </Panel>
</UserControl>
