<UserControl
    x:Class="AXamlIDE.Views.DiffView"
    x:DataType="vm:DiffDockable"
    Design.DataContext="{x:Static design:DesignData.Diff}"
    d:DesignWidth="900"
    d:DesignHeight="360"
    mc:Ignorable="d"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:AXamlIDE.SampleData"
    xmlns:diff="using:AXamlIDE.Editor.Diff"
    xmlns:edit="using:AvaloniaEdit"
    xmlns:editor="using:AXamlIDE.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="edit|TextEditor">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="ShowLineNumbers" Value="False" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <!--  Hidden, not Disabled (that stops scrolling): the ruler on the right is the scrollbar for both.  -->
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!--  Summary, previous/next change, open the file  -->
        <StackPanel
            Background="{DynamicResource AppDocumentBarBackgroundBrush}"
            Orientation="Horizontal"
            Spacing="2">
            <TextBlock
                Margin="8,0"
                Text="{Binding Summary}"
                VerticalAlignment="Center" />
            <Button
                Classes="icon"
                Click="OnPreviousChangeClick"
                ToolTip.Tip="Previous change">
                <PathIcon Data="{DynamicResource Icon.ChevronDown}" RenderTransform="rotate(180deg)" />
            </Button>
            <Button
                Classes="icon"
                Click="OnNextChangeClick"
                ToolTip.Tip="Next change">
                <PathIcon Data="{DynamicResource Icon.ChevronDown}" />
            </Button>
            <Button
                Classes="icon"
                Command="{Binding OpenFileCommand}"
                ToolTip.Tip="Open the file">
                <PathIcon Data="{DynamicResource Icon.OpenInApp}" />
            </Button>
        </StackPanel>

        <!--  Which version each side is  -->
        <Grid
            Background="{DynamicResource AppDocumentBarBackgroundBrush}"
            ColumnDefinitions="*,4,*"
            Grid.Row="1">
            <TextBlock
                Margin="8,2"
                Opacity="0.7"
                Text="{Binding LeftTitle}" />
            <TextBlock
                Grid.Column="2"
                Margin="8,2"
                Opacity="0.7"
                Text="{Binding RightTitle}" />
        </Grid>

        <Grid ColumnDefinitions="*,4,*,Auto" Grid.Row="2">
            <editor:IdeTextEditor Name="LeftEditor" />
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
            <editor:IdeTextEditor Grid.Column="2" Name="RightEditor" />

            <!--  One scrollbar for both sides, with the changes mapped on it (Editor/Diff/DiffOverviewRuler)  -->
            <diff:DiffOverviewRuler
                Grid.Column="3"
                Name="OverviewRuler"
                Width="14" />
        </Grid>
    </Grid>
</UserControl>
