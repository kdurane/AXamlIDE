<Window
    Title="AXxamlIde"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    x:Class="AXamlIDE.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AXamlIDE.Models"
    xmlns:views="using:AXamlIDE.Views"
    xmlns:vm="clr-namespace:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="auto,*,Auto">

        <Grid ColumnDefinitions="*,Auto" Grid.Row="0">
            <Border Background="#262626" Grid.ColumnSpan="2" />
            <Menu MinHeight="0" Padding="0">
                <MenuItem Header="_File">
                    <MenuItem Command="{Binding OpenFolderCommand}" Header="_Open Folder..." />
                    <MenuItem Command="{Binding OpenSolutionCommand}" Header="Open _Solution..." />
                    <MenuItem Command="{Binding CloseSolutionClickCommand}" Header="_Close Solution" />
                    <Separator />
                    <MenuItem
                        Command="{Binding SaveActiveDocumentCommand}"
                        Header="_Save"
                        InputGesture="Ctrl+S" />
                </MenuItem>
                <MenuItem Header="_Build">
                    <MenuItem
                        Command="{Binding BuildProjectCommand}"
                        CommandParameter="{Binding SelectedWorkspaceNode}"
                        Header="_Build Project"
                        InputGesture="Ctrl+Shift+B" />
                    <MenuItem
                        Command="{Binding RunProjectCommand}"
                        CommandParameter="{Binding SelectedWorkspaceNode}"
                        Header="Run Without _Debugging"
                        InputGesture="Ctrl+F5" />
                    <MenuItem
                        Command="{Binding StartDebuggingCommand}"
                        CommandParameter="{Binding SelectedWorkspaceNode}"
                        Header="_Start Debugging"
                        InputGesture="F5" />
                    <MenuItem
                        Command="{Binding ContinueDebuggingCommand}"
                        Header="_Continue"
                        IsEnabled="{Binding IsDebugStopped}" />
                    <MenuItem
                        Command="{Binding StopRunningProjectCommand}"
                        Header="_Stop"
                        InputGesture="Shift+F5"
                        IsEnabled="{Binding IsRunning}" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Click="OnToggleExplorerClick" Header="Show/Hide _Explorer" />
                    <MenuItem Command="{Binding ToggleSolutionExplorerSideCommand}" Header="_Swap Panes" />
                    <MenuItem Command="{Binding RestartLanguageServicesCommand}" Header="_Restart Language Servers" />
                    <Separator />
                    <MenuItem
                        Command="{Binding QuickOpenCommand}"
                        Header="_Quick Open..."
                        InputGesture="Ctrl+P" />
                    <MenuItem
                        Click="OnFindInFilesClick"
                        Header="Find in _Files..."
                        InputGesture="Ctrl+Shift+F" />
                    <MenuItem
                        Click="OnWorkspaceSymbolsClick"
                        Header="Go to _Symbol..."
                        InputGesture="Ctrl+T" />
                    <MenuItem
                        Click="OnGoToDefinitionClick"
                        Header="Go to _Definition"
                        InputGesture="F12" />
                    <MenuItem
                        Click="OnFindReferencesClick"
                        Header="Find All _References"
                        InputGesture="Shift+F12" />
                    <MenuItem
                        Click="OnRenameSymbolClick"
                        Header="_Rename Symbol..."
                        InputGesture="Ctrl+R" />
                    <MenuItem
                        Click="OnSignatureHelpClick"
                        Header="_Signature Help"
                        InputGesture="Ctrl+Shift+Space" />
                    <MenuItem
                        Click="OnCodeActionsClick"
                        Header="Quick _Actions..."
                        InputGesture="Ctrl+." />
                    <MenuItem Command="{Binding FormatActiveDocumentCommand}" Header="_Format Document" />
                    <Separator />
                    <MenuItem
                        Command="{Binding NavigateDiagnosticCommand}"
                        CommandParameter="{x:True}"
                        Header="_Next Diagnostic"
                        InputGesture="F8" />
                    <MenuItem
                        Command="{Binding NavigateDiagnosticCommand}"
                        CommandParameter="{x:False}"
                        Header="_Previous Diagnostic"
                        InputGesture="Shift+F8" />
                </MenuItem>
            </Menu>
            <Button
                AutomationProperties.Name="Settings"
                Background="#262626"
                Command="{Binding OpenSettingsCommand}"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Margin="0"
                Padding="4"
                ToolTip.Tip="Settings"
                VerticalAlignment="Stretch">
                <PathIcon
                    Data="{DynamicResource Icon.Cog}"
                    Foreground="{DynamicResource ThemeForegroundBrush}"
                    Height="16"
                    Width="16" />
            </Button>
        </Grid>

        <Grid
            ColumnDefinitions="30,260,1,*"
            Grid.Row="1"
            Name="ContentGrid">

            <Border
                Background="#202020"
                Grid.Column="0"
                MinWidth="0"
                Name="ActivityBar"
                Padding="0">
                <StackPanel Margin="0" Spacing="4">
                    <Button
                        AutomationProperties.Name="Move explorer to other side"
                        Background="Transparent"
                        Command="{Binding ToggleSolutionExplorerSideCommand}"
                        Padding="8"
                        ToolTip.Tip="Move explorer to the other side">
                        <PathIcon
                            Data="{DynamicResource Icon.Transfer}"
                            Height="16"
                            Width="16" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Explorer"
                        Background="Transparent"
                        Click="OnToggleExplorerClick"
                        Padding="8"
                        ToolTip.Tip="Explorer">
                        <PathIcon
                            Data="{DynamicResource Icon.FolderMultipleOutline}"
                            Height="16"
                            Width="16" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Search in files"
                        Background="Transparent"
                        Click="OnFindInFilesClick"
                        Padding="8"
                        ToolTip.Tip="Search in files">
                        <PathIcon
                            Data="{DynamicResource Icon.Search}"
                            Height="16"
                            Width="16" />
                    </Button>
                </StackPanel>
            </Border>

            <Grid
                Background="{DynamicResource ThemeBackgroundBrush}"
                Grid.Column="1"
                Name="ExplorerPane"
                RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="6,4">
                    <TextBlock
                        FontSize="11"
                        FontWeight="DemiBold"
                        Text="Explorer"
                        VerticalAlignment="Center" />
                </Grid>
                <TreeView
                    Foreground="{DynamicResource ThemeForegroundBrush}"
                    Grid.Row="1"
                    ItemsSource="{Binding WorkspaceRoots}"
                    Name="FileTree"
                    SelectedItem="{Binding SelectedWorkspaceNode, Mode=TwoWay}">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="MinHeight" Value="20" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="{x:Type local:ProjectTreeNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon
                                    Data="{Binding Icon}"
                                    Height="12"
                                    Width="12" />
                                <TextBlock FontSize="12" Text="{Binding Name}" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.Resources>
                        <x:Double x:Key="TreeViewItemIndent">10</x:Double>
                    </TreeView.Resources>
                </TreeView>
            </Grid>

            <GridSplitter
                Grid.Column="2"
                Name="Splitter"
                ResizeDirection="Columns" />

            <!--  One shared editor; the tab strip only swaps its Document.  -->
            <Grid
                Grid.Column="3"
                Name="EditorHost"
                RowDefinitions="*,4,190">
                <Grid
                    Grid.Row="0"
                    IsVisible="{Binding IsEditorVisible}"
                    RowDefinitions="Auto,*">

                    <Grid ColumnDefinitions="*,Auto" Grid.Row="0">
                        <TabStrip
                            Grid.Column="0"
                            ItemsSource="{Binding Documents}"
                            Name="DocTabs"
                            Padding="0"
                            SelectedItem="{Binding SelectedDocTabItem}"
                            SelectionChanged="OnTabSelectionChanged">
                            <TabStrip.ItemTemplate>
                                <DataTemplate x:DataType="local:OpenDocument">
                                    <DockPanel PointerReleased="OnTabPointerReleased">
                                        <TextBlock
                                            FontSize="11"
                                            Text="{Binding DisplayTitle}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Background="Transparent"
                                            Click="OnTabCloseClick"
                                            Content="&#x2715;"
                                            FontSize="9"
                                            Margin="0"
                                            MinHeight="0"
                                            Padding="3,0"
                                            Tag="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </TabStrip.ItemTemplate>
                        </TabStrip>
                        <ComboBox
                            DisplayMemberBinding="{Binding DisplayName}"
                            Foreground="{DynamicResource ThemeForegroundBrush}"
                            Grid.Column="1"
                            IsTextSearchEnabled="True"
                            IsVisible="{Binding IsDocumentOutlineVisible}"
                            ItemsSource="{Binding DocumentOutlineItems}"
                            Margin="4,4,4,0"
                            MaxWidth="260"
                            MinHeight="0"
                            MinWidth="180"
                            Name="OutlineComboBox"
                            Padding="4"
                            SelectedItem="{Binding SelectedDocumentOutlineItem, Mode=TwoWay}"
                            SelectionChanged="OnOutlineSelectionChanged"
                            ToolTip.Tip="Navigate to a C# type or member" />
                    </Grid>

                    <Grid Grid.Row="1" Name="DocumentSurface">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="160" Width="*" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                        </Grid.ColumnDefinitions>
                        <views:EditorPaneView Grid.Column="0" Name="EditorPane" />
                        <GridSplitter
                            Background="#FF555555"
                            Grid.Column="1"
                            IsVisible="False"
                            Name="PreviewSplitter"
                            ResizeBehavior="PreviousAndNext"
                            ResizeDirection="Columns"
                            ShowsPreview="False" />
                        <views:PreviewPaneView
                            Grid.Column="2"
                            IsVisible="False"
                            Name="PreviewPane" />
                    </Grid>
                </Grid>
                <Border
                    BorderBrush="{DynamicResource ThemeForegroundBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsWelcomeVisible}"
                    MaxWidth="560"
                    Padding="32"
                    VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Text="Welcome to AXaxmlIDE" />
                        <TextBlock
                            Foreground="{DynamicResource ThemeForegroundBrush}"
                            HorizontalAlignment="Center"
                            Text="Open a project folder or solution to get started, then choose a file in Explorer."
                            TextWrapping="Wrap" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Command="{Binding OpenFolderCommand}"
                                Content="Open Folder..."
                                HorizontalContentAlignment="Center" />
                            <Button
                                Command="{Binding OpenSolutionCommand}"
                                Content="Open Solution..."
                                HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <GridSplitter
                    Grid.Row="1"
                    Height="4"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Rows" />

                <TabControl
                    FontSize="11"
                    Grid.Row="2"
                    Name="ToolTabs"
                    SelectedIndex="{Binding SelectedToolTabIndex}">
                    <TabItem
                        FontSize="11"
                        Header="Problems"
                        IsSelected="True">
                        <Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,*">

                            <!--  Header row  -->
                            <Grid
                                ColumnDefinitions="76,*,Auto,Auto"
                                Grid.Row="0"
                                Margin="6,0">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Grid.Column="0"
                                    Text="Severity" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Grid.Column="1"
                                    Text="Message" />
                                <Grid Grid.Column="2" Margin="12,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="LineCol" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="Line" />
                                </Grid>
                                <Grid Grid.Column="3" Margin="6,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="FileCol" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="File" />
                                </Grid>
                            </Grid>

                            <ListBox
                                DoubleTapped="OnProblemClick"
                                Grid.Row="1"
                                ItemsSource="{Binding Problems}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:ProblemItem">
                                        <Grid ColumnDefinitions="76,*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Severity}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Message}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Grid Grid.Column="2" Margin="12,0,6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition SharedSizeGroup="LineCol" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Line}" />
                                            </Grid>
                                            <Grid Grid.Column="3" Margin="6,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition SharedSizeGroup="FileCol" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Document.Title}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="6,3" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem FontSize="11" Header="Output">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BuildOutput}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                            FontSize="11"
                                            Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem FontSize="11" Header="Debug">
                        <StackPanel Margin="10" Spacing="8">
                            <TextBlock Text="{Binding DebugStatus}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    Command="{Binding ContinueDebuggingCommand}"
                                    Content="Continue"
                                    IsEnabled="{Binding IsDebugStopped}" />
                                <Button
                                    Command="{Binding StopRunningProjectCommand}"
                                    Content="Stop"
                                    IsEnabled="{Binding IsDebugging}" />
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Text="Set breakpoints by clicking the editor gutter, then choose Start Debugging."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>
                    <TabItem FontSize="11" Header="Console">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ConsoleOutput}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                            FontSize="11"
                                            Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem FontSize="11" Header="Search">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <Grid ColumnDefinitions="*,Auto" Margin="8">
                                <TextBox
                                    Grid.Column="0"
                                    KeyDown="OnFindInFilesKeyDown"
                                    Name="FindInFilesQuery"
                                    PlaceholderText="Search workspace text..."
                                    Text="{Binding SearchQuery, Mode=TwoWay}" />
                                <Button
                                    Command="{Binding SearchWorkspaceCommand}"
                                    Content="Search"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    MinWidth="76" />
                            </Grid>
                            <Grid
                                ColumnDefinitions="*,Auto"
                                Grid.Row="1"
                                Margin="8,0,8,8">
                                <TextBox
                                    Grid.Column="0"
                                    KeyDown="OnReplaceWorkspaceKeyDown"
                                    PlaceholderText="Replace with..."
                                    Text="{Binding ReplaceText, Mode=TwoWay}" />
                                <Button
                                    Command="{Binding ReplaceWorkspaceCommand}"
                                    Content="Replace All..."
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    MinWidth="100" />
                            </Grid>
                            <TextBlock
                                Grid.Row="2"
                                Margin="8,0,8,6"
                                Text="{Binding SearchStatus}" />
                            <ScrollViewer
                                Grid.Row="3"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:WorkspaceSearchResult">
                                            <Button
                                                Click="OnSearchResultClick"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="6,3"
                                                Tag="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,8,0"
                                                        Text="{Binding FilePath}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding LineText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="8,0,0,0"
                                                        Text="{Binding LineNumber}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="8,2"
            x:Name="StatusBar">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock
                    Grid.Column="0"
                    Name="LspStatus"
                    Text="{Binding LspStatus}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,16,0"
                    Name="DiagStatus" />
                <TextBlock Grid.Column="2" Name="CaretStatus" />
            </Grid>
        </Border>
    </Grid>
</Window>
