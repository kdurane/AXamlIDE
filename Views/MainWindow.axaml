<Window
    x:Class="AXamlIDE.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:AXamlIDE.SampleData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:msg="using:AXamlIDE.Messages"
    xmlns:shell="using:AXamlIDE.Shell"
    xmlns:views="using:AXamlIDE.Views"
    xmlns:vm="using:AXamlIDE.ViewModels"
    Title="AXamlIDE"
    MinWidth="800"
    d:DesignHeight="800"
    d:DesignWidth="1600"
    x:DataType="vm:MainWindowViewModel"
    Background="{DynamicResource AppWindowBackgroundBrush}"
    Classes="customChrome"
    Design.DataContext="{x:Static design:DesignData.MainWindow}"
    Foreground="{DynamicResource AppForegroundBrush}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!--
            The window's own title bar (Views/WindowTitleBar.axaml): the menus, the toolbar, search and settings, then the
            minimize / maximize / close buttons. Empty space between them drags the window.
        -->
        <views:WindowTitleBar Grid.Row="0">
            <views:WindowTitleBar.BarContent>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!--
                        The menus, Visual Studio / Rider style. Each item binds the same command as its button and key; the keys
                        shown come from the active keymap (Shell/KeyMap.cs), except the editor's own (undo, clipboard).
                        Build and Debug act on the startup project (the top bar's box).
                    -->
                    <Menu
                        x:Name="MainMenu"
                        MinHeight="0"
                        Padding="0">
                        <MenuItem Header="_File">
                            <MenuItem Command="{Binding ShowStartWindowCommand}" Header="Start _Window..." />
                            <Separator />
                            <MenuItem Command="{Binding Start.NewProjectCommand}" Header="_New Project..." />
                            <MenuItem Command="{Binding Start.CloneRepositoryCommand}" Header="Clone _Repository..." />
                            <MenuItem Command="{Binding Start.OpenSolutionCommand}" Header="Open _Solution..." />
                            <MenuItem Command="{Binding Start.OpenFolderCommand}" Header="Open _Folder..." />
                            <MenuItem Command="{Binding CloseSolutionCommand}" Header="_Close Solution" />
                            <Separator />
                            <MenuItem
                                Classes="recent"
                                Header="Recent Projects and Sol_utions"
                                IsEnabled="{Binding Start.HasMenuItems}"
                                ItemsSource="{Binding Start.MenuItems}">
                                <MenuItem.Styles>
                                    <Style x:DataType="vm:RecentItemViewModel" Selector="MenuItem.recent &gt; MenuItem">
                                        <Setter Property="Header" Value="{Binding MenuHeader}" />
                                        <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Start.OpenRecentCommand, FallbackValue={x:Null}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </MenuItem.Styles>
                            </MenuItem>
                            <Separator />
                            <MenuItem Command="{Binding Explorer.NewItemCommand}" Header="New _Item..." />
                            <MenuItem Command="{Binding Explorer.NewClassCommand}" Header="New C_lass..." />
                            <MenuItem Command="{Binding Explorer.NewFolderCommand}" Header="New Fol_der..." />
                            <Separator />
                            <MenuItem Command="{Binding DocumentCommands.SaveDocumentCommand}" Header="_Save" />
                            <MenuItem Command="{Binding DocumentCommands.SaveDocumentAsCommand}" Header="Save _As..." />
                            <MenuItem Command="{Binding DocumentCommands.SaveAllCommand}" Header="Save A_ll" />
                            <Separator />
                            <MenuItem Command="{Binding DocumentCommands.CloseDocumentCommand}" Header="Close _Tab" />
                            <MenuItem Command="{Binding DocumentCommands.CloseAllCommand}" Header="Close All Documents" />
                            <Separator />
                            <MenuItem Command="{Binding ExitCommand}" Header="E_xit" />
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem
                                Command="{Binding EditorCommands.Undo}"
                                Header="_Undo"
                                InputGesture="Ctrl+Z" />
                            <MenuItem
                                Command="{Binding EditorCommands.Redo}"
                                Header="_Redo"
                                InputGesture="Ctrl+Y" />
                            <Separator />
                            <MenuItem
                                Command="{Binding EditorCommands.Cut}"
                                Header="Cu_t"
                                InputGesture="Ctrl+X" />
                            <MenuItem
                                Command="{Binding EditorCommands.Copy}"
                                Header="_Copy"
                                InputGesture="Ctrl+C" />
                            <MenuItem
                                Command="{Binding EditorCommands.Paste}"
                                Header="_Paste"
                                InputGesture="Ctrl+V" />
                            <MenuItem
                                Command="{Binding EditorCommands.SelectAll}"
                                Header="Select _All"
                                InputGesture="Ctrl+A" />
                            <Separator />
                            <MenuItem Command="{Binding EditorCommands.ToggleComment}" Header="To_ggle Comment" />
                            <MenuItem Command="{Binding EditorCommands.CommentSelection}" Header="Comment _Selection" />
                            <MenuItem Command="{Binding EditorCommands.UncommentSelection}" Header="Uncomm_ent Selection" />
                            <Separator />
                            <MenuItem Command="{Binding EditorCommands.Find}" Header="_Find..." />
                            <MenuItem Command="{Binding EditorCommands.Replace}" Header="Rep_lace..." />
                            <MenuItem Command="{Binding ShowFindInFilesCommand}" Header="Find in _Files..." />
                            <MenuItem Command="{Binding EditorCommands.GoToLine}" Header="Go To _Line..." />
                            <Separator />
                            <MenuItem Command="{Binding EditorCommands.RenameSymbol}" Header="Re_name Symbol..." />
                            <MenuItem Command="{Binding EditorCommands.QuickActions}" Header="_Quick Actions..." />
                            <MenuItem Command="{Binding DocumentCommands.FormatDocumentCommand}" Header="F_ormat Document" />
                            <MenuItem Command="{Binding EditorCommands.Completion}" Header="Co_mplete Word" />
                            <MenuItem Command="{Binding EditorCommands.SignatureHelp}" Header="Parameter _Info" />
                            <MenuItem Command="{Binding EditorCommands.InsertSnippet}" Header="Insert Sn_ippet..." />
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem
                                Command="{Binding ShowToolCommand}"
                                CommandParameter="{x:Static msg:ToolTab.Explorer}"
                                Header="_Explorer" />
                            <MenuItem
                                Command="{Binding ShowToolCommand}"
                                CommandParameter="{x:Static msg:ToolTab.Git}"
                                Header="_Git" />
                            <MenuItem
                                Command="{Binding ShowToolCommand}"
                                CommandParameter="{x:Static msg:ToolTab.Debug}"
                                Header="R_un and Debug" />
                            <MenuItem Command="{Binding Git.ShowGraphCommand}" Header="Git Gra_ph" />
                            <MenuItem Command="{Binding Properties.ShowCommand}" Header="P_roperties" />
                            <Separator />
                            <MenuItem
                                Command="{Binding ShowToolCommand}"
                                CommandParameter="{x:Static msg:ToolTab.Problems}"
                                Header="_Problems" />
                            <MenuItem
                                Command="{Binding ShowToolCommand}"
                                CommandParameter="{x:Static msg:ToolTab.Output}"
                                Header="_Output" />
                            <MenuItem
                                Command="{Binding ShowToolCommand}"
                                CommandParameter="{x:Static msg:ToolTab.Console}"
                                Header="_Debug Console" />
                            <MenuItem Command="{Binding ShowTerminalCommand}" Header="_Terminal" />
                            <MenuItem
                                Command="{Binding ShowToolCommand}"
                                CommandParameter="{x:Static msg:ToolTab.Tests}"
                                Header="Test E_xplorer" />
                            <MenuItem Command="{Binding ShowFindInFilesCommand}" Header="_Search" />
                            <Separator />
                            <MenuItem Command="{Binding ShowClaudeCommand}" Header="C_laude" />
                            <MenuItem Command="{Binding NewClaudeChatCommand}" Header="New Claude C_hat" />
                            <Separator />
                            <MenuItem Command="{Binding ToggleExplorerCommand}" Header="Show/Hide Side _Bar" />
                            <MenuItem Command="{Binding TogglePanelCommand}" Header="Show/Hide P_anel" />
                            <MenuItem Command="{Binding ToggleSolutionExplorerSideCommand}" Header="Move Side Bar to Other Side" />
                        </MenuItem>
                        <!--  Visual Studio's Git menu: the same commands as the Git tab's "..." menu and its graph  -->
                        <MenuItem Header="_Git">
                            <MenuItem Command="{Binding Git.CommitCommand}" Header="_Commit Staged" IsEnabled="{Binding Git.IsRepository}" />
                            <MenuItem Command="{Binding Git.CommitAllCommand}" Header="Commit _All" IsEnabled="{Binding Git.IsRepository}" />
                            <MenuItem Command="{Binding Git.AmendCommand}" Header="A_mend Last Commit..." IsEnabled="{Binding Git.IsRepository}" />
                            <MenuItem Command="{Binding Git.UndoLastCommitCommand}" Header="_Undo Last Commit..." IsEnabled="{Binding Git.IsRepository}" />
                            <Separator />
                            <MenuItem Command="{Binding Git.FetchCommand}" Header="_Fetch" IsEnabled="{Binding Git.IsRepository}" />
                            <MenuItem Command="{Binding Git.PullCommand}" Header="_Pull" IsEnabled="{Binding Git.IsRepository}" />
                            <MenuItem Command="{Binding Git.PullRebaseCommand}" Header="Pull (_Rebase)" IsEnabled="{Binding Git.IsRepository}" />
                            <MenuItem Command="{Binding Git.PushCommand}" Header="{Binding Git.PushHeader}" IsEnabled="{Binding Git.IsRepository}" />
                            <MenuItem Command="{Binding Git.SyncCommand}" Header="_Sync (Pull, then Push)" IsEnabled="{Binding Git.IsRepository}" />
                            <Separator />
                            <MenuItem Header="_Branch" IsEnabled="{Binding Git.IsRepository}">
                                <MenuItem Command="{Binding Git.NewBranchCommand}" Header="_New Branch..." />
                                <MenuItem Command="{Binding Git.SwitchBranchCommand}" Header="_Switch Branch..." />
                                <MenuItem Command="{Binding Git.MergeBranchCommand}" Header="_Merge Branch..." />
                                <Separator />
                                <MenuItem Command="{Binding Git.RenameBranchCommand}" Header="_Rename Branch..." />
                                <MenuItem Command="{Binding Git.DeleteBranchCommand}" Header="_Delete Branch..." />
                                <Separator />
                                <MenuItem Command="{Binding Git.AbortOperationCommand}" Header="_Abort Merge or Rebase..." />
                            </MenuItem>
                            <MenuItem Header="S_tash" IsEnabled="{Binding Git.IsRepository}">
                                <MenuItem Command="{Binding Git.StashCommand}" Header="_Stash Changes..." />
                                <MenuItem Command="{Binding Git.PopStashCommand}" Header="_Pop Latest Stash" />
                                <Separator />
                                <MenuItem Command="{Binding Git.ApplyStashCommand}" Header="_Apply Stash..." />
                                <MenuItem Command="{Binding Git.PopStashPickedCommand}" Header="P_op Stash..." />
                                <MenuItem Command="{Binding Git.DropStashCommand}" Header="_Drop Stash..." />
                            </MenuItem>
                            <Separator />
                            <MenuItem Command="{Binding EditorCommands.NextChange}" Header="_Next Change" />
                            <MenuItem Command="{Binding EditorCommands.PreviousChange}" Header="Pre_vious Change" />
                            <MenuItem Command="{Binding EditorCommands.RevertChange}" Header="Revert Chang_e" />
                            <Separator />
                            <MenuItem Command="{Binding Git.DiscardAllCommand}" Header="_Discard All Changes..." IsEnabled="{Binding Git.IsRepository}" />
                            <Separator />
                            <MenuItem
                                Command="{Binding ShowToolCommand}"
                                CommandParameter="{x:Static msg:ToolTab.Git}"
                                Header="Git C_hanges" />
                            <MenuItem Command="{Binding Git.ShowGraphCommand}" Header="Git _Graph" />
                        </MenuItem>
                        <MenuItem Header="_Navigate">
                            <MenuItem Command="{Binding NavigateBackCommand}" Header="Navigate _Backward" />
                            <MenuItem Command="{Binding NavigateForwardCommand}" Header="Navigate For_ward" />
                            <Separator />
                            <MenuItem
                                Command="{Binding SearchEverywhere.OpenCommand}"
                                CommandParameter="{x:Static models:SearchEverywhereTab.All}"
                                Header="Search _Everywhere..." />
                            <MenuItem
                                Command="{Binding SearchEverywhere.OpenCommand}"
                                CommandParameter="{x:Static models:SearchEverywhereTab.Actions}"
                                Header="Find _Action..." />
                            <MenuItem Command="{Binding EditorCommands.QuickOpen}" Header="Go to _File..." />
                            <MenuItem Command="{Binding EditorCommands.WorkspaceSymbols}" Header="Go to _Symbol..." />
                            <Separator />
                            <MenuItem Command="{Binding EditorCommands.GoToDefinition}" Header="Go to _Definition" />
                            <MenuItem Command="{Binding EditorCommands.FindReferences}" Header="Find All _References" />
                            <Separator />
                            <MenuItem
                                Command="{Binding Problems.NavigateDiagnosticCommand}"
                                CommandParameter="{x:True}"
                                Header="_Next Problem" />
                            <MenuItem
                                Command="{Binding Problems.NavigateDiagnosticCommand}"
                                CommandParameter="{x:False}"
                                Header="_Previous Problem" />
                        </MenuItem>
                        <MenuItem Header="_Build">
                            <MenuItem Command="{Binding Run.BuildCommand}" Header="_Build" />
                            <MenuItem Command="{Binding Run.RebuildCommand}" Header="_Rebuild" />
                            <MenuItem Command="{Binding Run.CleanCommand}" Header="_Clean" />
                            <Separator />
                            <MenuItem
                                Command="{Binding Run.BuildProjectCommand}"
                                Header="Build _Selected Project"
                                IsEnabled="{Binding Workspace.SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <MenuItem
                                Command="{Binding Run.RebuildProjectCommand}"
                                Header="R_ebuild Selected Project"
                                IsEnabled="{Binding Workspace.SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <MenuItem
                                Command="{Binding Run.CleanProjectCommand}"
                                Header="C_lean Selected Project"
                                IsEnabled="{Binding Workspace.SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <Separator />
                            <MenuItem Command="{Binding Publish.PublishCurrentProjectCommand}" Header="_Publish Selected Project..." />
                        </MenuItem>
                        <MenuItem Header="_Debug">
                            <MenuItem
                                Command="{Binding Run.StartDebuggingCommand}"
                                Header="_Start Debugging"
                                InputGesture="F5" />
                            <MenuItem Command="{Binding Run.RunProjectCommand}" Header="Start _Without Debugging" />
                            <Separator />
                            <MenuItem
                                Command="{Binding Run.ContinueDebuggingCommand}"
                                Header="_Continue"
                                InputGesture="F5" />
                            <MenuItem Command="{Binding Run.PauseDebuggingCommand}" Header="_Pause" />
                            <MenuItem
                                Command="{Binding Run.StopRunningProjectCommand}"
                                Header="S_top"
                                IsEnabled="{Binding Run.IsRunning}" />
                            <MenuItem Command="{Binding Run.RestartDebuggingCommand}" Header="_Restart" />
                            <Separator />
                            <MenuItem Command="{Binding Run.StepOverCommand}" Header="Step _Over" />
                            <MenuItem Command="{Binding Run.StepIntoCommand}" Header="Step _Into" />
                            <MenuItem Command="{Binding Run.StepOutCommand}" Header="Step O_ut" />
                            <Separator />
                            <MenuItem Command="{Binding EditorCommands.ToggleBreakpoint}" Header="Toggle _Breakpoint" />
                            <MenuItem Command="{Binding DeleteAllBreakpointsCommand}" Header="_Delete All Breakpoints" />
                            <MenuItem
                                Command="{Binding SetAllBreakpointsEnabledCommand}"
                                CommandParameter="{x:False}"
                                Header="Disa_ble All Breakpoints" />
                            <MenuItem
                                Command="{Binding SetAllBreakpointsEnabledCommand}"
                                CommandParameter="{x:True}"
                                Header="E_nable All Breakpoints" />
                            <Separator />
                            <MenuItem Command="{Binding OpenSettingsCommand}" Header="_Exception Settings..." />
                            <Separator />
                            <MenuItem Command="{Binding EditorCommands.AddWatch}" Header="Add _Watch" />
                            <MenuItem Header="Win_dows">
                                <MenuItem
                                    Command="{Binding ShowToolCommand}"
                                    CommandParameter="{x:Static msg:ToolTab.Locals}"
                                    Header="_Locals" />
                                <MenuItem
                                    Command="{Binding ShowToolCommand}"
                                    CommandParameter="{x:Static msg:ToolTab.Watch}"
                                    Header="_Watch" />
                                <MenuItem
                                    Command="{Binding ShowToolCommand}"
                                    CommandParameter="{x:Static msg:ToolTab.CallStack}"
                                    Header="_Call Stack" />
                                <MenuItem
                                    Command="{Binding ShowToolCommand}"
                                    CommandParameter="{x:Static msg:ToolTab.Diagnostics}"
                                    Header="Diagnostic _Tools" />
                                <MenuItem
                                    Command="{Binding ShowToolCommand}"
                                    CommandParameter="{x:Static msg:ToolTab.Console}"
                                    Header="Debug C_onsole" />
                            </MenuItem>
                        </MenuItem>
                        <!--  Visual Studio's Test menu  -->
                        <MenuItem Header="Te_st">
                            <MenuItem Command="{Binding Tests.RunAllCommand}" Header="Run _All Tests" />
                            <MenuItem Command="{Binding Tests.RunFailedCommand}" Header="Run _Failed Tests" />
                            <Separator />
                            <MenuItem
                                Command="{Binding ShowToolCommand}"
                                CommandParameter="{x:Static msg:ToolTab.Tests}"
                                Header="Test E_xplorer" />
                            <MenuItem Command="{Binding Tests.DiscoverCommand}" Header="_Refresh Tests" />
                            <Separator />
                            <MenuItem Command="{Binding Tests.NewTestProjectCommand}" Header="_New Test Project..." />
                        </MenuItem>
                        <!--  Visual Studio's Analyze menu  -->
                        <MenuItem Header="Analy_ze">
                            <MenuItem Command="{Binding StatusBar.RunCodeAnalysisCommand}" Header="Run Code _Analysis on Solution" />
                            <Separator />
                            <MenuItem
                                Command="{Binding StatusBar.ToggleSolutionAnalysisCommand}"
                                Header="_Solution-Wide Analysis"
                                IsChecked="{Binding StatusBar.IsSolutionAnalysisOn, Mode=OneWay}"
                                ToggleType="CheckBox" />
                        </MenuItem>
                        <MenuItem Header="_Tools">
                            <MenuItem Command="{Binding NuGet.ManagePackagesForCurrentProjectCommand}" Header="Manage _NuGet Packages..." />
                            <MenuItem Command="{Binding RestartLanguageServicesCommand}" Header="_Restart Language Servers" />
                            <MenuItem Command="{Binding EditSnippetsCommand}" Header="Edit S_nippets..." />
                            <Separator />
                            <MenuItem Command="{Binding OpenSettingsCommand}" Header="_Settings..." />
                        </MenuItem>
                        <!--  Visual Studio's Window menu: layout commands, then every open document.  -->
                        <MenuItem Header="_Window">
                            <MenuItem Command="{Binding DocumentCommands.CloseAllCommand}" Header="C_lose All Documents" />
                            <Separator />
                            <MenuItem Command="{Binding ToggleExplorerCommand}" Header="Show/Hide Side _Bar" />
                            <MenuItem Command="{Binding TogglePanelCommand}" Header="Show/Hide _Panel" />
                            <MenuItem Command="{Binding ToggleSolutionExplorerSideCommand}" Header="_Move Side Bar to Other Side" />
                            <MenuItem Command="{Binding ResetWindowLayoutCommand}" Header="_Reset Window Layout" />
                            <Separator />
                            <MenuItem
                                Classes="openDocuments"
                                Header="_Documents"
                                ItemsSource="{Binding OpenDocuments}">
                                <MenuItem.Styles>
                                    <Style x:DataType="models:OpenDocument" Selector="MenuItem.openDocuments &gt; MenuItem">
                                        <Setter Property="Header" Value="{Binding DisplayTitle}" />
                                        <Setter Property="ToolTip.Tip" Value="{Binding Path}" />
                                        <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActivateDocumentCommand, FallbackValue={x:Null}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </MenuItem.Styles>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem Command="{Binding OpenSettingsCommand}" Header="_Keyboard Shortcuts..." />
                            <MenuItem Command="{Binding ViewCrashLogCommand}" Header="View _Crash Log" />
                            <Separator />
                            <MenuItem Command="{Binding ShowAboutCommand}" Header="_About AXamlIDE" />
                        </MenuItem>
                    </Menu>
                    <!--
                        Visual Studio's toolbar: Build, the configuration, and the start button (play + startup project, with
                        a drop-down to pick it). Same commands as the menus and keys.
                    -->
                    <StackPanel
                        x:Name="MainToolbar"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4">
                        <views:DebugToolbarView DataContext="{Binding Run}" />
                        <Button
                            Padding="6,0"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Build"
                            Background="Transparent"
                            Command="{Binding Run.BuildCommand}"
                            ToolTip.Tip="Build (Ctrl+Shift+B)">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Data="{StaticResource Icon.Hammer}" />
                        </Button>
                        <ComboBox
                            MinHeight="0"
                            Margin="0,3"
                            Padding="8,2"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="Configuration"
                            FontSize="11"
                            IsEnabled="{Binding !Run.IsRunning}"
                            ItemsSource="{Binding Run.Configurations}"
                            SelectedItem="{Binding Run.Configuration}"
                            ToolTip.Tip="Build configuration" />
                        <!--
                            Visual Studio's start button: play and the startup project's name start debugging it (a stop square
                            while it runs); the arrow lists the startup projects to pick from.
                        -->
                        <SplitButton
                            AutomationProperties.Name="{Binding Run.StartOrStopToolTip}"
                            Classes="startButton"
                            Command="{Binding Run.StartOrStopCommand}"
                            ToolTip.Tip="{Binding Run.StartOrStopToolTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel>
                                    <PathIcon
                                        Data="{StaticResource Icon.Play}"
                                        Foreground="{DynamicResource DebugStartBrush}"
                                        IsVisible="{Binding !Run.IsRunning}" />
                                    <PathIcon
                                        Data="{StaticResource Icon.Stop}"
                                        Foreground="{DynamicResource DebugStopBrush}"
                                        IsVisible="{Binding Run.IsRunning}" />
                                </Panel>
                                <TextBlock Text="{Binding Run.StartupProject.Name, FallbackValue=Start, TargetNullValue=Start}" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout ItemsSource="{Binding Run.StartupProjects}" Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyout.ItemContainerTheme>
                                        <ControlTheme
                                            x:DataType="models:StartupProjectItem"
                                            BasedOn="{StaticResource {x:Type MenuItem}}"
                                            TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Command" Value="{Binding #MainToolbar.((vm:MainWindowViewModel)DataContext).Run.SelectStartupProjectCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                            <Setter Property="IsEnabled" Value="{Binding !#MainToolbar.((vm:MainWindowViewModel)DataContext).Run.IsRunning}" />
                                        </ControlTheme>
                                    </MenuFlyout.ItemContainerTheme>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </StackPanel>

                    <!--  Search Everywhere (double Shift), as Rider's: types, files, symbols, actions, and Text for the Search window.  -->
                    <Button
                        Grid.Column="2"
                        Width="135"
                        Margin="4,3"
                        VerticalAlignment="Stretch"
                        Classes="searchLauncher"
                        Command="{Binding SearchEverywhere.OpenCommand}"
                        CommandParameter="{x:Static models:SearchEverywhereTab.All}"
                        ToolTip.Tip="Search Everywhere (Double Shift)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon
                                Width="13"
                                Height="13"
                                Data="{DynamicResource Icon.Search}" />
                            <TextBlock Text="Search Everywhere" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="3"
                        Margin="0,0,6,0"
                        Padding="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="Settings"
                        Background="{DynamicResource AppTitleBarBackgroundBrush}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Settings">
                        <PathIcon
                            Width="16"
                            Height="16"
                            Data="{DynamicResource Icon.Cog}"
                            Foreground="{DynamicResource ThemeForegroundBrush}" />
                    </Button>
                </Grid>
            </views:WindowTitleBar.BarContent>
        </views:WindowTitleBar>

        <!--
            Visual Studio's Standard toolbar: Navigate Backward / Forward, Save / Save All, Undo / Redo, then (on the right)
            the window buttons that used to be a VS Code style activity bar: side bar, search, tests, terminal, panel.
        -->
        <Border
            Grid.Row="1"
            Padding="4,1"
            Background="{DynamicResource AppTitleBarBackgroundBrush}"
            BorderBrush="{DynamicResource AppActivityBarBackgroundBrush}"
            BorderThickness="0,1,0,0">
            <Border.Styles>
                <Style Selector="Button.toolbar">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="5,3" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
                <Style Selector="Button.toolbar PathIcon">
                    <Setter Property="Width" Value="15" />
                    <Setter Property="Height" Value="15" />
                </Style>
                <Style Selector="Button.toolbar:disabled PathIcon">
                    <Setter Property="Opacity" Value="0.4" />
                </Style>
                <Style Selector="Border.toolbarSeparator">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Margin" Value="4,3" />
                    <Setter Property="Background" Value="{DynamicResource AppActivityBarBackgroundBrush}" />
                </Style>
            </Border.Styles>
            <DockPanel>
                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="1">
                    <Button
                        shell:KeyMap.ShortcutTip="Show/Hide Side Bar"
                        AutomationProperties.Name="Show or hide the side bar"
                        Classes="toolbar"
                        Command="{Binding ToggleExplorerCommand}">
                        <PathIcon Data="{DynamicResource Icon.FolderMultipleOutline}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Move the side bar to the other side"
                        Classes="toolbar"
                        Command="{Binding ToggleSolutionExplorerSideCommand}"
                        ToolTip.Tip="Move Side Bar to Other Side">
                        <PathIcon Data="{DynamicResource Icon.Transfer}" />
                    </Button>
                    <Border Classes="toolbarSeparator" />
                    <Button
                        shell:KeyMap.ShortcutTip="Find in Files"
                        AutomationProperties.Name="Search in files"
                        Classes="toolbar"
                        Command="{Binding ShowFindInFilesCommand}">
                        <PathIcon Data="{DynamicResource Icon.Search}" />
                    </Button>
                    <Button
                        shell:KeyMap.ShortcutTip="Test Explorer"
                        AutomationProperties.Name="Test Explorer"
                        Classes="toolbar"
                        Command="{Binding ShowToolCommand}"
                        CommandParameter="{x:Static msg:ToolTab.Tests}">
                        <PathIcon Data="{DynamicResource Icon.FlaskEmptyOutline}" />
                    </Button>
                    <Button
                        shell:KeyMap.ShortcutTip="Terminal"
                        AutomationProperties.Name="Terminal"
                        Classes="toolbar"
                        Command="{Binding ShowTerminalCommand}">
                        <PathIcon Data="{DynamicResource Icon.Console}" />
                    </Button>
                    <Button
                        shell:KeyMap.ShortcutTip="Claude"
                        AutomationProperties.Name="Claude"
                        Classes="toolbar"
                        Command="{Binding ShowClaudeCommand}">
                        <PathIcon Data="{DynamicResource Icon.Sparkle}" />
                    </Button>
                    <Button
                        shell:KeyMap.ShortcutTip="Show/Hide Panel"
                        AutomationProperties.Name="Show or hide the panel"
                        Classes="toolbar"
                        Command="{Binding TogglePanelCommand}">
                        <PathIcon Data="{DynamicResource Icon.PanelBottom}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button
                        shell:KeyMap.ShortcutTip="Navigate Backward"
                        AutomationProperties.Name="Navigate Backward"
                        Classes="toolbar"
                        Command="{Binding NavigateBackCommand}">
                        <PathIcon Data="{DynamicResource Icon.ArrowLeft}" />
                    </Button>
                    <Button
                        shell:KeyMap.ShortcutTip="Navigate Forward"
                        AutomationProperties.Name="Navigate Forward"
                        Classes="toolbar"
                        Command="{Binding NavigateForwardCommand}">
                        <PathIcon Data="{DynamicResource Icon.ArrowRight}" />
                    </Button>
                    <Border Classes="toolbarSeparator" />
                    <Button
                        shell:KeyMap.ShortcutTip="Save"
                        AutomationProperties.Name="Save"
                        Classes="toolbar"
                        Command="{Binding DocumentCommands.SaveDocumentCommand}">
                        <PathIcon Data="{DynamicResource Icon.ContentSaveOutline}" />
                    </Button>
                    <Button
                        shell:KeyMap.ShortcutTip="Save All"
                        AutomationProperties.Name="Save All"
                        Classes="toolbar"
                        Command="{Binding DocumentCommands.SaveAllCommand}">
                        <PathIcon Data="{DynamicResource Icon.ContentSaveAllOutline}" />
                    </Button>
                    <Border Classes="toolbarSeparator" />
                    <Button
                        AutomationProperties.Name="Undo"
                        Classes="toolbar"
                        Command="{Binding EditorCommands.Undo}"
                        ToolTip.Tip="Undo (Ctrl+Z)">
                        <PathIcon Data="{DynamicResource Icon.Undo}">
                            <PathIcon.RenderTransform>
                                <RotateTransform Angle="-45" />
                            </PathIcon.RenderTransform>
                        </PathIcon>
                    </Button>
                    <Button
                        AutomationProperties.Name="Redo"
                        Classes="toolbar"
                        Command="{Binding EditorCommands.Redo}"
                        ToolTip.Tip="Redo (Ctrl+Y)">
                        <PathIcon Data="{DynamicResource Icon.Redo}">
                            <PathIcon.RenderTransform>
                                <RotateTransform Angle="45" />
                            </PathIcon.RenderTransform>
                        </PathIcon>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Document tabs and tool panels. Any tab can be dragged to another strip or out into its own window.  -->
        <DockControl
            Name="DockArea"
            Grid.Row="2"
            Layout="{Binding Docking.Root}" />

        <Border
            x:Name="StatusBar"
            Grid.Row="3"
            Padding="8,2"
            Background="{DynamicResource AppStatusBarBackgroundBrush}"
            TextElement.Foreground="{DynamicResource AppStatusBarForegroundBrush}">
            <!--
                The status bar (StatusBarViewModel), laid out like Rider's: the message on the left; on the right
                solution-wide analysis, the active document's errors, Ln/Col, line endings, encoding and indentation,
                the language server, and the Git branch.
            -->
            <Grid ColumnDefinitions="*,Auto">
                <DockPanel DataContext="{Binding StatusBar}" LastChildFill="True">
                    <DockPanel.Styles>
                        <Style Selector="DockPanel &gt; :is(Control)">
                            <Setter Property="DockPanel.Dock" Value="Right" />
                            <Setter Property="Margin" Value="8,0,0,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style Selector="Button.statusBarItem.off PathIcon">
                            <Setter Property="Opacity" Value="0.6" />
                        </Style>
                    </DockPanel.Styles>

                    <!--  Docked right, so the first one here is the rightmost.  -->
                    <!--  The language server: an icon while it runs; what it's doing while busy; why, if it stopped.  -->
                    <StackPanel
                        IsVisible="{Binding ShowLanguageServer}"
                        Orientation="Horizontal"
                        Spacing="4"
                        ToolTip.Tip="{Binding LanguageServerTip}">
                        <PathIcon
                            Width="14"
                            Height="14"
                            Data="{StaticResource Icon.CSharp}"
                            Foreground="{DynamicResource AppStatusBarForegroundBrush}"
                            IsVisible="{Binding !LanguageServerHasProblem}" />
                        <!--  Stopped or couldn't start: a warning sign instead, so it isn't mistaken for running.  -->
                        <PathIcon
                            Width="14"
                            Height="14"
                            Data="{StaticResource Icon.AlertOutline}"
                            Foreground="{DynamicResource AppStatusBarForegroundBrush}"
                            IsVisible="{Binding LanguageServerHasProblem}" />
                        <TextBlock
                            MaxWidth="360"
                            Text="{Binding LanguageServerText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        IsVisible="{Binding HasDocument}"
                        Text="{Binding IndentText}"
                        ToolTip.Tip="Indentation" />
                    <TextBlock
                        IsVisible="{Binding HasDocument}"
                        Text="{Binding EncodingText}"
                        ToolTip.Tip="File encoding" />
                    <TextBlock
                        IsVisible="{Binding HasDocument}"
                        Text="{Binding LineEndingText}"
                        ToolTip.Tip="Line endings" />
                    <TextBlock IsVisible="{Binding HasDocument}" Text="{Binding CaretText}" />
                    <TextBlock
                        IsVisible="{Binding HasDocument}"
                        Text="{Binding DocumentProblemsText}"
                        ToolTip.Tip="Errors and warnings in this file" />

                    <!--  Solution-wide analysis (Rider's "4 errors in 3 files"): click for its menu.  -->
                    <Button
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="Solution-wide analysis"
                        Classes="statusBarItem"
                        Classes.off="{Binding !IsSolutionAnalysisOn}"
                        ToolTip.Tip="{Binding SolutionAnalysisTip}">
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuItem
                                    Command="{Binding ShowSolutionErrorsCommand}"
                                    Header="Show _Errors in Problems"
                                    IsEnabled="{Binding IsSolutionAnalysisOn}" />
                                <MenuItem Command="{Binding RunCodeAnalysisCommand}" Header="Run Code _Analysis on Solution" />
                                <Separator />
                                <MenuItem
                                    Command="{Binding ToggleSolutionAnalysisCommand}"
                                    Header="Solution-Wide _Analysis"
                                    IsChecked="{Binding IsSolutionAnalysisOn, Mode=OneWay}"
                                    ToggleType="CheckBox" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Panel>
                                <PathIcon Data="{StaticResource Icon.CloseCircleOutline}" IsVisible="{Binding SolutionHasErrors}" />
                                <PathIcon Data="{StaticResource Icon.CheckCircle}" IsVisible="{Binding SolutionIsClean}" />
                                <PathIcon Data="{StaticResource Icon.CircleOutline}" IsVisible="{Binding SolutionIsPending}" />
                            </Panel>
                            <TextBlock Text="{Binding SolutionAnalysisText}" />
                        </StackPanel>
                    </Button>

                    <!--  The message fills what's left. Its tooltip lists the recent ones.  -->
                    <TextBlock
                        Margin="0"
                        Text="{Binding MessageText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="{Binding MessageHistory}" />
                </DockPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Git.IsRepository}"
                    Orientation="Horizontal"
                    Spacing="4"
                    ToolTip.Tip="Current Git branch">
                    <PathIcon
                        Width="12"
                        Height="12"
                        Data="{StaticResource Icon.SourceBranch}"
                        Foreground="{DynamicResource AppStatusBarForegroundBrush}" />
                    <TextBlock Text="{Binding Git.BranchText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
