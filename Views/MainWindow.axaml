<Window
    Background="{DynamicResource AppWindowBackgroundBrush}"
    Foreground="{DynamicResource AppForegroundBrush}"
    Title="AXamlIDE"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    x:Class="AXamlIDE.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:msg="using:AXamlIDE.Messages"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="auto,*,Auto">

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Grid.Row="0">
            <Border Background="{DynamicResource AppTitleBarBackgroundBrush}" Grid.ColumnSpan="4" />
            <!--
            The menus, Visual Studio / Rider style. Each item binds the same command as its button and key; the keys
            shown come from Shell/KeyMap.cs (KeyMap.ShowGesturesIn), except the editor's own (undo, clipboard).
            Build and Debug act on the startup project (the top bar's box).
            -->
            <Menu
                MinHeight="0"
                Padding="0"
                x:Name="MainMenu">
                <MenuItem Header="_File">
                    <MenuItem Command="{Binding Workspace.OpenFolderCommand}" Header="Open _Folder..." />
                    <MenuItem Command="{Binding Workspace.OpenSolutionCommand}" Header="Open _Solution..." />
                    <MenuItem Command="{Binding CloseSolutionCommand}" Header="_Close Solution" />
                    <Separator />
                    <MenuItem Command="{Binding Explorer.NewItemCommand}" Header="New _Item..." />
                    <MenuItem Command="{Binding Explorer.NewClassCommand}" Header="New C_lass..." />
                    <MenuItem Command="{Binding Explorer.NewFolderCommand}" Header="New Fol_der..." />
                    <Separator />
                    <MenuItem Command="{Binding DocumentCommands.SaveDocumentCommand}" Header="_Save" />
                    <MenuItem Command="{Binding DocumentCommands.CloseDocumentCommand}" Header="Close _Tab" />
                    <Separator />
                    <MenuItem Command="{Binding ExitCommand}" Header="E_xit" />
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem
                        Command="{Binding EditorCommands.Undo}"
                        Header="_Undo"
                        InputGesture="Ctrl+Z" />
                    <MenuItem
                        Command="{Binding EditorCommands.Redo}"
                        Header="_Redo"
                        InputGesture="Ctrl+Y" />
                    <Separator />
                    <MenuItem
                        Command="{Binding EditorCommands.Cut}"
                        Header="Cu_t"
                        InputGesture="Ctrl+X" />
                    <MenuItem
                        Command="{Binding EditorCommands.Copy}"
                        Header="_Copy"
                        InputGesture="Ctrl+C" />
                    <MenuItem
                        Command="{Binding EditorCommands.Paste}"
                        Header="_Paste"
                        InputGesture="Ctrl+V" />
                    <MenuItem
                        Command="{Binding EditorCommands.SelectAll}"
                        Header="Select _All"
                        InputGesture="Ctrl+A" />
                    <Separator />
                    <MenuItem Command="{Binding ShowFindInFilesCommand}" Header="Find in _Files..." />
                    <Separator />
                    <MenuItem Command="{Binding EditorCommands.RenameSymbol}" Header="Re_name Symbol..." />
                    <MenuItem Command="{Binding EditorCommands.QuickActions}" Header="_Quick Actions..." />
                    <MenuItem Command="{Binding DocumentCommands.FormatDocumentCommand}" Header="F_ormat Document" />
                    <MenuItem Command="{Binding EditorCommands.Completion}" Header="Co_mplete Word" />
                    <MenuItem Command="{Binding EditorCommands.SignatureHelp}" Header="Parameter _Info" />
                    <MenuItem Command="{Binding EditorCommands.InsertSnippet}" Header="Insert Sn_ippet..." />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem
                        Command="{Binding ShowToolCommand}"
                        CommandParameter="{x:Static msg:ToolTab.Explorer}"
                        Header="_Explorer" />
                    <MenuItem
                        Command="{Binding ShowToolCommand}"
                        CommandParameter="{x:Static msg:ToolTab.Git}"
                        Header="_Git" />
                    <MenuItem Command="{Binding Properties.ShowCommand}" Header="P_roperties" />
                    <Separator />
                    <MenuItem
                        Command="{Binding ShowToolCommand}"
                        CommandParameter="{x:Static msg:ToolTab.Problems}"
                        Header="_Problems" />
                    <MenuItem
                        Command="{Binding ShowToolCommand}"
                        CommandParameter="{x:Static msg:ToolTab.Output}"
                        Header="_Output" />
                    <MenuItem
                        Command="{Binding ShowToolCommand}"
                        CommandParameter="{x:Static msg:ToolTab.Console}"
                        Header="_Debug Console" />
                    <MenuItem Command="{Binding ShowFindInFilesCommand}" Header="_Search" />
                    <Separator />
                    <MenuItem Command="{Binding ToggleExplorerCommand}" Header="Show/Hide Side _Bar" />
                    <MenuItem Command="{Binding ToggleSolutionExplorerSideCommand}" Header="Move Side Bar to Other Side" />
                </MenuItem>
                <MenuItem Header="_Navigate">
                    <MenuItem Command="{Binding EditorCommands.QuickOpen}" Header="Go to _File..." />
                    <MenuItem Command="{Binding EditorCommands.WorkspaceSymbols}" Header="Go to _Symbol..." />
                    <Separator />
                    <MenuItem Command="{Binding EditorCommands.GoToDefinition}" Header="Go to _Definition" />
                    <MenuItem Command="{Binding EditorCommands.FindReferences}" Header="Find All _References" />
                    <Separator />
                    <MenuItem
                        Command="{Binding Problems.NavigateDiagnosticCommand}"
                        CommandParameter="{x:True}"
                        Header="_Next Problem" />
                    <MenuItem
                        Command="{Binding Problems.NavigateDiagnosticCommand}"
                        CommandParameter="{x:False}"
                        Header="_Previous Problem" />
                </MenuItem>
                <MenuItem Header="_Build">
                    <MenuItem Command="{Binding Run.BuildCommand}" Header="_Build" />
                    <MenuItem
                        Command="{Binding Run.BuildProjectCommand}"
                        Header="Build _Selected Project"
                        IsEnabled="{Binding Workspace.SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Separator />
                    <MenuItem Command="{Binding Publish.PublishCurrentProjectCommand}" Header="_Publish Selected Project..." />
                </MenuItem>
                <MenuItem Header="_Debug">
                    <MenuItem
                        Command="{Binding Run.StartDebuggingCommand}"
                        Header="_Start Debugging"
                        InputGesture="F5" />
                    <MenuItem Command="{Binding Run.RunProjectCommand}" Header="Start _Without Debugging" />
                    <Separator />
                    <MenuItem
                        Command="{Binding Run.ContinueDebuggingCommand}"
                        Header="_Continue"
                        InputGesture="F5" />
                    <MenuItem Command="{Binding Run.PauseDebuggingCommand}" Header="_Pause" />
                    <MenuItem
                        Command="{Binding Run.StopRunningProjectCommand}"
                        Header="S_top"
                        IsEnabled="{Binding Run.IsRunning}" />
                    <MenuItem Command="{Binding Run.RestartDebuggingCommand}" Header="_Restart" />
                    <Separator />
                    <MenuItem Command="{Binding Run.StepOverCommand}" Header="Step _Over" />
                    <MenuItem Command="{Binding Run.StepIntoCommand}" Header="Step _Into" />
                    <MenuItem Command="{Binding Run.StepOutCommand}" Header="Step O_ut" />
                    <Separator />
                    <MenuItem Command="{Binding EditorCommands.AddWatch}" Header="Add _Watch" />
                    <MenuItem Header="Win_dows">
                        <MenuItem
                            Command="{Binding ShowToolCommand}"
                            CommandParameter="{x:Static msg:ToolTab.Locals}"
                            Header="_Locals" />
                        <MenuItem
                            Command="{Binding ShowToolCommand}"
                            CommandParameter="{x:Static msg:ToolTab.Watch}"
                            Header="_Watch" />
                        <MenuItem
                            Command="{Binding ShowToolCommand}"
                            CommandParameter="{x:Static msg:ToolTab.CallStack}"
                            Header="_Call Stack" />
                        <MenuItem
                            Command="{Binding ShowToolCommand}"
                            CommandParameter="{x:Static msg:ToolTab.Console}"
                            Header="Debug C_onsole" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Command="{Binding NuGet.ManagePackagesForCurrentProjectCommand}" Header="Manage _NuGet Packages..." />
                    <MenuItem Command="{Binding RestartLanguageServicesCommand}" Header="_Restart Language Servers" />
                    <MenuItem Command="{Binding EditSnippetsCommand}" Header="Edit S_nippets..." />
                    <Separator />
                    <MenuItem Command="{Binding OpenSettingsCommand}" Header="_Settings..." />
                </MenuItem>
            </Menu>
            <!--
            Visual Studio's toolbar: Build, the startup project, the configuration, play (Start Debugging; a stop
            square while it runs) and the hollow play (Start Without Debugging). Same commands as the menus and keys.
            -->
            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    AutomationProperties.Name="Build"
                    Background="Transparent"
                    Command="{Binding Run.BuildCommand}"
                    Padding="6,0"
                    ToolTip.Tip="Build (Ctrl+Shift+B)"
                    VerticalAlignment="Stretch">
                    <PathIcon
                        Data="{StaticResource Icon.Hammer}"
                        Height="16"
                        Width="16" />
                </Button>
                <ComboBox
                    AutomationProperties.Name="Startup project"
                    FontSize="11"
                    IsEnabled="{Binding !Run.IsRunning}"
                    ItemsSource="{Binding Run.StartupProjects}"
                    Margin="0,3"
                    MaxWidth="220"
                    MinHeight="0"
                    MinWidth="140"
                    Padding="8,2"
                    VerticalAlignment="Stretch"
                    PlaceholderText="Startup project"
                    SelectedItem="{Binding Run.StartupProject}"
                    ToolTip.Tip="Startup project: what Run and Debug start"
                    VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:StartupProjectItem">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox
                    AutomationProperties.Name="Configuration"
                    FontSize="11"
                    IsEnabled="{Binding !Run.IsRunning}"
                    ItemsSource="{Binding Run.Configurations}"
                    Margin="0,3"
                    MinHeight="0"
                    Padding="8,5"
                    VerticalAlignment="Center"
                    SelectedItem="{Binding Run.Configuration}"
                    ToolTip.Tip="Build configuration"
                    VerticalContentAlignment="Center" />
                <Button
                    AutomationProperties.Name="{Binding Run.StartOrStopToolTip}"
                    Background="Transparent"
                    Command="{Binding Run.StartOrStopCommand}"
                    Padding="6,0"
                    ToolTip.Tip="{Binding Run.StartOrStopToolTip}"
                    VerticalAlignment="Stretch">
                    <Panel>
                        <PathIcon
                            Data="{StaticResource Icon.Play}"
                            Foreground="{DynamicResource DebugStartBrush}"
                            Height="16"
                            IsVisible="{Binding !Run.IsRunning}"
                            Width="16" />
                        <PathIcon
                            Data="{StaticResource Icon.Stop}"
                            Foreground="{DynamicResource DebugStopBrush}"
                            Height="16"
                            IsVisible="{Binding Run.IsRunning}"
                            Width="16" />
                    </Panel>
                </Button>
                <Button
                    AutomationProperties.Name="Start Without Debugging"
                    Background="Transparent"
                    Command="{Binding Run.RunProjectCommand}"
                    IsEnabled="{Binding !Run.IsRunning}"
                    Padding="6,0"
                    ToolTip.Tip="Start Without Debugging (Ctrl+F5)"
                    VerticalAlignment="Stretch">
                    <PathIcon
                        Data="{StaticResource Icon.PlayOutline}"
                        Foreground="{DynamicResource DebugStartBrush}"
                        Height="16"
                        Width="16" />
                </Button>
            </StackPanel>

            <!--  Search the workspace; results open in the Search window.  -->
            <TextBox
                Classes="SearchBox"
                FontSize="11"
                Grid.Column="2"
                Margin="4,3"
                MinHeight="0"
                Text="{Binding TopBarSearchText}"
                PlaceholderText="Search in files (Ctrl+Shift+F)"
                Width="280">
                <TextBox.KeyBindings>
                    <KeyBinding Command="{Binding SearchFromTopBarCommand}" Gesture="Enter" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button
                AutomationProperties.Name="Settings"
                Background="{DynamicResource AppTitleBarBackgroundBrush}"
                Command="{Binding OpenSettingsCommand}"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                Margin="0"
                Padding="4"
                ToolTip.Tip="Settings"
                VerticalAlignment="Stretch">
                <PathIcon
                    Data="{DynamicResource Icon.Cog}"
                    Foreground="{DynamicResource ThemeForegroundBrush}"
                    Height="16"
                    Width="16" />
            </Button>
        </Grid>

        <!--  Activity bar beside the dock area (mirrored with the explorer setting).  -->
        <Grid
            ColumnDefinitions="30,*"
            Grid.Row="1"
            Name="ContentGrid">

            <Border
                Background="{DynamicResource AppActivityBarBackgroundBrush}"
                Grid.Column="0"
                MinWidth="0"
                Name="ActivityBar"
                Padding="0">
                <StackPanel Margin="0" Spacing="4">
                    <Button
                        AutomationProperties.Name="Move explorer to other side"
                        Background="Transparent"
                        Command="{Binding ToggleSolutionExplorerSideCommand}"
                        Padding="8"
                        ToolTip.Tip="Move explorer to the other side">
                        <PathIcon
                            Data="{DynamicResource Icon.Transfer}"
                            Height="16"
                            Width="16" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Explorer"
                        Background="Transparent"
                        Command="{Binding ToggleExplorerCommand}"
                        Padding="8"
                        ToolTip.Tip="Explorer">
                        <PathIcon
                            Data="{DynamicResource Icon.FolderMultipleOutline}"
                            Height="16"
                            Width="16" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Search in files"
                        Background="Transparent"
                        Command="{Binding ShowFindInFilesCommand}"
                        Padding="8"
                        ToolTip.Tip="Search in files">
                        <PathIcon
                            Data="{DynamicResource Icon.Search}"
                            Height="16"
                            Width="16" />
                    </Button>
                </StackPanel>
            </Border>

            <!--  Document tabs and tool panels. Any tab can be dragged to another strip or out into its own window.  -->
            <DockControl
                Grid.Column="1"
                Layout="{Binding Docking.Root}"
                Name="DockArea" />
        </Grid>

        <Border
            Background="{DynamicResource AppStatusBarBackgroundBrush}"
            Grid.Row="2"
            Padding="8,2"
            TextElement.Foreground="{DynamicResource AppStatusBarForegroundBrush}"
            x:Name="StatusBar">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding StatusText}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,16,0"
                    Text="{Binding DiagnosticsText}" />
                <TextBlock Grid.Column="2" Text="{Binding CaretText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
