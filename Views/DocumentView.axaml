<UserControl
    x:Class="AXamlIDE.Views.DocumentView"
    x:DataType="vm:DocumentDockable"
    xmlns="https://github.com/avaloniaui"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Styles>
        <Style Selector="Border#DocumentBar ToggleButton, Border#DocumentBar Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Border.DiskBanner">
            <Setter Property="Background" Value="{DynamicResource AppDocumentBarBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DiagnosticWarningBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Border.DiskBanner PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DiagnosticWarningBrush}" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="Border.DiskBanner TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.DiskBanner Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Button#SplitDirectionButton PathIcon">
            <Setter Property="Data" Value="{StaticResource Icon.ArrowUpDown}" />
        </Style>
        <Style Selector="Button#SplitDirectionButton.stacked PathIcon">
            <Setter Property="Data" Value="{StaticResource Icon.ArrowLeftRight}" />
        </Style>
    </UserControl.Styles>

    <!--
    One document tab: a bar (the outline drop-down while this is the selected tab; the preview buttons for AXAML),
    its editor and, for AXAML, the preview (code only / split / design only).
    -->
    <DockPanel>
        <Border
            Background="{DynamicResource AppDocumentBarBackgroundBrush}"
            DockPanel.Dock="Top"
            Name="DocumentBar"
            Padding="4,2">
            <DockPanel>
                <StackPanel
                    DockPanel.Dock="Right"
                    IsVisible="{Binding IsPreviewable}"
                    Name="PreviewButtons"
                    Orientation="Horizontal"
                    Spacing="2">
                    <ToggleButton
                        Command="{Binding SetPreviewModeCommand}"
                        CommandParameter="{x:Static models:PreviewMode.Code}"
                        Content="Code"
                        Name="CodeButton"
                        ToolTip.Tip="Code only" />
                    <ToggleButton
                        Command="{Binding SetPreviewModeCommand}"
                        CommandParameter="{x:Static models:PreviewMode.Split}"
                        Content="Split"
                        Name="SplitButton"
                        ToolTip.Tip="Code and preview" />
                    <ToggleButton
                        Command="{Binding SetPreviewModeCommand}"
                        CommandParameter="{x:Static models:PreviewMode.Design}"
                        Content="Design"
                        Name="DesignButton"
                        ToolTip.Tip="Preview only" />
                    <Button
                        Command="{Binding TogglePreviewSplitCommand}"
                        Margin="6,0,0,0"
                        Name="SplitDirectionButton">
                        <PathIcon Width="15" Height="15" Name="SplitDirectionButtonIcon"/>
                    </Button>
                    <Button
                        Command="{Binding SwapPreviewSideCommand}"
                        Name="SwapSidesButton">
                        <PathIcon Width="15" Height="15" Data="{StaticResource Icon.ArrowLeftRight}"/>
                    </Button>
                </StackPanel>
                <ContentControl HorizontalAlignment="Right" Name="OutlineHost" />
            </DockPanel>
        </Border>

        <!--
            The file changed (or went) on disk under unsaved edits. Theme colours only: the doc bar's background with
            the warning colour as an accent, since every theme has those.
        -->
        <Border
            Classes="DiskBanner"
            DockPanel.Dock="Top"
            IsVisible="{Binding Document.ChangedOnDisk}">
            <DockPanel>
                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Command="{Binding ReloadFromDiskCommand}"
                        Content="Reload"
                        ToolTip.Tip="Take the version on disk (Ctrl+Z brings your edits back)" />
                    <Button
                        Command="{Binding KeepMineCommand}"
                        Content="Keep mine"
                        ToolTip.Tip="Keep your edits; saving overwrites the file on disk" />
                </StackPanel>
                <PathIcon Data="{StaticResource Icon.AlertOutline}" />
                <TextBlock Text="This file was changed outside the IDE, and you have unsaved edits." />
            </DockPanel>
        </Border>
        <Border
            Classes="DiskBanner"
            DockPanel.Dock="Top"
            IsVisible="{Binding Document.DeletedOnDisk}">
            <DockPanel>
                <PathIcon Data="{StaticResource Icon.AlertOutline}" />
                <TextBlock Text="This file was deleted on disk. Save to write it again." />
            </DockPanel>
        </Border>

        <!--  Rows or columns are set in code-behind from the tab's PreviewMode / PreviewSplit.  -->
        <Grid Name="Surface">
            <ContentControl Name="EditorHost" />
            <GridSplitter
                Background="{DynamicResource EditorSplitterBrush}"
                Name="Splitter"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="False" />
            <!--  This tab's own preview (PreviewPaneView), set in code-behind for AXAML files.  -->
            <ContentControl Name="PreviewHost" />
        </Grid>
    </DockPanel>
</UserControl>
