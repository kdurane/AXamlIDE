<Window
    CanResize="False"
    CornerRadius="8"
    Height="35"
    ShowActivated="False"
    ShowInTaskbar="False"
    Title="Debug"
    Width="185"
    WindowDecorations="None"
    WindowStartupLocation="Manual"
    x:Class="AXamlIDE.Views.DebugToolbarWindow"
    x:DataType="viewmodels:RunViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:viewmodels="clr-namespace:AXamlIDE.ViewModels"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  DataContext is set in code to RunViewModel (see DebugToolbarController).  -->
    <Window.Styles>
        <Style Selector="Button.dbg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.dbg ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.dbg PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.pause &gt; PathIcon">
            <Setter Property="Data" Value="{StaticResource Icon.Pause}" />
        </Style>
        <Style Selector="Button.play &gt; PathIcon">
            <Setter Property="Data" Value="{StaticResource Icon.Play}" />
        </Style>
    </Window.Styles>

    <!--  Keyboard shortcuts come from Shell/KeyMap.cs, attached to this window when it opens.  -->

    <!--  Drag anywhere on the border that isn't a button  -->
    <Border
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        BorderBrush="{DynamicResource SystemControlHighlightBaseMediumLowBrush}"
        BorderThickness="1"
        Padding="4"
        x:Name="Root">
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                Cursor="SizeAll"
                FontSize="16"
                Opacity="0.5"
                Text="⋮⋮"
                VerticalAlignment="Center" />

            <Button
                Classes="dbg"
                Classes.pause="{Binding !IsDebugStopped}"
                Classes.play="{Binding IsDebugStopped}"
                Command="{Binding ContinueOrPauseDebuggingCommand}"
                ToolTip.Tip="Continue (F5) / Pause">
                <PathIcon Foreground="LightBlue" />
            </Button>
            <Button
                Classes="dbg"
                Command="{Binding StepOverCommand}"
                IsEnabled="{Binding IsDebugStopped}"
                ToolTip.Tip="Step Over (F10)">
                <PathIcon Data="{StaticResource Icon.DebugStepOver}" Width="18" />
            </Button>
            <Button
                Classes="dbg"
                Command="{Binding StepIntoCommand}"
                IsEnabled="{Binding IsDebugStopped}"
                ToolTip.Tip="Step Into (F11)">
                <PathIcon Data="{StaticResource Icon.DebugStepInto}" />
            </Button>
            <Button
                Classes="dbg"
                Command="{Binding StepOutCommand}"
                IsEnabled="{Binding IsDebugStopped}"
                ToolTip.Tip="Step Out (Shift+F11)">
                <PathIcon Data="{StaticResource Icon.DebugStepOut}" />
            </Button>

            <Button
                Classes="dbg"
                Command="{Binding RestartDebuggingCommand}"
                IsEnabled="{Binding IsDebugging}"
                ToolTip.Tip="Restart (Ctrl+Shift+F5)">
                <PathIcon Data="{StaticResource Icon.Restart}" Foreground="SeaGreen" />
            </Button>

            <Button
                Classes="dbg"
                Command="{Binding StopRunningProjectCommand}"
                IsEnabled="{Binding IsDebugging}"
                ToolTip.Tip="Stop (Shift+F5)">
                <PathIcon
                    Data="{StaticResource Icon.SquareOutline}"
                    Foreground="IndianRed"
                    Width="14" />
            </Button>
        </StackPanel>
    </Border>
</Window>
