<Window
    CanResize="False"
    CornerRadius="8"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    Title="Debug"
    WindowDecorations="None"
    WindowStartupLocation="Manual"
    x:Class="AXamlIDE.Views.DebugToolbarWindow"
    x:DataType="vm:RunViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="clr-namespace:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  DataContext is set in code to RunViewModel (see MainWindow).  -->
    <Window.Styles>
        <Style Selector="Button.dbg">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <!--  Keys also work while this window has focus (clicking a button moves focus here)  -->
    <Window.KeyBindings>
        <KeyBinding Command="{Binding ContinueDebuggingCommand}" Gesture="F5" />
        <KeyBinding Command="{Binding StepOverCommand}" Gesture="F10" />
        <KeyBinding Command="{Binding StepIntoCommand}" Gesture="F11" />
        <KeyBinding Command="{Binding StepOutCommand}" Gesture="Shift+F11" />
        <KeyBinding Command="{Binding StopRunningProjectCommand}" Gesture="Shift+F5" />
    </Window.KeyBindings>

    <!--  Drag anywhere on the border that isn't a button  -->
    <Border
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        BorderBrush="{DynamicResource SystemControlHighlightBaseMediumLowBrush}"
        BorderThickness="1"
        Padding="4"
        x:Name="Root">
        <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock
                FontSize="10"
                Text="{Binding DebugStatus}"
                VerticalAlignment="Center" />
            <CheckBox IsChecked="{Binding IsDebugStopped, Mode=OneWay}" IsHitTestVisible="False" />
            <TextBlock
                Cursor="SizeAll"
                Margin="6,0"
                Opacity="0.5"
                Text="⋮⋮"
                VerticalAlignment="Center" />

            <Button
                Classes="dbg"
                Command="{Binding ContinueDebuggingCommand}"
                Content="Continue"
                IsEnabled="{Binding IsDebugStopped}"
                ToolTip.Tip="Continue (F5)" />
            <Button
                Classes="dbg"
                Command="{Binding StepOverCommand}"
                Content="Over"
                IsEnabled="{Binding IsDebugStopped}"
                ToolTip.Tip="Step Over (F10)" />
            <Button
                Classes="dbg"
                Command="{Binding StepIntoCommand}"
                Content="Into"
                IsEnabled="{Binding IsDebugStopped}"
                ToolTip.Tip="Step Into (F11)" />
            <Button
                Classes="dbg"
                Command="{Binding StepOutCommand}"
                Content="Out"
                IsEnabled="{Binding IsDebugStopped}"
                ToolTip.Tip="Step Out (Shift+F11)" />

            <Rectangle
                Fill="{DynamicResource SystemControlHighlightBaseMediumLowBrush}"
                Margin="4,2"
                Width="1" />

            <Button
                Classes="dbg"
                Command="{Binding StopRunningProjectCommand}"
                Content="Stop"
                Foreground="IndianRed"
                IsEnabled="{Binding IsDebugging}"
                ToolTip.Tip="Stop (Shift+F5)" />
        </StackPanel>
    </Border>
</Window>
