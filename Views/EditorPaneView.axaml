<UserControl
    x:Class="AXamlIDE.Views.EditorPaneView"
    xmlns="https://github.com/avaloniaui"
    xmlns:edit="using:AvaloniaEdit"
    xmlns:editing="using:AvaloniaEdit.Editing"
    xmlns:codeLens="using:AXamlIDE.Editor.CodeLens"
    xmlns:highlighting="using:AXamlIDE.Editor.Highlighting"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  No bindings to a parent view model: everything goes through EditorServices (see Initialize).  -->
    <Grid ColumnDefinitions="*,Auto">
        <edit:TextEditor
            FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
            FontSize="13"
            FontWeight="Light"
            HorizontalScrollBarVisibility="Auto"
            Margin="0"
            Name="Editor"
            ShowLineNumbers="True"
            VerticalScrollBarVisibility="Hidden">
            <edit:TextEditor.ContextFlyout>
                <MenuFlyout Opening="OnContextMenuOpening">
                    <MenuItem
                        Click="OnCopyClick"
                        Header="Copy"
                        InputGesture="ctrl+C" />
                    <MenuItem
                        Click="OnCutClick"
                        Header="Cut"
                        InputGesture="ctrl+X" />
                    <MenuItem
                        Click="OnPasteClick"
                        Header="Paste"
                        InputGesture="ctrl+V" />
                    <MenuItem Header="-" />
                    <!--  C# only (shown by OnContextMenuOpening): renames the symbol and every reference to it  -->
                    <MenuItem
                        Click="OnRenameClick"
                        Header="Rename..."
                        InputGesture="Ctrl+R"
                        Name="RenameMenuItem" />
                    <MenuItem
                        Click="OnCodeActionsClick"
                        Header="Quick Actions..."
                        InputGesture="Ctrl+." />
                    <MenuItem Click="OnFormatClick" Header="Format Document" />
                    <!--  While paused in C#: watch the selection or the expression at the caret  -->
                    <MenuItem
                        Click="OnAddWatchClick"
                        Header="Add Watch"
                        InputGesture="Shift+F9"
                        Name="AddWatchMenuItem" />
                    <MenuItem Header="-" />
                    <MenuItem
                        Click="OnSelectAllClick"
                        Header="Select All"
                        InputGesture="ctrl+A" />
                </MenuFlyout>
            </edit:TextEditor.ContextFlyout>
            <edit:TextEditor.Styles>
                <Style Selector="editing|LineNumberMargin">
                    <Setter Property="MinWidthInDigits" Value="3" />
                </Style>
            </edit:TextEditor.Styles>
        </edit:TextEditor>

        <!--
            The vertical scrollbar, with the whole file mapped on it: diagnostics, occurrences, caret
            (Editor/Highlighting/OverviewRuler). The editor's own one is Hidden (not Disabled: that stops scrolling).
        -->
        <highlighting:OverviewRuler
            Grid.Column="1"
            Name="OverviewRuler"
            Width="14" />

        <!--
        The hover card (Editor/Hover/HoverController fills and places it). A popup has to be in the tree to open.
        Light dismiss: a click outside closes it and still reaches the editor. It never takes focus.
        -->
        <Popup
            Focusable="False"
            IsLightDismissEnabled="True"
            Name="HoverPopup"
            OverlayDismissEventPassThrough="True"
            Placement="AnchorAndGravity"
            PlacementAnchor="BottomLeft"
            PlacementConstraintAdjustment="FlipY, SlideX"
            PlacementGravity="BottomRight" />

        <!--  The colour picker behind the colour swatches (ColorSwatchController). Picking rewrites the colour in the code.  -->
        <Popup
            IsLightDismissEnabled="True"
            Name="ColorPopup"
            Placement="AnchorAndGravity"
            PlacementAnchor="TopLeft"
            PlacementConstraintAdjustment="FlipY, SlideX"
            PlacementGravity="BottomRight">
            <Border
                Background="{DynamicResource HoverBackgroundBrush}"
                BorderBrush="{DynamicResource HoverBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
                <ColorView IsAccentColorsVisible="False" Name="ColorPicker" />
            </Border>
        </Popup>

        <!--
            A code lens's references ("3 references" clicked; Editor/CodeLens/CodeLensController fills and places it).
            Click a line, or Enter, to go there; click outside or Escape to close.
        -->
        <Popup
            IsLightDismissEnabled="True"
            Name="ReferencesPopup"
            Placement="AnchorAndGravity"
            PlacementAnchor="TopLeft"
            PlacementConstraintAdjustment="FlipY, SlideX"
            PlacementGravity="BottomRight">
            <Border
                Background="{DynamicResource HoverBackgroundBrush}"
                BorderBrush="{DynamicResource HoverBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4"
                TextElement.Foreground="{DynamicResource HoverForegroundBrush}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        FontWeight="SemiBold"
                        Margin="8,4,8,6"
                        Name="ReferencesTitle" />
                    <ListBox
                        Background="Transparent"
                        MaxHeight="320"
                        MaxWidth="760"
                        MinWidth="420"
                        Name="ReferencesList">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="codeLens:ReferenceRow">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock
                                        Margin="0,0,16,0"
                                        Opacity="0.75"
                                        Text="{Binding Place}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Preview}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
