<UserControl
    x:Class="AXamlIDE.Views.EditorPaneView"
    xmlns="https://github.com/avaloniaui"
    xmlns:edit="using:AvaloniaEdit"
    xmlns:editing="using:AvaloniaEdit.Editing"
    xmlns:codeLens="using:AXamlIDE.Editor.CodeLens"
    xmlns:highlighting="using:AXamlIDE.Editor.Highlighting"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:shell="using:AXamlIDE.Shell"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  No bindings to a parent view model: everything goes through EditorServices (see Initialize).  -->
    <Grid ColumnDefinitions="*,Auto">
        <edit:TextEditor
            FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
            FontSize="13"
            FontWeight="Light"
            HorizontalScrollBarVisibility="Auto"
            Margin="0"
            Name="Editor"
            ShowLineNumbers="True"
            VerticalScrollBarVisibility="Hidden">
            <edit:TextEditor.ContextFlyout>
                <MenuFlyout Opening="OnContextMenuOpening">
                    <MenuItem
                        Click="OnCopyClick"
                        Header="Copy"
                        InputGesture="ctrl+C" />
                    <MenuItem
                        Click="OnCutClick"
                        Header="Cut"
                        InputGesture="ctrl+X" />
                    <MenuItem
                        Click="OnPasteClick"
                        Header="Paste"
                        InputGesture="ctrl+V" />
                    <MenuItem Header="-" />
                    <!--  C# only (shown by OnContextMenuOpening): renames the symbol and every reference to it  -->
                    <MenuItem
                        Click="OnRenameClick"
                        Header="Rename..."
                        Name="RenameMenuItem"
                        shell:KeyMap.CommandId="Edit.Rename" />
                    <MenuItem
                        Click="OnCodeActionsClick"
                        Header="Quick Actions..."
                        shell:KeyMap.CommandId="Edit.QuickActions" />
                    <MenuItem
                        Click="OnFormatClick"
                        Header="Format Document"
                        shell:KeyMap.CommandId="Edit.FormatDocument" />
                    <MenuItem
                        Click="OnToggleCommentClick"
                        Header="Toggle Comment"
                        Name="ToggleCommentMenuItem"
                        shell:KeyMap.CommandId="Edit.ToggleComment" />
                    <MenuItem
                        Click="OnInsertSnippetClick"
                        Header="Insert Snippet..."
                        shell:KeyMap.CommandId="Edit.InsertSnippet" />
                    <!--  While paused in C#: watch the selection or the expression at the caret  -->
                    <MenuItem
                        Click="OnAddWatchClick"
                        Header="Add Watch"
                        Name="AddWatchMenuItem"
                        shell:KeyMap.CommandId="Debug.AddWatch" />
                    <MenuItem Header="-" />
                    <MenuItem
                        Click="OnSelectAllClick"
                        Header="Select All"
                        InputGesture="ctrl+A" />
                </MenuFlyout>
            </edit:TextEditor.ContextFlyout>
            <edit:TextEditor.Styles>
                <Style Selector="editing|LineNumberMargin">
                    <Setter Property="MinWidthInDigits" Value="3" />
                </Style>
            </edit:TextEditor.Styles>
        </edit:TextEditor>

        <!--
        The vertical scrollbar, with the whole file mapped on it: diagnostics, occurrences, caret
        (Editor/Highlighting/OverviewRuler). The editor's own one is Hidden (not Disabled: that stops scrolling).
        -->
        <highlighting:OverviewRuler
            Grid.Column="1"
            Name="OverviewRuler"
            Width="14" />

        <!--
        The hover card (Editor/Hover/HoverController fills and places it). A popup has to be in the tree to open.
        Light dismiss: a click outside closes it and still reaches the editor. It never takes focus.
        -->
        <Popup
            Focusable="False"
            IsLightDismissEnabled="True"
            Name="HoverPopup"
            OverlayDismissEventPassThrough="True"
            Placement="AnchorAndGravity"
            PlacementAnchor="BottomLeft"
            PlacementConstraintAdjustment="FlipY, SlideX"
            PlacementGravity="BottomRight" />

        <!--  The colour picker behind the colour swatches (ColorSwatchController). Picking rewrites the colour in the code.  -->
        <Popup
            IsLightDismissEnabled="True"
            Name="ColorPopup"
            Placement="AnchorAndGravity"
            PlacementAnchor="TopLeft"
            PlacementConstraintAdjustment="FlipY, SlideX"
            PlacementGravity="BottomRight">
            <Border
                Background="{DynamicResource HoverBackgroundBrush}"
                BorderBrush="{DynamicResource HoverBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
                <ColorView IsAccentColorsVisible="False" Name="ColorPicker" />
            </Border>
        </Popup>

        <!--
        A code lens's references ("3 references" clicked; Editor/CodeLens/CodeLensController fills and places it).
        Click a line, or Enter, to go there; click outside or Escape to close.
        -->
        <Popup
            IsLightDismissEnabled="True"
            Name="ReferencesPopup"
            Placement="AnchorAndGravity"
            PlacementAnchor="TopLeft"
            PlacementConstraintAdjustment="FlipY, SlideX"
            PlacementGravity="BottomRight">
            <Border
                Background="{DynamicResource HoverBackgroundBrush}"
                BorderBrush="{DynamicResource HoverBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4"
                TextElement.Foreground="{DynamicResource HoverForegroundBrush}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        FontWeight="SemiBold"
                        Margin="8,4,8,6"
                        Name="ReferencesTitle" />
                    <!--  By file (Editor/CodeLens/CodeLensController.GroupAsync), as VS Code's peek and Rider's usages list  -->
                    <TreeView
                        Classes="compact"
                        MaxHeight="360"
                        MaxWidth="760"
                        MinWidth="420"
                        Name="ReferencesTree">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="models:ReferenceGroup" ItemsSource="{Binding Items}">
                                <DockPanel>
                                    <Border Classes="CountBadge" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding Count}" />
                                    </Border>
                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                        <Run FontWeight="SemiBold" Text="{Binding Name}" />
                                        <Run Text="  " />
                                        <Run FontSize="11" Foreground="{DynamicResource CompletionDetailForegroundBrush}" Text="{Binding Folder}" />
                                    </TextBlock>
                                </DockPanel>
                            </TreeDataTemplate>
                            <DataTemplate DataType="models:ReferenceItem">
                                <DockPanel>
                                    <TextBlock
                                        Classes="LineNumber"
                                        DockPanel.Dock="Left"
                                        Text="{Binding LineNumber}" />
                                    <!--  The Runs touch: whitespace between them in the XAML would show as spaces in the code  -->
                                    <TextBlock FontFamily="{Binding #Editor.FontFamily}" FontSize="12" TextTrimming="CharacterEllipsis"><Run Text="{Binding Preview.Before}" /><Run Background="{DynamicResource WordHighlightBrush}" Text="{Binding Preview.Match}" /><Run Text="{Binding Preview.After}" /></TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
