<!--
    A debugger visualizer tab (VisualizerDockable): a collection as a sortable table with a filter box and Open in
    Excel / as CSV, or a string as text (Text / JSON / XML). The table's columns are made in code (VisualizerView.axaml.cs):
    they come from the data.
-->
<UserControl
    x:Class="AXamlIDE.Views.VisualizerView"
    x:DataType="vm:VisualizerDockable"
    xmlns="https://github.com/avaloniaui"
    xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{DynamicResource DockSurfaceEditorBrush}">
        <!--  Toolbar: what it is, how many, and the actions for the kind shown.  -->
        <Grid
            ColumnDefinitions="Auto,*,Auto"
            DockPanel.Dock="Top"
            Margin="8,6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="{Binding Expression}" />
                <TextBlock Opacity="0.75" Text="{Binding Status}" />
                <TextBlock
                    Foreground="{DynamicResource DiagnosticWarningBrush}"
                    IsVisible="{Binding IsStale}"
                    Text="The debuggee has moved on: these values are from an earlier stop." />
                <TextBlock
                    IsVisible="{Binding ExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Opacity="0.75"
                    Text="{Binding ExportStatus}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6">
                <ComboBox
                    IsVisible="{Binding IsString}"
                    ItemsSource="{Binding Formats}"
                    MinHeight="0"
                    Padding="8,3"
                    SelectedItem="{Binding Format}"
                    ToolTip.Tip="Show the string as it is, formatted, or (a JSON array) as a table" />
                <TextBox
                    IsVisible="{Binding IsTable}"
                    MinHeight="0"
                    Padding="6,3"
                    PlaceholderText="Filter"
                    Text="{Binding Filter}"
                    Width="200" />
                <Button
                    Command="{Binding OpenInExcelCommand}"
                    IsVisible="{Binding IsTable}"
                    Padding="8,3"
                    ToolTip.Tip="Open the rows shown in a new workbook (.xlsx) in your spreadsheet app">
                    Open in Excel
                </Button>
                <Button
                    Command="{Binding OpenAsCsvCommand}"
                    IsVisible="{Binding IsTable}"
                    Padding="8,3"
                    ToolTip.Tip="Open the rows shown as a .csv file in your spreadsheet app">
                    Open as CSV
                </Button>
                <Button
                    Command="{Binding CopyTextCommand}"
                    IsVisible="{Binding IsText}"
                    Padding="8,3">
                    Copy
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar
            DockPanel.Dock="Top"
            Height="2"
            IsIndeterminate="True"
            IsVisible="{Binding IsLoading}"
            MinHeight="0" />

        <Panel>
            <DataGrid
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                GridLinesVisibility="All"
                IsReadOnly="True"
                IsVisible="{Binding IsTable}"
                ItemsSource="{Binding Rows}"
                Name="Table" />
            <avaloniaEdit:TextEditor
                FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                IsReadOnly="True"
                IsVisible="{Binding IsText}"
                Name="TextView"
                ShowLineNumbers="True"
                WordWrap="True" />
        </Panel>
    </DockPanel>
</UserControl>
