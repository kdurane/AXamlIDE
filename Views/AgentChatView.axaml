<!--
    The Claude panel (DataContext: AgentChatViewModel), laid out like VS Code's chat view: the conversation, then the
    prompt box with the "current file" chip, the session's drop-downs (Mode, Model) and the send / stop button.
    Enter sends, Shift+Enter starts a new line, Escape stops a running turn (AgentChatView.axaml.cs).
    Before the agent runs, the middle shows why instead: not installed (with the download button), starting, failed.
-->
<UserControl
    x:Class="AXamlIDE.Views.AgentChatView"
    xmlns="https://github.com/avaloniaui"
    xmlns:acp="using:AXamlIDE.Services.Agents"
    xmlns:b="using:AXamlIDE.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:AXamlIDE.SampleData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:AXamlIDE.Shell"
    xmlns:styles="using:AXamlIDE.Styles"
    xmlns:views="using:AXamlIDE.Views"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:DataType="vm:AgentChatViewModel"
    Design.DataContext="{x:Static design:DesignData.AgentChat}"
    d:DesignWidth="440"
    d:DesignHeight="760"
    mc:Ignorable="d">

    <UserControl.Resources>
        <styles:IconKeyConverter x:Key="IconConverter" />

        <!--  A file or picture under a sent message: its thumbnail or a file icon, and its name  -->
        <DataTemplate x:Key="SentAttachmentTemplate" x:DataType="vm:PromptAttachment">
            <Border Classes="attachment" ToolTip.Tip="{Binding ToolTip}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image
                        Height="20"
                        IsVisible="{Binding IsImage}"
                        Source="{Binding Thumbnail}"
                        Stretch="Uniform" />
                    <PathIcon
                        Width="11"
                        Height="11"
                        Data="{StaticResource Icon.FileOutline}"
                        IsVisible="{Binding !IsImage}"
                        Opacity="0.7" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Text="{Binding Name}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Replies sit in a narrow panel: no page margins round the Markdown.  -->
        <Style Selector="views|MarkdownText StackPanel.md-body">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MaxWidth" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!--  Chat-sized Markdown, as VS Code's chat: 13px text, smaller headings, code in its own colour.  -->
        <Style Selector="views|MarkdownText StackPanel.md-body SelectableTextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style Selector="views|MarkdownText SelectableTextBlock.md-p">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="views|MarkdownText SelectableTextBlock.md-h1, views|MarkdownText SelectableTextBlock.md-h2, views|MarkdownText SelectableTextBlock.md-h3">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,8,0,6" />
        </Style>
        <Style Selector="views|MarkdownText SelectableTextBlock.md-h4, views|MarkdownText SelectableTextBlock.md-h5, views|MarkdownText SelectableTextBlock.md-h6">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
        <Style Selector="views|MarkdownText TextBlock.md-marker">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Margin" Value="2,0,4,0" />
        </Style>
        <Style Selector="views|MarkdownText Run.md-code">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ChatInlineCodeForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ChatInlineCodeBackgroundBrush}" />
        </Style>
        <Style Selector="views|MarkdownText Border.md-code-block">
            <Setter Property="Background" Value="{DynamicResource ChatCodeBlockBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatRequestBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="views|MarkdownText SelectableTextBlock.md-code-block">
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!--
            The timeline down the left of Claude's side of the conversation (VS Code's chat): a line, and a dot by
            each reply, thought, tool call and plan. Each row is wrapped in <ContentControl Classes="timeline">.
            The rows have no gap between them, so the line runs on unbroken; the gap is the row's bottom padding.
        -->
        <Style Selector="ContentControl.timeline">
            <Setter Property="Padding" Value="0,0,0,10" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="18,*">
                        <Border
                            Width="1"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource ChatTimelineBrush}" />
                        <Ellipse
                            Name="PART_Dot"
                            Width="7"
                            Height="7"
                            Margin="0,7,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Fill="{DynamicResource ChatTimelineDotBrush}" />
                        <ContentPresenter
                            Grid.Column="1"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ContentControl.timeline.error /template/ Ellipse#PART_Dot">
            <Setter Property="Fill" Value="{DynamicResource DiagnosticErrorBrush}" />
        </Style>

        <!--  The user's message, VS Code style: a box across the panel  -->
        <Style Selector="Border.request">
            <Setter Property="Background" Value="{DynamicResource ChatRequestBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatRequestBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>

        <!--  A file or picture going with a message (above the prompt box, and under a sent message)  -->
        <Style Selector="Border.attachment">
            <Setter Property="BorderBrush" Value="{DynamicResource ChatRequestBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <!--  The prompt box: lifts out of the panel, and its border lights up while you type  -->
        <Style Selector="Border.prompt">
            <Setter Property="Background" Value="{DynamicResource ChatInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="Border.prompt:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource ChatInputFocusBorderBrush}" />
        </Style>
        <Style Selector="Border.prompt TextBox, Border.prompt TextBox:pointerover, Border.prompt TextBox:focus">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.prompt TextBox /template/ Border#PART_BorderElement, Border.prompt TextBox:pointerover /template/ Border#PART_BorderElement, Border.prompt TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!--  Send and Stop: Claude's coral square, as in Claude Code's VS Code panel  -->
        <Style Selector="Button.send">
            <Setter Property="Background" Value="{DynamicResource ChatSendBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ChatSendForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.send /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChatSendBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ChatSendForegroundBrush}" />
        </Style>
        <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.send PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector="TextBlock.dim, SelectableTextBlock.dim">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.error, SelectableTextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource DiagnosticErrorBrush}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="{DynamicResource DockBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.diffLine.added">
            <Setter Property="Background" Value="{DynamicResource DiffInsertedLineBrush}" />
        </Style>
        <Style Selector="Border.diffLine.removed">
            <Setter Property="Background" Value="{DynamicResource DiffRemovedLineBrush}" />
        </Style>
        <Style Selector="Panel.statusIcon &gt; PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,Monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!--  The history menu's entries (AgentChatViewModel.History): a past chat, or a disabled note.  -->
        <Style x:DataType="vm:ChatHistoryItem" Selector="MenuFlyoutPresenter.chatHistory &gt; MenuItem">
            <Setter Property="Header" Value="{Binding Label}" />
            <Setter Property="Command" Value="{Binding OpenCommand}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!--  The user's message: a box across the panel, with the files and pictures that went with it  -->
        <DataTemplate x:DataType="vm:UserMessageItem">
            <Border Classes="request">
                <StackPanel Spacing="6">
                    <SelectableTextBlock
                        FontSize="13"
                        LineHeight="20"
                        Text="{Binding Text}"
                        TextWrapping="Wrap" />
                    <ItemsControl
                        IsVisible="{Binding HasAttachments}"
                        ItemTemplate="{StaticResource SentAttachmentTemplate}"
                        ItemsSource="{Binding Attachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  A reply (Markdown), or its thinking (folded and dimmed, as VS Code's "Thinking")  -->
        <DataTemplate x:DataType="vm:AgentTextItem">
            <ContentControl Classes="timeline">
                <Panel>
                    <views:MarkdownText IsVisible="{Binding !IsThought}" Markdown="{Binding Text}" />
                    <StackPanel IsVisible="{Binding IsThought}" Spacing="2">
                        <ToggleButton
                            Padding="0,2"
                            HorizontalAlignment="Left"
                            Classes="row expander"
                            IsChecked="{Binding IsExpanded}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Classes="dim"
                                    FontSize="13"
                                    Text="Thinking" />
                                <PathIcon
                                    Width="9"
                                    Height="9"
                                    Classes="chevron"
                                    Opacity="0.6" />
                            </StackPanel>
                        </ToggleButton>
                        <SelectableTextBlock
                            Classes="dim"
                            FontSize="12"
                            IsVisible="{Binding IsExpanded}"
                            Text="{Binding Text}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Panel>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:DataType="vm:NoticeItem">
            <ContentControl Classes="timeline" Classes.error="{Binding IsError}">
                <SelectableTextBlock
                    Classes="dim"
                    Classes.error="{Binding IsError}"
                    FontStyle="Italic"
                    Text="{Binding Text}"
                    TextWrapping="Wrap" />
            </ContentControl>
        </DataTemplate>

        <!--  A tool call: status, kind and title; click to see its output and edits, and the files it touched  -->
        <DataTemplate x:DataType="vm:ToolCallItem">
            <ContentControl Classes="timeline" Classes.error="{Binding IsFailed}">
                <Border Classes="card">
                    <StackPanel>
                        <Button
                            Padding="6,3"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Classes="row"
                            Command="{Binding ToggleExpandedCommand}">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <Panel
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,6,0"
                                    Classes="statusIcon">
                                    <PathIcon
                                        Classes.spinning="{Binding IsRunning}"
                                        Data="{StaticResource Icon.Loading}"
                                        IsVisible="{Binding IsRunning}"
                                        Opacity="0.7"
                                        ToolTip.Tip="Running" />
                                    <PathIcon
                                        Data="{StaticResource Icon.CheckCircle}"
                                        Foreground="{DynamicResource TestPassedBrush}"
                                        IsVisible="{Binding IsDone}"
                                        ToolTip.Tip="Done" />
                                    <PathIcon
                                        Data="{StaticResource Icon.CloseCircle}"
                                        Foreground="{DynamicResource TestFailedBrush}"
                                        IsVisible="{Binding IsFailed}"
                                        ToolTip.Tip="{Binding Status}" />
                                </Panel>
                                <PathIcon
                                    Grid.Column="1"
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,6,0"
                                    Data="{Binding IconKey, Converter={StaticResource IconConverter}}"
                                    Opacity="0.8" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>

                        <!--  The files it works on  -->
                        <ItemsControl
                            Margin="24,0,6,4"
                            IsVisible="{Binding ShowLocations}"
                            ItemsSource="{Binding Locations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="acp:AcpLocation">
                                    <Button
                                        Margin="0,0,10,0"
                                        Classes="link"
                                        Command="{Binding $parent[ItemsControl].((vm:ToolCallItem)DataContext).OpenLocationCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Path, Converter={x:Static views:AgentChatConverters.FileName}}"
                                        FontSize="11"
                                        ToolTip.Tip="{Binding Path}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel
                            Margin="6,0,6,6"
                            IsVisible="{Binding IsExpanded}"
                            Spacing="6">
                            <!--  Each edit, as a unified diff  -->
                            <ItemsControl ItemsSource="{Binding Diffs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AgentDiffItem">
                                        <StackPanel Margin="0,0,0,4">
                                            <StackPanel
                                                Margin="0,0,0,2"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Button
                                                    Classes="link"
                                                    Command="{Binding $parent[ItemsControl].((vm:ToolCallItem)DataContext).OpenDiffFileCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding FileName}"
                                                    FontSize="11"
                                                    ToolTip.Tip="{Binding Path}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Classes="dim"
                                                    FontSize="11"
                                                    IsVisible="{Binding IsNewFile}"
                                                    Text="new file" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AgentDiffLine">
                                                        <Border
                                                            Classes="diffLine"
                                                            Classes.added="{Binding IsAdded}"
                                                            Classes.removed="{Binding IsRemoved}">
                                                            <TextBlock Classes="mono" TextWrapping="Wrap">
                                                                <Run Text="{Binding Marker}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding Text}" />
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock
                                                Classes="dim"
                                                FontSize="11"
                                                IsVisible="{Binding HasMoreLines}"
                                                Text="{Binding MoreLines}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <views:MarkdownText IsVisible="{Binding HasOutput}" Markdown="{Binding Output}" />
                            <TextBlock
                                Classes="dim"
                                FontStyle="Italic"
                                IsVisible="{Binding !HasDetails}"
                                Text="No output yet." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ContentControl>
        </DataTemplate>

        <!--  Claude asks before running a tool: a button per choice, then what was chosen  -->
        <DataTemplate x:DataType="vm:PermissionItem">
            <ContentControl Classes="timeline">
                <Border
                    Padding="8,6"
                    BorderBrush="{DynamicResource DiagnosticWarningBrush}"
                    Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="Allow Claude to run this?" />
                        <TextBlock
                            Classes="mono"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="dim"
                            IsVisible="{Binding HasDetail}"
                            Text="{Binding Detail}"
                            TextWrapping="Wrap" />
                        <ItemsControl IsVisible="{Binding IsWaiting}" ItemsSource="{Binding Options}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="acp:AcpPermissionOption">
                                    <Button
                                        MinWidth="60"
                                        Margin="0,0,6,0"
                                        Command="{Binding $parent[ItemsControl].((vm:PermissionItem)DataContext).ChooseCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Classes="dim"
                            FontStyle="Italic"
                            IsVisible="{Binding !IsWaiting}"
                            Text="{Binding Outcome}" />
                    </StackPanel>
                </Border>
            </ContentControl>
        </DataTemplate>

        <!--  The plan: a tick for done, an arrow for the step in progress  -->
        <DataTemplate x:DataType="vm:PlanItem">
            <ContentControl Classes="timeline">
                <Border Padding="8,6" Classes="card">
                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="Plan" />
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AgentPlanRow">
                                    <Grid Margin="0,1" ColumnDefinitions="Auto,*">
                                        <Panel
                                            Width="12"
                                            Height="12"
                                            Margin="0,2,6,0"
                                            VerticalAlignment="Top"
                                            Classes="statusIcon">
                                            <PathIcon
                                                Data="{StaticResource Icon.CheckCircle}"
                                                Foreground="{DynamicResource TestPassedBrush}"
                                                IsVisible="{Binding IsCompleted}" />
                                            <PathIcon Data="{StaticResource Icon.ChevronRight}" IsVisible="{Binding IsInProgress}" />
                                            <PathIcon
                                                Data="{StaticResource Icon.CircleOutline}"
                                                IsVisible="{Binding IsPending}"
                                                Opacity="0.6" />
                                        </Panel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Classes.dim="{Binding IsCompleted}"
                                            FontWeight="{Binding IsInProgress, Converter={x:Static views:AgentChatConverters.BoldWhen}}"
                                            Text="{Binding Content}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ContentControl>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid Background="{DynamicResource ThemeBackgroundBrush}" RowDefinitions="Auto,*,Auto">

        <!--  The conversation's title, how full its context is, the chat history, and New Chat  -->
        <DockPanel Margin="8,2,2,2">
            <Button
                shell:KeyMap.ShortcutTip="New Chat"
                AutomationProperties.Name="New Chat"
                Classes="icon"
                Command="{Binding NewChatCommand}"
                DockPanel.Dock="Right">
                <PathIcon Data="{StaticResource Icon.Plus}" />
            </Button>
            <Button
                AutomationProperties.Name="Chat history"
                Classes="icon"
                Command="{Binding LoadHistoryCommand}"
                DockPanel.Dock="Right"
                IsEnabled="{Binding IsReady}"
                ToolTip.Tip="Chat History">
                <Button.Flyout>
                    <MenuFlyout
                        FlyoutPresenterClasses="chatHistory"
                        ItemsSource="{Binding History}"
                        Placement="BottomEdgeAlignedRight" />
                </Button.Flyout>
                <PathIcon Data="{StaticResource Icon.History}" />
            </Button>
            <TextBlock
                Margin="6,0"
                VerticalAlignment="Center"
                Classes="dim"
                DockPanel.Dock="Right"
                FontSize="11"
                Text="{Binding UsageText}" />
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis"
                ToolTip.Tip="{Binding Title}" />
        </DockPanel>

        <Panel Grid.Row="1">
            <!--  Not installed: say what it is, and download it only when asked  -->
            <StackPanel
                Margin="16"
                VerticalAlignment="Center"
                IsVisible="{Binding IsNotInstalled}"
                Spacing="10">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Claude isn't installed" />
                <TextBlock
                    Classes="dim"
                    Text="The Claude panel runs Claude Code through claude-agent-acp, the Agent Client Protocol adapter. It's one download with Claude Code inside, kept in AXamlIDE's own folder. It signs in with your Claude account, the same as the claude command."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{Binding InstallCommand}"
                    Content="{Binding InstallText}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="dim"
                    Text="{Binding InstallProgress}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                VerticalAlignment="Center"
                IsVisible="{Binding IsInstalling}"
                Spacing="10">
                <TextBlock HorizontalAlignment="Center" Text="{Binding InstallProgress}" />
                <ProgressBar
                    MinWidth="0"
                    Margin="24,0"
                    IsIndeterminate="True" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{Binding CancelInstallCommand}"
                    Content="Cancel" />
            </StackPanel>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Classes="dim"
                IsVisible="{Binding IsStarting}"
                Text="Starting Claude..." />

            <StackPanel
                Margin="16"
                VerticalAlignment="Center"
                IsVisible="{Binding IsFailed}"
                Spacing="10">
                <SelectableTextBlock
                    Classes="error"
                    Text="{Binding Problem}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{Binding RestartCommand}"
                    Content="Restart Claude" />
            </StackPanel>

            <!--  Sign in (VS Code's Claude sign-in): a button per way the agent offers; a click opens the browser  -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsSignIn}">
                <StackPanel
                    MaxWidth="360"
                    Margin="16"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Sign in to Claude" />
                    <TextBlock
                        Classes="dim"
                        Text="{Binding SignInReason}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <!--  The ways to sign in: the first (the Claude subscription) is the accent button  -->
                    <ItemsControl IsVisible="{Binding !IsWaitingForBrowser}" ItemsSource="{Binding SignInMethods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SignInOption">
                                <StackPanel Margin="0,4" Spacing="3">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Classes.accent="{Binding IsPrimary}"
                                        Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).SignInCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Method.Name}" />
                                    <TextBlock
                                        Classes="dim"
                                        IsVisible="{Binding Method.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Text="{Binding Method.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  An agent with no sign-in command: how to do it by hand  -->
                    <StackPanel IsVisible="{Binding HasNoSignInMethods}" Spacing="10">
                        <SelectableTextBlock
                            Text="{Binding ManualSignInText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Command="{Binding RestartCommand}"
                            Content="Restart Claude" />
                    </StackPanel>

                    <!--  Signing in, in the browser  -->
                    <StackPanel IsVisible="{Binding IsWaitingForBrowser}" Spacing="10">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="Finish signing in in your browser..."
                            TextWrapping="Wrap" />
                        <ProgressBar
                            MinWidth="0"
                            Margin="24,0"
                            IsIndeterminate="True" />
                        <StackPanel IsVisible="{Binding HasSignInLink}" Spacing="6">
                            <TextBlock
                                Margin="0,6,0,0"
                                Classes="dim"
                                Text="Browser didn't open? Open the sign-in page yourself, then paste the code it shows here."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button
                                    Click="OnOpenSignInLinkClick"
                                    Content="Open sign-in page"
                                    Tag="{Binding SignInLink}" />
                                <Button
                                    Click="OnCopySignInLinkClick"
                                    Content="Copy link"
                                    Tag="{Binding SignInLink}" />
                            </StackPanel>
                            <DockPanel>
                                <Button
                                    Margin="6,0,0,0"
                                    Command="{Binding SubmitSignInCodeCommand}"
                                    Content="Submit"
                                    DockPanel.Dock="Right" />
                                <TextBox PlaceholderText="Paste code here" Text="{Binding SignInCode}" />
                            </DockPanel>
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Center"
                            Command="{Binding CancelSignInCommand}"
                            Content="Cancel" />
                    </StackPanel>

                    <SelectableTextBlock
                        Classes="error"
                        IsVisible="{Binding HasSignInProblem}"
                        Text="{Binding SignInProblem}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!--  The conversation  -->
            <Grid IsVisible="{Binding IsReady}" RowDefinitions="*,Auto">
                <TextBlock
                    Grid.RowSpan="2"
                    Margin="16"
                    VerticalAlignment="Center"
                    Classes="dim"
                    IsVisible="{Binding IsEmpty}"
                    Text="Ask Claude about this workspace. It reads and edits files and runs commands in the workspace folder, and asks first when the mode says so. Open tabs pick up its edits."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,6,10,4">
                        <!--  No gap between rows: the timeline's line runs through them (ContentControl.timeline)  -->
                        <ItemsControl ItemsSource="{Binding Items}" />
                    </StackPanel>
                    <Interaction.Behaviors>
                        <b:FollowEndBehavior />
                    </Interaction.Behaviors>
                </ScrollViewer>
                <!--  Claude is working (VS Code's spinner and "Working..."): pinned under the conversation, so it stays in view as the reply grows  -->
                <Grid
                    Grid.Row="1"
                    Margin="10,0,10,6"
                    ColumnDefinitions="18,*"
                    IsVisible="{Binding IsTurnRunning}">
                    <PathIcon
                        Width="12"
                        Height="12"
                        Classes.spinning="{Binding IsTurnRunning}"
                        Data="{StaticResource Icon.Sync}"
                        Foreground="{DynamicResource ChatSendBackgroundBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Classes.pulsing="{Binding IsTurnRunning}"
                        FontSize="13"
                        Text="Working..." />
                </Grid>
            </Grid>
        </Panel>

        <!--
            The prompt box (VS Code's chat input): what goes with the message (the current file, added files, pasted
            pictures), the text, then + (add files), the session's drop-downs and send / stop. Ctrl+V pastes a
            picture or copied files as chips; files dropped anywhere on the panel are added too (AgentChatView.axaml.cs).
        -->
        <Border
            Grid.Row="2"
            Margin="8,0,8,8"
            Classes="prompt"
            IsVisible="{Binding IsReady}">
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0"
                    Classes="dim error"
                    IsVisible="{Binding !HasWorkspace}"
                    Text="Open a folder or solution first: Claude works in the workspace folder."
                    TextWrapping="Wrap" />
                <WrapPanel>
                    <ToggleButton
                        Margin="0,0,4,4"
                        Padding="4,1"
                        Classes="row"
                        IsChecked="{Binding IncludeActiveFile}"
                        IsVisible="{Binding ActiveFileName, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Click to send the current file with the message">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon
                                Width="11"
                                Height="11"
                                Data="{StaticResource Icon.FileOutline}" />
                            <TextBlock
                                Classes.dim="{Binding !IncludeActiveFile}"
                                FontSize="11"
                                Text="{Binding ActiveFileName}" />
                        </StackPanel>
                    </ToggleButton>
                    <!--  Added files and pasted pictures, each with an × to take it off  -->
                    <ItemsControl ItemsSource="{Binding Attachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PromptAttachment">
                                <Border Classes="attachment" ToolTip.Tip="{Binding ToolTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Image
                                            Height="28"
                                            IsVisible="{Binding IsImage}"
                                            Source="{Binding Thumbnail}"
                                            Stretch="Uniform" />
                                        <PathIcon
                                            Width="11"
                                            Height="11"
                                            Data="{StaticResource Icon.FileOutline}"
                                            IsVisible="{Binding !IsImage}" />
                                        <TextBlock
                                            MaxWidth="160"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Padding="2"
                                            AutomationProperties.Name="Remove"
                                            Classes="icon"
                                            Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).RemoveAttachmentCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Remove">
                                            <PathIcon
                                                Width="8"
                                                Height="8"
                                                Data="{StaticResource Icon.Close}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
                <TextBox
                    Name="PromptBox"
                    MinHeight="40"
                    MaxHeight="160"
                    Padding="2,2"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Message to Claude"
                    BorderThickness="0"
                    FontSize="13"
                    PlaceholderText="Ask Claude (Enter to send, Shift+Enter for a new line)"
                    Text="{Binding PromptText}"
                    TextWrapping="Wrap" />
                <DockPanel>
                    <Button
                        Margin="0,0,4,0"
                        AutomationProperties.Name="Add Files"
                        Classes="icon"
                        Command="{Binding AddFilesCommand}"
                        DockPanel.Dock="Left"
                        ToolTip.Tip="Add files or pictures (or paste / drop them)">
                        <PathIcon Data="{StaticResource Icon.Plus}" />
                    </Button>
                    <!--  Claude can use the IDE's tools (render a preview, the Problems list...); also in Settings > Environment  -->
                    <ToggleButton
                        Margin="0,0,4,0"
                        Padding="4,1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="IDE tools"
                        Classes="row"
                        DockPanel.Dock="Left"
                        IsChecked="{Binding UseIdeTools}"
                        IsVisible="{Binding HasIdeTools}"
                        ToolTip.Tip="{Binding IdeToolsToolTip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon
                                Width="11"
                                Height="11"
                                Classes.dim="{Binding !UseIdeTools}"
                                Data="{StaticResource Icon.Wrench}" />
                            <TextBlock
                                Classes.dim="{Binding !UseIdeTools}"
                                FontSize="11"
                                Text="IDE" />
                        </StackPanel>
                    </ToggleButton>
                    <Panel DockPanel.Dock="Right">
                        <Button
                            AutomationProperties.Name="Send"
                            Classes="send"
                            Command="{Binding SendCommand}"
                            IsVisible="{Binding !IsTurnRunning}"
                            ToolTip.ShowOnDisabled="True"
                            ToolTip.Tip="{Binding SendToolTip}">
                            <PathIcon Data="{StaticResource Icon.ArrowUp}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Stop"
                            Classes="send"
                            Command="{Binding StopCommand}"
                            IsVisible="{Binding IsTurnRunning}"
                            ToolTip.Tip="Stop (Escape)">
                            <PathIcon Data="{StaticResource Icon.Stop}" />
                        </Button>
                    </Panel>
                    <!--  The agent's settings for this conversation (Mode, Model); they appear with the first message  -->
                    <ItemsControl ItemsSource="{Binding Settings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AgentSettingItem">
                                <StackPanel Margin="0,0,4,0" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,3,0"
                                        VerticalAlignment="Center"
                                        Classes="dim"
                                        FontSize="11"
                                        IsVisible="{Binding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Text="{Binding Label}" />
                                    <ComboBox
                                        MinHeight="22"
                                        Padding="6,0"
                                        AutomationProperties.Name="{Binding Name}"
                                        FontSize="11"
                                        ItemsSource="{Binding Choices}"
                                        SelectedItem="{Binding Selected}"
                                        ToolTip.Tip="{Binding Name}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="acp:AcpChoice">
                                                <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
