<!--
    Search Everywhere (Rider's, double Shift): the top bar's box and the list that drops down under it.
    The keys (Up/Down, Enter, Tab, Escape) are handled in the code-behind, so the focus stays in the box.
-->
<UserControl
    x:Class="AXamlIDE.Views.SearchEverywhereView"
    x:DataType="vm:SearchEverywhereViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:models="using:AXamlIDE.Models"
    xmlns:stylefolder="using:AXamlIDE.Styles"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <stylefolder:IconKeyConverter x:Key="IconConverter" />
    </UserControl.Resources>
    <Panel>
        <TextBox
            Classes="SearchBox"
            FontSize="11"
            MinHeight="0"
            Name="Box"
            PlaceholderText="{Binding PlaceholderText}"
            Text="{Binding Query, Mode=TwoWay}" />

        <Popup
            IsLightDismissEnabled="True"
            IsOpen="{Binding IsOpen, Mode=TwoWay}"
            Name="DropDown"
            OverlayInputPassThroughElement="{Binding #Box}"
            Placement="BottomEdgeAlignedRight"
            PlacementTarget="{Binding #Box}">
            <Border
                Background="{DynamicResource HoverBackgroundBrush}"
                BorderBrush="{DynamicResource HoverBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4"
                TextElement.Foreground="{DynamicResource HoverForegroundBrush}"
                Width="640">
                <DockPanel>
                    <ListBox
                        Classes="tabs"
                        DockPanel.Dock="Top"
                        Focusable="False"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}" />
                    <TextBlock
                        DockPanel.Dock="Bottom"
                        FontSize="11"
                        Margin="8,4"
                        Opacity="0.6"
                        Text="Enter to open  ·  Tab for the next tab  ·  Esc to close" />
                    <Panel>
                        <TextBlock
                            IsVisible="{Binding HasNoResults}"
                            Margin="8,12"
                            Opacity="0.7"
                            Text="Nothing found. Tab moves to the next tab; Text searches inside files." />
                        <ListBox
                            Classes="compact"
                            Focusable="False"
                            ItemsSource="{Binding Results}"
                            MaxHeight="440"
                            Name="ResultList"
                            SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:SearchEverywhereItem">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            IsVisible="{Binding ShowsSection}"
                                            Margin="0,6,0,2"
                                            Opacity="0.6"
                                            Text="{Binding Section}" />
                                        <DockPanel Margin="0,1">
                                            <PathIcon
                                                Data="{Binding Icon, Converter={StaticResource IconConverter}}"
                                                DockPanel.Dock="Left"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                Width="14" />
                                            <TextBlock
                                                DockPanel.Dock="Right"
                                                Margin="12,0,0,0"
                                                Opacity="0.7"
                                                Text="{Binding Shortcut}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Title}" />
                                                <TextBlock
                                                    Opacity="0.6"
                                                    Text="{Binding Detail}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>
            </Border>
        </Popup>
    </Panel>
</UserControl>
