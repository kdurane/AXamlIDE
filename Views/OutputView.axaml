<!--
    Build output (DataContext: RunViewModel). Errors and warnings are coloured; a line that names a file and line
    opens it on double-click, as in Visual Studio's Output window.
-->
<UserControl
    x:Class="AXamlIDE.Views.OutputView"
    x:DataType="vm:RunViewModel"
    Design.DataContext="{x:Static design:DesignData.Run}"
    d:DesignWidth="900"
    d:DesignHeight="220"
    mc:Ignorable="d"
    xmlns="https://github.com/avaloniaui"
    xmlns:b="using:AXamlIDE.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:AXamlIDE.SampleData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:AXamlIDE.Views"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="SelectableTextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource DiagnosticErrorBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource DiagnosticWarningBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.link">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ItemsControl DoubleTapped="OnLineDoubleTapped" ItemsSource="{Binding BuildOutput}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock
                        Classes.error="{Binding Converter={x:Static views:OutputConverters.IsError}}"
                        Classes.link="{Binding Converter={x:Static views:OutputConverters.HasLocation}}"
                        Classes.warning="{Binding Converter={x:Static views:OutputConverters.IsWarning}}"
                        FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                        FontSize="11"
                        Text="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Interaction.Behaviors>
            <b:FollowEndBehavior />
        </Interaction.Behaviors>
    </ScrollViewer>
</UserControl>
