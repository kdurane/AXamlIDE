<UserControl
    x:Class="AXamlIDE.Views.TerminalView"
    x:DataType="vm:TerminalViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:term="using:Iciclecreek.Terminal"
    xmlns:vm="using:AXamlIDE.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    The Terminal panel (DataContext: TerminalViewModel): the shell in a real terminal (Iciclecreek.Avalonia.Terminal,
    styled in Styles/TerminalStyles.axaml). Copy and paste are Ctrl+Shift+C / Ctrl+Shift+V, as in VS Code on Linux;
    Ctrl+C goes to the program. Which IDE shortcuts still work while it has focus: Shell/KeyMap.
    -->
    <Grid RowDefinitions="Auto,*">

        <DockPanel Grid.Row="0" Margin="6,0,2,0">
            <StackPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    AutomationProperties.Name="Clear"
                    Classes="icon"
                    Command="{Binding ClearCommand}"
                    ToolTip.Tip="Clear the terminal">
                    <PathIcon Data="{StaticResource Icon.TrashCan}" />
                </Button>
                <Button
                    AutomationProperties.Name="Restart the shell"
                    Classes="icon"
                    Command="{Binding RestartCommand}"
                    ToolTip.Tip="Stop the shell and start a new one in the workspace folder">
                    <PathIcon Data="{StaticResource Icon.Restart}" />
                </Button>
            </StackPanel>
            <TextBlock
                Opacity="0.7"
                Text="{Binding Shell.Name}"
                VerticalAlignment="Center" />
        </DockPanel>

        <!--  The control has no Padding, so the gap before the text is a border in the terminal's own background.  -->
        <Border
            Background="{Binding #Terminal.Background}"
            Grid.Row="1"
            Padding="6,0,0,0">
            <term:TerminalControl
                AutomationProperties.Name="Terminal"
                FontFamily="{Binding FontFamily}"
                Name="Terminal">
                <term:TerminalControl.ContextMenu>
                    <!--  VS Code's terminal menu (the parts we have).  -->
                    <ContextMenu>
                        <MenuItem
                            Click="OnCopyClick"
                            Header="_Copy"
                            InputGesture="Ctrl+Shift+C" />
                        <MenuItem
                            Click="OnPasteClick"
                            Header="_Paste"
                            InputGesture="Ctrl+Shift+V" />
                        <MenuItem Click="OnSelectAllClick" Header="Select _All" />
                        <Separator />
                        <MenuItem Command="{Binding ClearCommand}" Header="C_lear" />
                        <MenuItem Command="{Binding RestartCommand}" Header="_Restart Shell" />
                    </ContextMenu>
                </term:TerminalControl.ContextMenu>
            </term:TerminalControl>
        </Border>
    </Grid>
</UserControl>
