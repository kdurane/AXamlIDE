<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="tests/**/*.cs" />
        <Compile Remove="Projects/**/*.cs" />
        <ProjectReference Include="Projects/AXamlIDE.msbuildhost/AXamlIDE.msbuildhost.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="Projects/AXamlIDE.Core/AXamlIDE.Core.csproj" />
        <Compile Update="Views\DocumentWellView.axaml.cs">
          <DependentUpon>DocumentWellView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\EditorPaneView.axaml.cs">
          <DependentUpon>EditorPaneView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\PreviewPaneView.axaml.cs">
          <DependentUpon>PreviewPaneView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\ProblemsView.axaml.cs">
          <DependentUpon>ProblemsView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\DebugToolbarWindow.axaml.cs">
          <DependentUpon>DebugToolbarWindow.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\OutputView.axaml.cs">
          <DependentUpon>OutputView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\SearchView.axaml.cs">
          <DependentUpon>SearchView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\SettingsWindow.axaml.cs">
          <DependentUpon>SettingsWindow.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\MainWindow.axaml.cs">
          <DependentUpon>MainWindow.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\ExplorerView.axaml.cs">
          <DependentUpon>ExplorerView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\ConsoleView.axaml.cs">
          <DependentUpon>ConsoleView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\DebugStatusView.axaml.cs">
          <DependentUpon>DebugStatusView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
    </ItemGroup>
    <Target Name="CopyMsBuildHost" AfterTargets="Build">
        <ItemGroup>
            <HostFiles Include="Projects/AXamlIDE.msbuildhost/bin/$(Configuration)/$(TargetFramework)/**/*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(HostFiles)" DestinationFiles="@(HostFiles->'$(OutDir)msbuildhost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
    <!-- The debugger (netcoredbg) is optional; when present in Projects/netcoredbg it is copied next to the app. -->
    <Target Name="CopyNetCoreDbg" AfterTargets="Build" Condition="Exists('Projects/netcoredbg')">
        <ItemGroup>
            <DebuggerFiles Include="Projects/netcoredbg/**/*.*;Projects/netcoredbg/netcoredbg" Exclude="Projects/netcoredbg/.netcoredbg_hist" />
        </ItemGroup>
        <Copy SourceFiles="@(DebuggerFiles)" DestinationFiles="@(DebuggerFiles->'$(OutDir)netcoredbg\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Dock.Avalonia" Version="12.1.0.12" />
        <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.12" />
        <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.12" />
        <PackageReference Include="Markdig" Version="1.4.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="TextMateSharp" Version="2.0.4" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.0" />
        <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="Assets/*.json" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Views\Dialogs\" />
      <Folder Include="Views\Documents\" />
      <Folder Include="Views\Problems\" />
      <Folder Include="Views\Search\" />
      <Folder Include="Views\Settings\" />
      <Folder Include="Views\Workspace\" />
    </ItemGroup>
</Project>
