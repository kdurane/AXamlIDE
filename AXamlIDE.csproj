<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="tests/**/*.cs" />
        <Compile Remove="Projects/**/*.cs" />
        <ProjectReference Include="Projects/AXamlIDE.msbuildhost/AXamlIDE.msbuildhost.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="Projects/AXamlIDE.Core/AXamlIDE.Core.csproj" />
        <Compile Update="Views\DocumentWellView.axaml.cs">
          <DependentUpon>DocumentWellView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\EditorPaneView.axaml.cs">
          <DependentUpon>EditorPaneView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\PreviewPaneView.axaml.cs">
          <DependentUpon>PreviewPaneView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\ProblemsView.axaml.cs">
          <DependentUpon>ProblemsView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\DebugToolbarWindow.axaml.cs">
          <DependentUpon>DebugToolbarWindow.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\OutputView.axaml.cs">
          <DependentUpon>OutputView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\SearchView.axaml.cs">
          <DependentUpon>SearchView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\SettingsWindow.axaml.cs">
          <DependentUpon>SettingsWindow.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\MainWindow.axaml.cs">
          <DependentUpon>MainWindow.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\ExplorerView.axaml.cs">
          <DependentUpon>ExplorerView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\ConsoleView.axaml.cs">
          <DependentUpon>ConsoleView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\DebugStatusView.axaml.cs">
          <DependentUpon>DebugStatusView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
    </ItemGroup>
    <Target Name="CopyMsBuildHost" AfterTargets="Build">
        <ItemGroup>
            <HostFiles Include="Projects/AXamlIDE.msbuildhost/bin/$(Configuration)/$(TargetFramework)/**/*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(HostFiles)" DestinationFiles="@(HostFiles->'$(OutDir)msbuildhost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
    <!--
        The debugger (Samsung's netcoredbg) is copied next to the app, from:
          - Projects/netcoredbg, when it has this OS's executable (a local copy; the Windows one is committed), else
          - the official release for this OS and CPU, downloaded once into obj/netcoredbg/<version>/.
        A failed download (e.g. offline) is only a warning: the app builds, debugging just isn't available.
        Set NetCoreDbgDownload=false to never download.
    -->
    <PropertyGroup>
        <NetCoreDbgVersion>3.2.0-1092</NetCoreDbgVersion>
        <NetCoreDbgExecutable Condition="$([MSBuild]::IsOSPlatform('Windows'))">netcoredbg.exe</NetCoreDbgExecutable>
        <NetCoreDbgExecutable Condition="'$(NetCoreDbgExecutable)' == ''">netcoredbg</NetCoreDbgExecutable>
        <NetCoreDbgArchive Condition="$([MSBuild]::IsOSPlatform('Windows'))">netcoredbg-win64.zip</NetCoreDbgArchive>
        <NetCoreDbgArchive Condition="$([MSBuild]::IsOSPlatform('OSX'))">netcoredbg-osx-arm64.zip</NetCoreDbgArchive>
        <NetCoreDbgArchive Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">netcoredbg-linux-arm64.tar.gz</NetCoreDbgArchive>
        <NetCoreDbgArchive Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(NetCoreDbgArchive)' == ''">netcoredbg-linux-amd64.tar.gz</NetCoreDbgArchive>
        <NetCoreDbgDownloadFolder>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)netcoredbg/$(NetCoreDbgVersion)/</NetCoreDbgDownloadFolder>
        <NetCoreDbgFolder Condition="Exists('$(MSBuildProjectDirectory)/Projects/netcoredbg/$(NetCoreDbgExecutable)')">$(MSBuildProjectDirectory)/Projects/netcoredbg/</NetCoreDbgFolder>
        <NetCoreDbgFolder Condition="'$(NetCoreDbgFolder)' == ''">$(NetCoreDbgDownloadFolder)netcoredbg/</NetCoreDbgFolder>
    </PropertyGroup>

    <Target Name="DownloadNetCoreDbg" Condition="!Exists('$(NetCoreDbgFolder)$(NetCoreDbgExecutable)') And '$(NetCoreDbgArchive)' != '' And '$(NetCoreDbgDownload)' != 'false'">
        <Message Importance="high" Text="Downloading the debugger: netcoredbg $(NetCoreDbgVersion) ($(NetCoreDbgArchive))" />
        <DownloadFile SourceUrl="https://github.com/Samsung/netcoredbg/releases/download/$(NetCoreDbgVersion)/$(NetCoreDbgArchive)" DestinationFolder="$(NetCoreDbgDownloadFolder)" ContinueOnError="WarnAndContinue" />
        <Unzip Condition="$(NetCoreDbgArchive.EndsWith('.zip')) And Exists('$(NetCoreDbgDownloadFolder)$(NetCoreDbgArchive)')" SourceFiles="$(NetCoreDbgDownloadFolder)$(NetCoreDbgArchive)" DestinationFolder="$(NetCoreDbgDownloadFolder)" ContinueOnError="WarnAndContinue" />
        <!-- tar keeps the executable bit (it ships with Linux, macOS and Windows 10+). -->
        <Exec Condition="$(NetCoreDbgArchive.EndsWith('.tar.gz')) And Exists('$(NetCoreDbgDownloadFolder)$(NetCoreDbgArchive)')" Command="tar -xzf &quot;$(NetCoreDbgArchive)&quot;" WorkingDirectory="$(NetCoreDbgDownloadFolder)" ContinueOnError="WarnAndContinue" />
    </Target>

    <!-- Conditions are on the steps, not the target: they must be checked after the download has run. -->
    <Target Name="CopyNetCoreDbg" AfterTargets="Build" DependsOnTargets="DownloadNetCoreDbg">
        <ItemGroup Condition="Exists('$(NetCoreDbgFolder)$(NetCoreDbgExecutable)')">
            <DebuggerFiles Include="$(NetCoreDbgFolder)**/*" Exclude="$(NetCoreDbgFolder).netcoredbg_hist" />
        </ItemGroup>
        <Copy Condition="'@(DebuggerFiles)' != ''" SourceFiles="@(DebuggerFiles)" DestinationFiles="@(DebuggerFiles->'$(OutDir)netcoredbg/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Dock.Avalonia" Version="12.1.0.12" />
        <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.12" />
        <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.12" />
        <PackageReference Include="Markdig" Version="1.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageReference Include="TextMateSharp" Version="2.0.4" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.0" />
        <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
        <PackageReference Include="ClosedXML" Version="0.105.1" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="Assets/*.json" />
      <AvaloniaResource Include="Assets/Grammars/*.json" />
    </ItemGroup>
</Project>
