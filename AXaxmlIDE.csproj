<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="tests/**/*.cs" />
        <Compile Remove="Projects/**/*.cs" />
        <ProjectReference Include="Projects/AXaxmlIDE.msbuildhost/AXaxmlIDE.msbuildhost.csproj" ReferenceOutputAssembly="false" />
<!--        <ProjectReference Include="Projects/CompletionEngine/AXaxmlIDE.CompletionEngine/AXaxmlIDE.CompletionEngine.csproj" />-->
<!--        <ProjectReference Include="Projects/CompletionEngine/AXaxmlIDE.CompletionEngine.DnlibMetadataProvider/AXaxmlIDE.CompletionEngine.DnlibMetadataProvider.csproj" />-->
    </ItemGroup>
    <Target Name="CopyMsBuildHost" AfterTargets="Build">
        <ItemGroup>
            <HostFiles Include="Projects/AXaxmlIDE.msbuildhost/bin/$(Configuration)/$(TargetFramework)/**/*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(HostFiles)" DestinationFiles="@(HostFiles->'$(OutDir)msbuildhost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="dnlib" Version="4.5.0" />
        <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
        <PackageReference Include="Markdig" Version="1.4.0" />
        <PackageReference Include="TextMateSharp" Version="2.0.4" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.0" />
        <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="Assets/*.json" />
    </ItemGroup>
</Project>
