<Project>
    <!-- Shared by every project in the repo (the app, Core, Tests, msbuildhost). -->
    <PropertyGroup>
        <!-- The build is warning-free: keep it that way. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- ...except NuGet's package/vulnerability notices, which can appear without any code change. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1603;NU1608;NU1701;NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    </PropertyGroup>
</Project>
